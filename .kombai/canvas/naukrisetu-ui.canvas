      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n  html { background: #ffffff; }\n  body { background: #ffffff; margin: 0; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif;\">\n    <!-- Content -->\n    <div class=\"flex-1 px-5 pb-6 pt-6\" data-kid=\"1-1\" data-name=\"job matches content area\">\n        <!-- Header -->\n        <h1 class=\"font-display text-[20px] font-bold leading-[1.3]\" data-kid=\"1-1-1\" data-name=\"matches headline text\">\n            Your matches\n        </h1>\n        <p class=\"mt-1 text-[13px] leading-[1.45] text-[#707070]\" data-kid=\"1-1-2\" data-name=\"matches subheading explanation\">\n            Hard requirements checked first — fix one to move a job into Eligible.\n        </p>\n        <!-- Tabs -->\n        <div class=\"mt-5 border-b border-[#dfdfdf]\" data-kid=\"1-1-3\" data-name=\"eligibility tabs container\">\n            <div class=\"flex gap-7\" data-kid=\"1-1-3-1\" data-name=\"tab buttons row\">\n                <button class=\"pb-2.5 text-[15px] font-medium text-[#707070]\" data-kid=\"1-1-3-1-1\" data-name=\"eligible jobs tab button\">\n                    Eligible (5)\n                </button>\n                <button class=\"relative pb-2.5 text-[15px] font-semibold text-[#171717]\" data-kid=\"1-1-3-1-2\" data-name=\"not eligible jobs tab button (active)\">\n                    Not eligible (3)\n                    <span class=\"absolute inset-x-0 -bottom-px h-[2px] bg-[#171717]\" data-kid=\"1-1-3-1-2-1\" data-name=\"active tab underline indicator\">\n                    </span>\n                </button>\n            </div>\n        </div>\n        <p class=\"mt-3 text-[12px] leading-[1.45] text-[#9a9a9a]\" data-kid=\"1-1-4\" data-name=\"not-eligible tab helper caption\">\n            These jobs list the exact conditions that failed.\n        </p>\n        <!-- Cards -->\n        <div class=\"mt-4 flex flex-col gap-3\" data-kid=\"1-1-5\" data-name=\"job cards list container\">\n            <!-- Card 1 -->\n            <article class=\"rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-1-5-1\" data-name=\"job match card (House Electrician)\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-5-1-1\" data-name=\"card header row\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-5-1-1-1\" data-name=\"job title and company block\">\n                        <h2 class=\"font-display text-[16px] font-semibold leading-[1.3]\" data-kid=\"1-1-5-1-1-1-1\" data-name=\"job title heading\">\n                            House Electrician\n                        </h2>\n                        <p class=\"mt-0.5 text-[12px] leading-[1.4] text-[#707070]\" data-kid=\"1-1-5-1-1-1-2\" data-name=\"company and location text\">\n                            Sharma Enterprises · Mumbai\n                        </p>\n                    </div>\n                    <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1\" data-kid=\"1-1-5-1-1-2\" data-name=\"not-eligible status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-1-5-1-1-2-1\" data-name=\"status badge red dot\">\n                        </span>\n                        <span class=\"text-[11px] font-semibold leading-none text-[#171717]\" data-kid=\"1-1-5-1-1-2-2\" data-name=\"status badge label text\">\n                            Not eligible\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-2.5 flex items-center gap-1.5 text-[13px] font-medium text-[#171717]\" data-kid=\"1-1-5-1-2\" data-name=\"monthly salary row\">\n                    <span class=\"text-[14px] leading-none text-[#707070]\" data-kid=\"1-1-5-1-2-1\" data-name=\"salary wallet icon wrapper\">\n                        <i class=\"icon-wallet\" data-kid=\"1-1-5-1-2-1-1\" data-name=\"wallet icon\">\n                        </i>\n                    </span>\n                    ₹28,000/mo\n                </p>\n                <div class=\"mt-3 flex items-start gap-2 rounded-lg bg-[#ffeceb] p-3\" data-kid=\"1-1-5-1-3\" data-name=\"eligibility failure alert box\">\n                    <span class=\"mt-px text-[15px] leading-none text-[#ff2201]\" data-kid=\"1-1-5-1-3-1\" data-name=\"alert circle-x icon wrapper\">\n                        <i class=\"icon-circle-x\" data-kid=\"1-1-5-1-3-1-1\" data-name=\"red circle-x icon\">\n                        </i>\n                    </span>\n                    <p class=\"text-[13px] font-medium leading-[1.45] text-[#7a1508]\" data-kid=\"1-1-5-1-3-2\" data-name=\"eligibility failure reason text\">\n                        Needs Mumbai address — you live in Pune\n                    </p>\n                </div>\n                <button class=\"mt-3 flex h-10 w-full items-center justify-center gap-1.5 rounded-md border border-[#c7c7c7] bg-white text-[13px] font-semibold text-[#171717]\" data-kid=\"1-1-5-1-4\" data-name=\"how-to-qualify action button\">\n                    How to qualify\n                    <span class=\"text-[14px] leading-none\" data-kid=\"1-1-5-1-4-1\" data-name=\"action button arrow icon wrapper\">\n                        <i class=\"icon-arrow-right\" data-kid=\"1-1-5-1-4-1-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </span>\n                </button>\n            </article>\n            <!-- Card 2 -->\n            <article class=\"rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-1-5-2\" data-name=\"job match card (AC Technician)\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-5-2-1\" data-name=\"card header row\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-5-2-1-1\" data-name=\"job title and company block\">\n                        <h2 class=\"font-display text-[16px] font-semibold leading-[1.3]\" data-kid=\"1-1-5-2-1-1-1\" data-name=\"job title heading\">\n                            AC Technician\n                        </h2>\n                        <p class=\"mt-0.5 text-[12px] leading-[1.4] text-[#707070]\" data-kid=\"1-1-5-2-1-1-2\" data-name=\"company and location text\">\n                            CoolTech Services · Pune\n                        </p>\n                    </div>\n                    <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1\" data-kid=\"1-1-5-2-1-2\" data-name=\"not-eligible status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-1-5-2-1-2-1\" data-name=\"status badge red dot\">\n                        </span>\n                        <span class=\"text-[11px] font-semibold leading-none text-[#171717]\" data-kid=\"1-1-5-2-1-2-2\" data-name=\"status badge label text\">\n                            Not eligible\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-2.5 flex items-center gap-1.5 text-[13px] font-medium text-[#171717]\" data-kid=\"1-1-5-2-2\" data-name=\"monthly salary row\">\n                    <span class=\"text-[14px] leading-none text-[#707070]\" data-kid=\"1-1-5-2-2-1\" data-name=\"salary wallet icon wrapper\">\n                        <i class=\"icon-wallet\" data-kid=\"1-1-5-2-2-1-1\" data-name=\"wallet icon\">\n                        </i>\n                    </span>\n                    ₹27,000/mo\n                </p>\n                <div class=\"mt-3 flex items-start gap-2 rounded-lg bg-[#ffeceb] p-3\" data-kid=\"1-1-5-2-3\" data-name=\"eligibility failure alert box\">\n                    <span class=\"mt-px text-[15px] leading-none text-[#ff2201]\" data-kid=\"1-1-5-2-3-1\" data-name=\"alert circle-x icon wrapper\">\n                        <i class=\"icon-circle-x\" data-kid=\"1-1-5-2-3-1-1\" data-name=\"red circle-x icon\">\n                        </i>\n                    </span>\n                    <p class=\"text-[13px] font-medium leading-[1.45] text-[#7a1508]\" data-kid=\"1-1-5-2-3-2\" data-name=\"eligibility failure reason text\">\n                        Needs certificate: AC Repair & Servicing\n                    </p>\n                </div>\n                <button class=\"mt-3 flex h-10 w-full items-center justify-center gap-1.5 rounded-md border border-[#c7c7c7] bg-white text-[13px] font-semibold text-[#171717]\" data-kid=\"1-1-5-2-4\" data-name=\"how-to-qualify action button\">\n                    How to qualify\n                    <span class=\"text-[14px] leading-none\" data-kid=\"1-1-5-2-4-1\" data-name=\"action button arrow icon wrapper\">\n                        <i class=\"icon-arrow-right\" data-kid=\"1-1-5-2-4-1-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </span>\n                </button>\n            </article>\n            <!-- Card 3 -->\n            <article class=\"rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-1-5-3\" data-name=\"job match card (Site Electrician)\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-5-3-1\" data-name=\"card header row\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-5-3-1-1\" data-name=\"job title and company block\">\n                        <h2 class=\"font-display text-[16px] font-semibold leading-[1.3]\" data-kid=\"1-1-5-3-1-1-1\" data-name=\"job title heading\">\n                            Site Electrician\n                        </h2>\n                        <p class=\"mt-0.5 text-[12px] leading-[1.4] text-[#707070]\" data-kid=\"1-1-5-3-1-1-2\" data-name=\"company and location text\">\n                            Sharma Builders · Pune\n                        </p>\n                    </div>\n                    <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1\" data-kid=\"1-1-5-3-1-2\" data-name=\"not-eligible status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-1-5-3-1-2-1\" data-name=\"status badge red dot\">\n                        </span>\n                        <span class=\"text-[11px] font-semibold leading-none text-[#171717]\" data-kid=\"1-1-5-3-1-2-2\" data-name=\"status badge label text\">\n                            Not eligible\n                        </span>\n                    </span>\n                </div>\n                <p class=\"mt-2.5 flex items-center gap-1.5 text-[13px] font-medium text-[#171717]\" data-kid=\"1-1-5-3-2\" data-name=\"monthly salary row\">\n                    <span class=\"text-[14px] leading-none text-[#707070]\" data-kid=\"1-1-5-3-2-1\" data-name=\"salary wallet icon wrapper\">\n                        <i class=\"icon-wallet\" data-kid=\"1-1-5-3-2-1-1\" data-name=\"wallet icon\">\n                        </i>\n                    </span>\n                    ₹24,000/mo\n                </p>\n                <div class=\"mt-3 flex items-start gap-2 rounded-lg bg-[#ffeceb] p-3\" data-kid=\"1-1-5-3-3\" data-name=\"eligibility failure alert box\">\n                    <span class=\"mt-px text-[15px] leading-none text-[#ff2201]\" data-kid=\"1-1-5-3-3-1\" data-name=\"alert circle-x icon wrapper\">\n                        <i class=\"icon-circle-x\" data-kid=\"1-1-5-3-3-1-1\" data-name=\"red circle-x icon\">\n                        </i>\n                    </span>\n                    <p class=\"text-[13px] font-medium leading-[1.45] text-[#7a1508]\" data-kid=\"1-1-5-3-3-2\" data-name=\"eligibility failure reason text\">\n                        Needs experience ≥ 3 years — you have 2\n                    </p>\n                </div>\n                <button class=\"mt-3 flex h-10 w-full items-center justify-center gap-1.5 rounded-md border border-[#c7c7c7] bg-white text-[13px] font-semibold text-[#171717]\" data-kid=\"1-1-5-3-4\" data-name=\"how-to-qualify action button\">\n                    How to qualify\n                    <span class=\"text-[14px] leading-none\" data-kid=\"1-1-5-3-4-1\" data-name=\"action button arrow icon wrapper\">\n                        <i class=\"icon-arrow-right\" data-kid=\"1-1-5-3-4-1-1\" data-name=\"right arrow icon\">\n                        </i>\n                    </span>\n                </button>\n            </article>\n        </div>\n    </div>\n    <!-- Bottom tab bar -->\n    <nav class=\"border-t border-[#dfdfdf] bg-white px-2 pb-5 pt-2\" data-kid=\"1-2\" data-name=\"bottom tab navigation bar\">\n        <div class=\"flex items-start justify-around\" data-kid=\"1-2-1\" data-name=\"tab items row\">\n            <div class=\"flex w-16 flex-col items-center gap-1 py-1\" data-kid=\"1-2-1-1\" data-name=\"home tab item\">\n                <span class=\"text-[22px] leading-none text-[#707070]\" data-kid=\"1-2-1-1-1\" data-name=\"home tab icon wrapper\">\n                    <i class=\"icon-house\" data-kid=\"1-2-1-1-1-1\" data-name=\"house icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-2-1-1-2\" data-name=\"home tab label\">\n                    Home\n                </span>\n            </div>\n            <div class=\"flex w-16 flex-col items-center gap-1 py-1\" data-kid=\"1-2-1-2\" data-name=\"matches tab item (active)\">\n                <span class=\"text-[22px] leading-none text-[#3ecf8e]\" data-kid=\"1-2-1-2-1\" data-name=\"matches tab icon wrapper\">\n                    <i class=\"icon-briefcase-business\" data-kid=\"1-2-1-2-1-1\" data-name=\"briefcase icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-1-2-2\" data-name=\"matches tab label\">\n                    Matches\n                </span>\n            </div>\n            <div class=\"flex w-16 flex-col items-center gap-1 py-1\" data-kid=\"1-2-1-3\" data-name=\"courses tab item\">\n                <span class=\"text-[22px] leading-none text-[#707070]\" data-kid=\"1-2-1-3-1\" data-name=\"courses tab icon wrapper\">\n                    <i class=\"icon-book-open\" data-kid=\"1-2-1-3-1-1\" data-name=\"open book icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-2-1-3-2\" data-name=\"courses tab label\">\n                    Courses\n                </span>\n            </div>\n            <div class=\"flex w-16 flex-col items-center gap-1 py-1\" data-kid=\"1-2-1-4\" data-name=\"profile tab item\">\n                <span class=\"text-[22px] leading-none text-[#707070]\" data-kid=\"1-2-1-4-1\" data-name=\"profile tab icon wrapper\">\n                    <i class=\"icon-user-round\" data-kid=\"1-2-1-4-1-1\" data-name=\"user icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-2-1-4-2\" data-name=\"profile tab label\">\n                    Profile\n                </span>\n            </div>\n        </div>\n    </nav>\n</div>\n",
