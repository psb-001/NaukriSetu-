      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  html { background: #ffffff; }\n  body { background: #ffffff; margin: 0; }\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif\">\n    <!-- Top navbar (seeker: Home / Matches / Courses / Profile) -->\n    <nav class=\"border-b border-[#dfdfdf] bg-white\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <div class=\"mx-auto flex h-16 w-full max-w-[1280px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"navbar inner row\">\n            <a class=\"font-display text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\">\n                Naukri\n                <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1-1\" data-name=\"brand name accent text\">\n                    Setu\n                </span>\n            </a>\n            <div class=\"flex items-stretch gap-7\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links\">\n                <a class=\"flex items-center gap-1.5 border-b-2 border-transparent px-1 text-[14px] font-medium text-[#707070]\" data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\">\n                    <span class=\"text-[16px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"home icon wrapper\">\n                        <i class=\"icon-house\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"house icon\">\n                        </i>\n                    </span>\n                    Home\n                </a>\n                <a class=\"flex items-center gap-1.5 border-b-2 border-[#171717] px-1 text-[14px] font-semibold text-[#171717]\" data-kid=\"1-1-1-2-2\" data-name=\"matches navigation link active\">\n                    <span class=\"text-[16px] text-[#3ecf8e]\" data-kid=\"1-1-1-2-2-1\" data-name=\"briefcase icon wrapper\">\n                        <i class=\"icon-briefcase-business\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"briefcase business icon\">\n                        </i>\n                    </span>\n                    Matches\n                </a>\n                <a class=\"flex items-center gap-1.5 border-b-2 border-transparent px-1 text-[14px] font-medium text-[#707070]\" data-kid=\"1-1-1-2-3\" data-name=\"courses navigation link\">\n                    <span class=\"text-[16px]\" data-kid=\"1-1-1-2-3-1\" data-name=\"book icon wrapper\">\n                        <i class=\"icon-book-open\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"open book icon\">\n                        </i>\n                    </span>\n                    Courses\n                </a>\n                <a class=\"flex items-center gap-1.5 border-b-2 border-transparent px-1 text-[14px] font-medium text-[#707070]\" data-kid=\"1-1-1-2-4\" data-name=\"profile navigation link\">\n                    <span class=\"text-[16px]\" data-kid=\"1-1-1-2-4-1\" data-name=\"user icon wrapper\">\n                        <i class=\"icon-user-round\" data-kid=\"1-1-1-2-4-1-1\" data-name=\"user round icon\">\n                        </i>\n                    </span>\n                    Profile\n                </a>\n            </div>\n        </div>\n    </nav>\n    <main class=\"mx-auto w-full max-w-[1200px] flex-1 px-8 pb-14 pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Header -->\n        <h1 class=\"font-display text-[24px] font-bold leading-tight\" data-kid=\"1-2-1\" data-name=\"page headline\">\n            Your matches\n        </h1>\n        <p class=\"mt-1.5 text-[14px] text-[#707070]\" data-kid=\"1-2-2\" data-name=\"page subtitle description\">\n            Hard requirements checked first — fix one to move a job into Eligible.\n        </p>\n        <!-- Tabs with live counts -->\n        <div class=\"mt-7 flex items-end gap-7 border-b border-[#dfdfdf]\" data-kid=\"1-2-3\" data-name=\"filter tabs bar\">\n            <button class=\"-mb-px border-b-2 border-transparent pb-3 text-[15px] font-medium text-[#707070]\" data-kid=\"1-2-3-1\" data-name=\"eligible filter tab\">\n                Eligible (5)\n            </button>\n            <button class=\"-mb-px border-b-2 border-[#171717] pb-3 text-[15px] font-semibold text-[#171717]\" data-kid=\"1-2-3-2\" data-name=\"not eligible filter tab active\">\n                Not eligible (3)\n            </button>\n        </div>\n        <p class=\"mt-3 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-4\" data-name=\"tabs helper caption\">\n            These jobs list the exact conditions that failed.\n        </p>\n        <!-- 3-col card grid -->\n        <div class=\"mt-6 grid grid-cols-3 gap-5\" data-kid=\"1-2-5\" data-name=\"job match cards grid\">\n            <!-- Card 1 -->\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-5-1\" data-name=\"job match card\">\n                <span class=\"inline-flex w-fit items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-5-1-1\" data-name=\"eligibility status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-2-5-1-1-1\" data-name=\"status dot indicator\">\n                    </span>\n                    Not eligible\n                </span>\n                <h2 class=\"font-display mt-3 text-[17px] font-semibold leading-snug\" data-kid=\"1-2-5-1-2\" data-name=\"job title heading\">\n                    House Electrician\n                </h2>\n                <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-3\" data-name=\"job employer and location text\">\n                    Sharma Enterprises · Mumbai\n                </p>\n                <p class=\"mt-2.5 flex items-center gap-1.5 text-[13px] font-semibold\" data-kid=\"1-2-5-1-4\" data-name=\"job salary row\">\n                    <span class=\"text-[14px] font-normal text-[#707070]\" data-kid=\"1-2-5-1-4-1\" data-name=\"wallet icon wrapper\">\n                        <i class=\"icon-wallet\" data-kid=\"1-2-5-1-4-1-1\" data-name=\"wallet icon\">\n                        </i>\n                    </span>\n                    ₹28,000/mo\n                </p>\n                <div class=\"mt-3.5 flex items-start gap-2 rounded-lg bg-[#ffeceb] p-3\" data-kid=\"1-2-5-1-5\" data-name=\"requirement failure alert box\">\n                    <span class=\"mt-0.5 text-[14px] text-[#7a1508]\" data-kid=\"1-2-5-1-5-1\" data-name=\"error icon wrapper\">\n                        <i class=\"icon-circle-x\" data-kid=\"1-2-5-1-5-1-1\" data-name=\"circle x icon\">\n                        </i>\n                    </span>\n                    <p class=\"text-[13px] font-medium leading-snug text-[#7a1508]\" data-kid=\"1-2-5-1-5-2\" data-name=\"requirement failure message\">\n                        Needs Mumbai address — you live in Pune\n                    </p>\n                </div>\n                <div class=\"mt-auto pt-4\" data-kid=\"1-2-5-1-6\" data-name=\"card footer action area\">\n                    <button class=\"flex h-9 w-full items-center justify-center gap-1.5 rounded-md border border-[#c7c7c7] bg-white text-[13px] font-semibold text-[#171717]\" data-kid=\"1-2-5-1-6-1\" data-name=\"how to qualify action button\">\n                        How to qualify\n                        <span class=\"text-[14px]\" data-kid=\"1-2-5-1-6-1-1\" data-name=\"arrow icon wrapper\">\n                            <i class=\"icon-arrow-right\" data-kid=\"1-2-5-1-6-1-1-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n            </article>\n            <!-- Card 2 -->\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-5-2\" data-name=\"job match card\">\n                <span class=\"inline-flex w-fit items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-5-2-1\" data-name=\"eligibility status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-2-5-2-1-1\" data-name=\"status dot indicator\">\n                    </span>\n                    Not eligible\n                </span>\n                <h2 class=\"font-display mt-3 text-[17px] font-semibold leading-snug\" data-kid=\"1-2-5-2-2\" data-name=\"job title heading\">\n                    AC Technician\n                </h2>\n                <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-5-2-3\" data-name=\"job employer and location text\">\n                    CoolTech Services · Pune\n                </p>\n                <p class=\"mt-2.5 flex items-center gap-1.5 text-[13px] font-semibold\" data-kid=\"1-2-5-2-4\" data-name=\"job salary row\">\n                    <span class=\"text-[14px] font-normal text-[#707070]\" data-kid=\"1-2-5-2-4-1\" data-name=\"wallet icon wrapper\">\n                        <i class=\"icon-wallet\" data-kid=\"1-2-5-2-4-1-1\" data-name=\"wallet icon\">\n                        </i>\n                    </span>\n                    ₹27,000/mo\n                </p>\n                <div class=\"mt-3.5 flex items-start gap-2 rounded-lg bg-[#ffeceb] p-3\" data-kid=\"1-2-5-2-5\" data-name=\"requirement failure alert box\">\n                    <span class=\"mt-0.5 text-[14px] text-[#7a1508]\" data-kid=\"1-2-5-2-5-1\" data-name=\"error icon wrapper\">\n                        <i class=\"icon-circle-x\" data-kid=\"1-2-5-2-5-1-1\" data-name=\"circle x icon\">\n                        </i>\n                    </span>\n                    <p class=\"text-[13px] font-medium leading-snug text-[#7a1508]\" data-kid=\"1-2-5-2-5-2\" data-name=\"requirement failure message\">\n                        Needs certificate: AC Repair & Servicing\n                    </p>\n                </div>\n                <div class=\"mt-auto pt-4\" data-kid=\"1-2-5-2-6\" data-name=\"card footer action area\">\n                    <button class=\"flex h-9 w-full items-center justify-center gap-1.5 rounded-md border border-[#c7c7c7] bg-white text-[13px] font-semibold text-[#171717]\" data-kid=\"1-2-5-2-6-1\" data-name=\"how to qualify action button\">\n                        How to qualify\n                        <span class=\"text-[14px]\" data-kid=\"1-2-5-2-6-1-1\" data-name=\"arrow icon wrapper\">\n                            <i class=\"icon-arrow-right\" data-kid=\"1-2-5-2-6-1-1-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n            </article>\n            <!-- Card 3 -->\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-5-3\" data-name=\"job match card\">\n                <span class=\"inline-flex w-fit items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-5-3-1\" data-name=\"eligibility status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-2-5-3-1-1\" data-name=\"status dot indicator\">\n                    </span>\n                    Not eligible\n                </span>\n                <h2 class=\"font-display mt-3 text-[17px] font-semibold leading-snug\" data-kid=\"1-2-5-3-2\" data-name=\"job title heading\">\n                    Site Electrician\n                </h2>\n                <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-5-3-3\" data-name=\"job employer and location text\">\n                    Sharma Builders · Pune\n                </p>\n                <p class=\"mt-2.5 flex items-center gap-1.5 text-[13px] font-semibold\" data-kid=\"1-2-5-3-4\" data-name=\"job salary row\">\n                    <span class=\"text-[14px] font-normal text-[#707070]\" data-kid=\"1-2-5-3-4-1\" data-name=\"wallet icon wrapper\">\n                        <i class=\"icon-wallet\" data-kid=\"1-2-5-3-4-1-1\" data-name=\"wallet icon\">\n                        </i>\n                    </span>\n                    ₹24,000/mo\n                </p>\n                <div class=\"mt-3.5 flex items-start gap-2 rounded-lg bg-[#ffeceb] p-3\" data-kid=\"1-2-5-3-5\" data-name=\"requirement failure alert box\">\n                    <span class=\"mt-0.5 text-[14px] text-[#7a1508]\" data-kid=\"1-2-5-3-5-1\" data-name=\"error icon wrapper\">\n                        <i class=\"icon-circle-x\" data-kid=\"1-2-5-3-5-1-1\" data-name=\"circle x icon\">\n                        </i>\n                    </span>\n                    <p class=\"text-[13px] font-medium leading-snug text-[#7a1508]\" data-kid=\"1-2-5-3-5-2\" data-name=\"requirement failure message\">\n                        Needs experience ≥ 3 years — you have 2\n                    </p>\n                </div>\n                <div class=\"mt-auto pt-4\" data-kid=\"1-2-5-3-6\" data-name=\"card footer action area\">\n                    <button class=\"flex h-9 w-full items-center justify-center gap-1.5 rounded-md border border-[#c7c7c7] bg-white text-[13px] font-semibold text-[#171717]\" data-kid=\"1-2-5-3-6-1\" data-name=\"how to qualify action button\">\n                        How to qualify\n                        <span class=\"text-[14px]\" data-kid=\"1-2-5-3-6-1-1\" data-name=\"arrow icon wrapper\">\n                            <i class=\"icon-arrow-right\" data-kid=\"1-2-5-3-6-1-1-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </span>\n                    </button>\n                </div>\n            </article>\n        </div>\n        <!-- Empty-tab helper -->\n        <p class=\"mt-10 text-center text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-6\" data-name=\"empty state helper text\">\n            Empty tab copy: “You qualify for everything — nice.” appears when nothing fails.\n        </p>\n    </main>\n</div>\n",
