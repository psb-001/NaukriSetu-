      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  html { background: #ffffff; }\n  body { background: #ffffff; margin: 0; }\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif;\">\n    <!-- Navbar (pushed context — no active tab) -->\n    <header class=\"w-full shrink-0 border-b border-[#dfdfdf] bg-white\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <div class=\"mx-auto flex h-16 w-full max-w-[1280px] items-center justify-between px-10\" data-kid=\"1-1-1\" data-name=\"navbar inner layout row\">\n            <span class=\"font-display text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"site brand logo text\">\n                Naukri\n                <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1-1\" data-name=\"brand accent suffix text\">\n                    Setu\n                </span>\n            </span>\n            <nav class=\"flex items-center gap-8 text-[14px] font-medium text-[#707070]\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <span data-kid=\"1-1-1-2-1\" data-name=\"home nav link\">\n                    Home\n                </span>\n                <span data-kid=\"1-1-1-2-2\" data-name=\"matches nav link\">\n                    Matches\n                </span>\n                <span data-kid=\"1-1-1-2-3\" data-name=\"courses nav link\">\n                    Courses\n                </span>\n                <span data-kid=\"1-1-1-2-4\" data-name=\"profile nav link\">\n                    Profile\n                </span>\n            </nav>\n        </div>\n    </header>\n    <!-- Content column -->\n    <main class=\"mx-auto w-full max-w-[880px] flex-1 px-6 pb-12 pt-10\" data-kid=\"1-2\" data-name=\"main content column\">\n        <!-- Header row -->\n        <div class=\"flex items-center gap-4\" data-kid=\"1-2-1\" data-name=\"page header row with back button\">\n            <span class=\"flex h-10 w-10 items-center justify-center rounded-full bg-[#fafafa] text-[20px] text-[#171717]\" data-kid=\"1-2-1-1\" data-name=\"back button circle\">\n                <i class=\"icon-arrow-left\" data-kid=\"1-2-1-1-1\" data-name=\"left arrow back icon\">\n                </i>\n            </span>\n            <h1 class=\"font-display text-[22px] font-bold leading-tight\" data-kid=\"1-2-1-2\" data-name=\"page title headline\">\n                How to qualify\n            </h1>\n        </div>\n        <!-- Target card -->\n        <section class=\"mt-6 flex items-start justify-between gap-6 rounded-xl border border-[#dfdfdf] bg-[#fafafa] p-6\" data-kid=\"1-2-2\" data-name=\"target job card\">\n            <div data-kid=\"1-2-2-1\" data-name=\"target job detail stack\">\n                <p class=\"text-[11px] font-medium text-[#9a9a9a]\" data-kid=\"1-2-2-1-1\" data-name=\"target label text\">\n                    Target\n                </p>\n                <h2 class=\"font-display mt-1 text-[24px] font-bold leading-tight\" data-kid=\"1-2-2-1-2\" data-name=\"target job title\">\n                    AC Technician\n                </h2>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-2-1-3\" data-name=\"target company location salary line\">\n                    CoolTech Services · Pune · ₹27,000/mo\n                </p>\n            </div>\n            <div class=\"flex shrink-0 items-center gap-2 rounded-full border border-[#dfdfdf] bg-white px-4 py-2 text-[14px] font-medium text-[#171717]\" data-kid=\"1-2-2-2\" data-name=\"qualification status pill\">\n                <span class=\"h-2 w-2 rounded-full bg-[#3ecf8e]\" data-kid=\"1-2-2-2-1\" data-name=\"status indicator dot\">\n                </span>\n                You meet 2 of 3 hard requirements\n            </div>\n        </section>\n        <!-- What's missing -->\n        <h3 class=\"font-display mt-10 text-[18px] font-semibold\" data-kid=\"1-2-3\" data-name=\"section heading what's missing\">\n            What's missing\n        </h3>\n        <!-- Row 1 — expanded with real catalogue course -->\n        <section class=\"border-b border-[#dfdfdf] pb-6 pt-5\" data-kid=\"1-2-4\" data-name=\"expandable requirement row with course\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-2-4-1\" data-name=\"requirement row header\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-4-1-1\" data-name=\"requirement title with type badge\">\n                    <h4 class=\"font-display text-[17px] font-semibold\" data-kid=\"1-2-4-1-1-1\" data-name=\"requirement title AC Repair & Servicing\">\n                        AC Repair & Servicing\n                    </h4>\n                    <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-4-1-1-2\" data-name=\"requirement type badge Certificate\">\n                        Certificate\n                    </span>\n                </div>\n                <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-4-1-2\" data-name=\"expand toggle container\">\n                    <i class=\"icon-chevron-down\" data-kid=\"1-2-4-1-2-1\" data-name=\"chevron down icon\">\n                    </i>\n                </span>\n            </div>\n            <div class=\"mt-4 flex items-center justify-between gap-4 rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-2-4-2\" data-name=\"course card row\">\n                <div class=\"flex items-center gap-4\" data-kid=\"1-2-4-2-1\" data-name=\"course info group\">\n                    <span class=\"shrink-0 rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-4-2-1-1\" data-name=\"course code badge HVAC-201\">\n                        HVAC-201\n                    </span>\n                    <div data-kid=\"1-2-4-2-1-2\" data-name=\"course detail stack\">\n                        <p class=\"font-display text-[15px] font-semibold leading-snug\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"course title\">\n                            AC Repair & Servicing\n                        </p>\n                        <p class=\"mt-0.5 flex items-center gap-1.5 text-[13px] text-[#707070]\" data-kid=\"1-2-4-2-1-2-2\" data-name=\"course instructor and duration line\">\n                            <span class=\"text-[14px]\" data-kid=\"1-2-4-2-1-2-2-1\" data-name=\"duration icon wrapper\">\n                                <i class=\"icon-clock\" data-kid=\"1-2-4-2-1-2-2-1-1\" data-name=\"clock icon\">\n                                </i>\n                            </span>\n                            Voltas Academy · 8 weeks\n                        </p>\n                    </div>\n                </div>\n                <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-2-4-2-2\" data-name=\"course action buttons group\">\n                    <span class=\"flex items-center gap-1.5 rounded-full px-3 py-2 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-4-2-2-1\" data-name=\"save button\">\n                        <span class=\"text-[16px] text-[#707070]\" data-kid=\"1-2-4-2-2-1-1\" data-name=\"save icon wrapper\">\n                            <i class=\"icon-heart\" data-kid=\"1-2-4-2-2-1-1-1\" data-name=\"heart icon\">\n                            </i>\n                        </span>\n                        Save\n                    </span>\n                    <span class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3.5 text-[12px] font-medium text-[#171717]\" data-kid=\"1-2-4-2-2-2\" data-name=\"notify me button\">\n                        <span class=\"text-[14px] text-[#707070]\" data-kid=\"1-2-4-2-2-2-1\" data-name=\"notify icon wrapper\">\n                            <i class=\"icon-bell\" data-kid=\"1-2-4-2-2-2-1-1\" data-name=\"bell icon\">\n                            </i>\n                        </span>\n                        Notify me\n                    </span>\n                </div>\n            </div>\n            <p class=\"mt-2 text-[11px] leading-snug text-[#9a9a9a]\" data-kid=\"1-2-4-3\" data-name=\"disclaimer note text\">\n                Saving tracks it — the demo never enrolls you.\n            </p>\n        </section>\n        <!-- Row 2 — expanded, honest zero-course state -->\n        <section class=\"border-b border-[#dfdfdf] pb-6 pt-5\" data-kid=\"1-2-5\" data-name=\"requirement row with no course available\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-2-5-1\" data-name=\"requirement row header\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-2-5-1-1\" data-name=\"requirement title with type badge\">\n                    <h4 class=\"font-display text-[17px] font-semibold\" data-kid=\"1-2-5-1-1-1\" data-name=\"requirement title AC gas charging\">\n                        AC gas charging\n                    </h4>\n                    <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-5-1-1-2\" data-name=\"requirement type badge Skill\">\n                        Skill\n                    </span>\n                </div>\n                <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-5-1-2\" data-name=\"expand toggle container\">\n                    <i class=\"icon-chevron-down\" data-kid=\"1-2-5-1-2-1\" data-name=\"chevron down icon\">\n                    </i>\n                </span>\n            </div>\n            <div class=\"mt-4 flex items-center gap-2.5 rounded-lg bg-[#fafafa] px-4 py-3.5 text-[14px] text-[#707070]\" data-kid=\"1-2-5-2\" data-name=\"no course available message row\">\n                <span class=\"text-[16px]\" data-kid=\"1-2-5-2-1\" data-name=\"info icon wrapper\">\n                    <i class=\"icon-info\" data-kid=\"1-2-5-2-1-1\" data-name=\"info icon\">\n                    </i>\n                </span>\n                No course available yet — check back soon.\n            </div>\n        </section>\n        <!-- Row 3 — collapsed criterion -->\n        <section class=\"pt-5\" data-kid=\"1-2-6\" data-name=\"collapsed experience criterion row\">\n            <div class=\"flex items-start justify-between gap-4\" data-kid=\"1-2-6-1\" data-name=\"criterion row content\">\n                <div data-kid=\"1-2-6-1-1\" data-name=\"criterion detail stack\">\n                    <div class=\"flex items-center gap-3\" data-kid=\"1-2-6-1-1-1\" data-name=\"criterion title with type badge\">\n                        <h4 class=\"font-display text-[17px] font-semibold\" data-kid=\"1-2-6-1-1-1-1\" data-name=\"criterion title experience 3 years\">\n                            Experience ≥ 3 years\n                        </h4>\n                        <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-6-1-1-1-2\" data-name=\"criterion type badge Criterion\">\n                            Criterion\n                        </span>\n                    </div>\n                    <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-6-1-1-2\" data-name=\"criterion description text\">\n                        Comes with time on the job — no course adds this.\n                    </p>\n                </div>\n                <span class=\"mt-1 text-[18px] text-[#b2b2b2]\" data-kid=\"1-2-6-1-2\" data-name=\"collapse toggle container\">\n                    <i class=\"icon-chevron-right\" data-kid=\"1-2-6-1-2-1\" data-name=\"chevron right icon\">\n                    </i>\n                </span>\n            </div>\n        </section>\n    </main>\n    <!-- Footer helper -->\n    <footer class=\"w-full shrink-0 border-t border-[#dfdfdf] bg-white px-6 py-5\" data-kid=\"1-3\" data-name=\"footer helper bar\">\n        <p class=\"mx-auto max-w-[880px] text-center text-[12px] leading-relaxed text-[#9a9a9a]\" data-kid=\"1-3-1\" data-name=\"footer disclaimer text\">\n            Courses come from the verified catalogue — nothing is invented. Student goal variant: gaps vs a typical AC job template.\n        </p>\n    </footer>\n</div>\n",
