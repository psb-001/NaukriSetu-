        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  body { background: #ffffff; }\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" style=\"font-family:'Inter',sans-serif;\">\n    <!-- NAVBAR -->\n    <header class=\"w-full border-b border-[#dfdfdf] bg-white\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-16 max-w-[1200px] items-center justify-between px-8\" data-kid=\"1-1-1\">\n            <div class=\"font-display text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\">\n                Naukri\n                <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1-1\">\n                    Setu\n                </span>\n            </div>\n            <nav class=\"flex items-stretch gap-8 text-[14px]\" data-kid=\"1-1-1-2\">\n                <a class=\"flex h-16 items-center border-b-2 border-[#171717] font-semibold\" data-kid=\"1-1-1-2-1\">\n                    Home\n                </a>\n                <a class=\"flex h-16 items-center text-[#707070]\" data-kid=\"1-1-1-2-2\">\n                    Matches\n                </a>\n                <a class=\"flex h-16 items-center text-[#707070]\" data-kid=\"1-1-1-2-3\">\n                    Courses\n                </a>\n                <a class=\"flex h-16 items-center text-[#707070]\" data-kid=\"1-1-1-2-4\">\n                    Profile\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[1200px] flex-1 px-8 pb-16\" data-kid=\"1-2\">\n        <!-- GREETING -->\n        <div class=\"pt-8\" data-kid=\"1-2-1\">\n            <h1 class=\"font-display text-[26px] font-bold leading-tight\" data-kid=\"1-2-1-1\">\n                Namaste, Ravi\n            </h1>\n            <p class=\"mt-1 text-[14px] text-[#707070]\" data-kid=\"1-2-1-2\">\n                2 new matches since yesterday\n            </p>\n        </div>\n        <!-- SEARCH -->\n        <div class=\"mt-6 flex h-12 w-full items-center gap-3 rounded-full border border-[#dfdfdf] bg-[#fafafa] px-5\" data-kid=\"1-2-2\">\n            <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-2-1\">\n                <i class=\"icon-search\" data-kid=\"1-2-2-1-1\">\n                </i>\n            </span>\n            <span class=\"text-[14px] text-[#9a9a9a]\" data-kid=\"1-2-2-2\">\n                Search jobs, skills, categories…\n            </span>\n        </div>\n        <!-- TRADE CHIPS -->\n        <div class=\"mt-3 flex flex-wrap items-center gap-2\" data-kid=\"1-2-3\">\n            <span class=\"flex h-8 items-center rounded-full bg-[#171717] px-4 text-[13px] font-medium text-white\" data-kid=\"1-2-3-1\">\n                All\n            </span>\n            <span class=\"flex h-8 items-center rounded-full border border-[#dfdfdf] px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-2\">\n                Electrician\n            </span>\n            <span class=\"flex h-8 items-center rounded-full border border-[#dfdfdf] px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-3\">\n                Plumber\n            </span>\n            <span class=\"flex h-8 items-center rounded-full border border-[#dfdfdf] px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-4\">\n                Carpenter\n            </span>\n            <span class=\"flex h-8 items-center rounded-full border border-[#dfdfdf] px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-5\">\n                Painter\n            </span>\n            <span class=\"flex h-8 items-center rounded-full border border-[#dfdfdf] px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-6\">\n                AC & Refrigeration\n            </span>\n            <span class=\"flex h-8 items-center rounded-full border border-[#dfdfdf] px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-7\">\n                Welder\n            </span>\n            <span class=\"flex h-8 items-center rounded-full border border-[#dfdfdf] px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-8\">\n                Mason\n            </span>\n        </div>\n        <!-- BANNER -->\n        <section class=\"mt-6 flex items-center justify-between gap-8 rounded-xl border border-[#dfdfdf] bg-[#fafafa] p-5\" data-kid=\"1-2-4\">\n            <div data-kid=\"1-2-4-1\">\n                <h2 class=\"font-display text-[17px] font-semibold\" data-kid=\"1-2-4-1-1\">\n                    New AC-repair intake\n                </h2>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-4-1-2\">\n                    Voltas service partners hiring in Pune this week\n                </p>\n                <a class=\"mt-2 inline-block text-[13px] font-medium underline\" data-kid=\"1-2-4-1-3\">\n                    See the role\n                </a>\n            </div>\n            <div class=\"shrink-0 rounded-xl border border-[#ebebeb] bg-white p-1.5\" data-kid=\"1-2-4-2\" data-name=\"banner illustration card frame\">\n                <img alt=\"AC unit with wrench — new intake\" class=\"h-[84px] w-auto\" data-kid=\"1-2-4-2-1\" data-name=\"banner AC unit illustration\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/banner-ac-intake.svg\"/>\n            </div>\n        </section>\n        <!-- MAIN GRID -->\n        <div class=\"mt-10 grid grid-cols-[1fr_360px] items-start gap-8\" data-kid=\"1-2-5\">\n            <!-- LEFT: MATCHES PREVIEW + COURSES -->\n            <div data-kid=\"1-2-5-1\">\n                <div class=\"flex items-end justify-between\" data-kid=\"1-2-5-1-1\">\n                    <div class=\"flex items-baseline gap-3\" data-kid=\"1-2-5-1-1-1\">\n                        <span class=\"font-display text-[44px] font-extrabold leading-none\" data-kid=\"1-2-5-1-1-1-1\">\n                            5\n                        </span>\n                        <span class=\"font-display text-[18px] font-semibold\" data-kid=\"1-2-5-1-1-1-2\">\n                            jobs you qualify for\n                        </span>\n                    </div>\n                    <a class=\"text-[13px] font-medium underline\" data-kid=\"1-2-5-1-1-2\">\n                        See all\n                    </a>\n                </div>\n                <div class=\"mt-2 border-b border-t border-[#dfdfdf]\" data-kid=\"1-2-5-1-2\">\n                    <!-- row 1 -->\n                    <div class=\"flex items-center gap-4 py-4\" data-kid=\"1-2-5-1-2-1\">\n                        <span class=\"font-display w-6 text-[22px] font-bold leading-none text-[#9a9a9a]\" data-kid=\"1-2-5-1-2-1-1\">\n                            1\n                        </span>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-2-5-1-2-1-2\">\n                            <p class=\"font-display truncate text-[16px] font-semibold\" data-kid=\"1-2-5-1-2-1-2-1\">\n                                AC Technician\n                            </p>\n                            <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-2-1-2-2\">\n                                Voltas Service Partner · Pune\n                            </p>\n                        </div>\n                        <span class=\"shrink-0 text-[13px] font-medium\" data-kid=\"1-2-5-1-2-1-3\">\n                            ₹26,000/mo · 3.2 km\n                        </span>\n                        <svg class=\"shrink-0\" data-kid=\"1-2-5-1-2-1-4\" height=\"32\" viewbox=\"0 0 36 36\" width=\"32\">\n                            <circle cx=\"18\" cy=\"18\" fill=\"none\" r=\"15.9155\" stroke=\"#ebebeb\" stroke-width=\"4\">\n                            </circle>\n                            <circle cx=\"18\" cy=\"18\" fill=\"none\" r=\"15.9155\" stroke=\"#3ecf8e\" stroke-dasharray=\"92 100\" stroke-dashoffset=\"25\" stroke-linecap=\"round\" stroke-width=\"4\">\n                            </circle>\n                            <text fill=\"#171717\" font-family=\"'Plus Jakarta Sans',sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"middle\" x=\"18\" y=\"21.5\">\n                                92\n                            </text>\n                        </svg>\n                        <span class=\"w-[18px] shrink-0 text-[18px] text-[#b2b2b2]\" data-kid=\"1-2-5-1-2-1-5\">\n                            <i class=\"icon-chevron-right\" data-kid=\"1-2-5-1-2-1-5-1\">\n                            </i>\n                        </span>\n                    </div>\n                    <!-- row 2 -->\n                    <div class=\"flex items-center gap-4 border-t border-[#dfdfdf] py-4\" data-kid=\"1-2-5-1-2-2\">\n                        <span class=\"font-display w-6 text-[22px] font-bold leading-none text-[#9a9a9a]\" data-kid=\"1-2-5-1-2-2-1\">\n                            2\n                        </span>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-2-5-1-2-2-2\">\n                            <p class=\"font-display truncate text-[16px] font-semibold\" data-kid=\"1-2-5-1-2-2-2-1\">\n                                Fan Repair Technician\n                            </p>\n                            <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-2-2-2-2\">\n                                RBI Colony Society · Pune\n                            </p>\n                        </div>\n                        <span class=\"shrink-0 text-[13px] font-medium\" data-kid=\"1-2-5-1-2-2-3\">\n                            ₹19,000/mo · 1.1 km\n                        </span>\n                        <svg class=\"shrink-0\" data-kid=\"1-2-5-1-2-2-4\" height=\"32\" viewbox=\"0 0 36 36\" width=\"32\">\n                            <circle cx=\"18\" cy=\"18\" fill=\"none\" r=\"15.9155\" stroke=\"#ebebeb\" stroke-width=\"4\">\n                            </circle>\n                            <circle cx=\"18\" cy=\"18\" fill=\"none\" r=\"15.9155\" stroke=\"#3ecf8e\" stroke-dasharray=\"88 100\" stroke-dashoffset=\"25\" stroke-linecap=\"round\" stroke-width=\"4\">\n                            </circle>\n                            <text fill=\"#171717\" font-family=\"'Plus Jakarta Sans',sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"middle\" x=\"18\" y=\"21.5\">\n                                88\n                            </text>\n                        </svg>\n                        <span class=\"w-[18px] shrink-0 text-[18px] text-[#b2b2b2]\" data-kid=\"1-2-5-1-2-2-5\">\n                            <i class=\"icon-chevron-right\" data-kid=\"1-2-5-1-2-2-5-1\">\n                            </i>\n                        </span>\n                    </div>\n                    <!-- row 3 -->\n                    <div class=\"flex items-center gap-4 border-t border-[#dfdfdf] py-4\" data-kid=\"1-2-5-1-2-3\">\n                        <span class=\"font-display w-6 text-[22px] font-bold leading-none text-[#9a9a9a]\" data-kid=\"1-2-5-1-2-3-1\">\n                            3\n                        </span>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-2-5-1-2-3-2\">\n                            <p class=\"font-display truncate text-[16px] font-semibold\" data-kid=\"1-2-5-1-2-3-2-1\">\n                                Plumbing Helper\n                            </p>\n                            <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-2-3-2-2\">\n                                Rao Constructions · Pune\n                            </p>\n                        </div>\n                        <span class=\"shrink-0 text-[13px] font-medium\" data-kid=\"1-2-5-1-2-3-3\">\n                            ₹15,500/mo · 5.8 km\n                        </span>\n                        <svg class=\"shrink-0\" data-kid=\"1-2-5-1-2-3-4\" height=\"32\" viewbox=\"0 0 36 36\" width=\"32\">\n                            <circle cx=\"18\" cy=\"18\" fill=\"none\" r=\"15.9155\" stroke=\"#ebebeb\" stroke-width=\"4\">\n                            </circle>\n                            <circle cx=\"18\" cy=\"18\" fill=\"none\" r=\"15.9155\" stroke=\"#3ecf8e\" stroke-dasharray=\"74 100\" stroke-dashoffset=\"25\" stroke-linecap=\"round\" stroke-width=\"4\">\n                            </circle>\n                            <text fill=\"#171717\" font-family=\"'Plus Jakarta Sans',sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"middle\" x=\"18\" y=\"21.5\">\n                                74\n                            </text>\n                        </svg>\n                        <span class=\"w-[18px] shrink-0 text-[18px] text-[#b2b2b2]\" data-kid=\"1-2-5-1-2-3-5\">\n                            <i class=\"icon-chevron-right\" data-kid=\"1-2-5-1-2-3-5-1\">\n                            </i>\n                        </span>\n                    </div>\n                </div>\n                <!-- COURSES STRIP -->\n                <div class=\"mt-10\" data-kid=\"1-2-5-1-3\">\n                    <div class=\"flex items-center justify-between\" data-kid=\"1-2-5-1-3-1\">\n                        <h2 class=\"font-display text-[16px] font-semibold\" data-kid=\"1-2-5-1-3-1-1\">\n                            Courses for your gaps\n                        </h2>\n                        <span class=\"text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-3-1-2\">\n                            12 courses\n                        </span>\n                    </div>\n                    <div class=\"mt-4 grid grid-cols-4 gap-4\" data-kid=\"1-2-5-1-3-2\">\n                        <article class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-2-5-1-3-2-1\">\n                            <div class=\"flex items-start justify-between\" data-kid=\"1-2-5-1-3-2-1-1\">\n                                <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-2-5-1-3-2-1-1-1\">\n                                    ELEC-101\n                                </span>\n                                <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-5-1-3-2-1-1-2\">\n                                    <i class=\"icon-heart\" data-kid=\"1-2-5-1-3-2-1-1-2-1\">\n                                    </i>\n                                </span>\n                            </div>\n                            <p class=\"font-display mt-3 text-[14px] font-semibold leading-snug\" data-kid=\"1-2-5-1-3-2-1-2\">\n                                House Wiring Fundamentals\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-3-2-1-3\">\n                                NSDC / Skill India · 4 weeks\n                            </p>\n                        </article>\n                        <article class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-2-5-1-3-2-2\">\n                            <div class=\"flex items-start justify-between\" data-kid=\"1-2-5-1-3-2-2-1\">\n                                <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-2-5-1-3-2-2-1-1\">\n                                    HVAC-201\n                                </span>\n                                <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-5-1-3-2-2-1-2\">\n                                    <i class=\"icon-heart\" data-kid=\"1-2-5-1-3-2-2-1-2-1\">\n                                    </i>\n                                </span>\n                            </div>\n                            <p class=\"font-display mt-3 text-[14px] font-semibold leading-snug\" data-kid=\"1-2-5-1-3-2-2-2\">\n                                AC Repair & Servicing\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-3-2-2-3\">\n                                Voltas Academy · 8 weeks\n                            </p>\n                        </article>\n                        <article class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-2-5-1-3-2-3\">\n                            <div class=\"flex items-start justify-between\" data-kid=\"1-2-5-1-3-2-3-1\">\n                                <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-2-5-1-3-2-3-1-1\">\n                                    ELEC-104\n                                </span>\n                                <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-5-1-3-2-3-1-2\">\n                                    <i class=\"icon-heart\" data-kid=\"1-2-5-1-3-2-3-1-2-1\">\n                                    </i>\n                                </span>\n                            </div>\n                            <p class=\"font-display mt-3 text-[14px] font-semibold leading-snug\" data-kid=\"1-2-5-1-3-2-3-2\">\n                                Fan Motor Repair\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-3-2-3-3\">\n                                NSDC / Skill India · 3 weeks\n                            </p>\n                        </article>\n                        <article class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-2-5-1-3-2-4\">\n                            <div class=\"flex items-start justify-between\" data-kid=\"1-2-5-1-3-2-4-1\">\n                                <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-2-5-1-3-2-4-1-1\">\n                                    PLMB-102\n                                </span>\n                                <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-5-1-3-2-4-1-2\">\n                                    <i class=\"icon-heart\" data-kid=\"1-2-5-1-3-2-4-1-2-1\">\n                                    </i>\n                                </span>\n                            </div>\n                            <p class=\"font-display mt-3 text-[14px] font-semibold leading-snug\" data-kid=\"1-2-5-1-3-2-4-2\">\n                                Basic Plumbing\n                            </p>\n                            <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-3-2-4-3\">\n                                ITI Pune · 6 weeks\n                            </p>\n                        </article>\n                    </div>\n                </div>\n            </div>\n            <!-- RIGHT RAIL -->\n            <div class=\"flex flex-col gap-6\" data-kid=\"1-2-5-2\">\n                <!-- GAP OF THE WEEK -->\n                <section class=\"rounded-xl border border-[#dfdfdf] p-5\" data-kid=\"1-2-5-2-1\">\n                    <h2 class=\"font-display text-[16px] font-semibold leading-snug\" data-kid=\"1-2-5-2-1-1\">\n                        You're 1 skill away from AC Technician\n                    </h2>\n                    <p class=\"mt-2 text-[13px] text-[#707070]\" data-kid=\"1-2-5-2-1-2\">\n                        Missing: AC Repair & Servicing certificate\n                    </p>\n                    <a class=\"mt-3 inline-block text-[13px] font-medium underline\" data-kid=\"1-2-5-2-1-3\">\n                        How to qualify\n                    </a>\n                </section>\n                <!-- KYC CARD -->\n                <section class=\"rounded-xl border border-[#dfdfdf] p-5\" data-kid=\"1-2-5-2-2\">\n                    <h2 class=\"font-display text-[16px] font-semibold\" data-kid=\"1-2-5-2-2-1\">\n                        Profile 40% complete\n                    </h2>\n                    <div class=\"mt-3 h-2 w-full rounded-full bg-[#ebebeb]\" data-kid=\"1-2-5-2-2-2\">\n                        <div class=\"h-2 w-[40%] rounded-full bg-[#3ecf8e]\" data-kid=\"1-2-5-2-2-2-1\">\n                        </div>\n                    </div>\n                    <p class=\"mt-2 text-[12px] text-[#707070]\" data-kid=\"1-2-5-2-2-3\">\n                        2 of 5 checks done\n                    </p>\n                    <div class=\"mt-3 flex items-start gap-2 rounded-lg bg-[#fff8d6] px-3 py-2.5\" data-kid=\"1-2-5-2-2-4\">\n                        <span class=\"mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[#ffdb13]\" data-kid=\"1-2-5-2-2-4-1\">\n                        </span>\n                        <p class=\"text-[12px] leading-snug text-[#171717]\" data-kid=\"1-2-5-2-2-4-2\">\n                            Aadhaar pending verification — you can browse, some jobs stay locked.\n                        </p>\n                    </div>\n                    <p class=\"mt-3 text-[13px] text-[#171717]\" data-kid=\"1-2-5-2-2-5\">\n                        Completing KYC unlocks 2 more jobs\n                    </p>\n                    <button class=\"font-display mt-4 h-10 w-full rounded-md bg-[#3ecf8e] text-[14px] font-semibold text-[#171717]\" data-kid=\"1-2-5-2-2-6\">\n                        Continue KYC\n                    </button>\n                </section>\n            </div>\n        </div>\n    </main>\n</div>\n",
