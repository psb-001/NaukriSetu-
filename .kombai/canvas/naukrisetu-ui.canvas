      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif;\">\n    <!-- Header -->\n    <header class=\"flex items-center gap-3 px-5 pb-2 pt-5\" data-kid=\"1-1\" data-name=\"header bar with back button and title\">\n        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#fafafa] text-[20px] text-[#171717]\" data-kid=\"1-1-1\" data-name=\"back navigation icon button circle\">\n            <i class=\"icon-arrow-left\" data-kid=\"1-1-1-1\" data-name=\"back arrow icon\">\n            </i>\n        </span>\n        <h1 class=\"font-display text-[18px] font-bold leading-tight\" data-kid=\"1-1-2\" data-name=\"page title heading\">\n            How to qualify\n        </h1>\n    </header>\n    <!-- Target card -->\n    <section class=\"mx-5 mt-3 rounded-xl border border-[#dfdfdf] bg-[#fafafa] p-4\" data-kid=\"1-2\" data-name=\"job target summary card\">\n        <p class=\"text-[11px] font-medium text-[#9a9a9a]\" data-kid=\"1-2-1\" data-name=\"target label text\">\n            Target\n        </p>\n        <h2 class=\"font-display mt-0.5 text-[18px] font-bold leading-snug\" data-kid=\"1-2-2\" data-name=\"job title heading\">\n            AC Technician\n        </h2>\n        <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-3\" data-name=\"job company and location details\">\n            CoolTech Services · Pune · ₹27,000/mo\n        </p>\n        <div class=\"mt-3 flex items-center gap-2\" data-kid=\"1-2-4\" data-name=\"requirements match indicator row\">\n            <span class=\"h-2 w-2 shrink-0 rounded-full bg-[#3ecf8e]\" data-kid=\"1-2-4-1\" data-name=\"green status dot\">\n            </span>\n            <p class=\"text-[13px] font-medium\" data-kid=\"1-2-4-2\" data-name=\"requirements match status text\">\n                You meet 2 of 3 hard requirements\n            </p>\n        </div>\n    </section>\n    <!-- Section heading -->\n    <h3 class=\"font-display px-5 pt-7 text-[16px] font-semibold\" data-kid=\"1-3\" data-name=\"missing requirements section heading\">\n        What's missing\n    </h3>\n    <!-- Row 1 · expanded · has course -->\n    <section class=\"px-5\" data-kid=\"1-4\" data-name=\"first missing requirement row section\">\n        <button class=\"flex w-full items-center gap-2 py-3.5 text-left\" data-kid=\"1-4-1\" data-name=\"requirement toggle button row\">\n            <span class=\"font-display text-[15px] font-semibold\" data-kid=\"1-4-1-1\" data-name=\"requirement name text\">\n                AC Repair & Servicing\n            </span>\n            <span class=\"rounded-full bg-[#fafafa] px-2 py-0.5 text-[11px] font-medium text-[#707070]\" data-kid=\"1-4-1-2\" data-name=\"requirement type badge\">\n                Certificate\n            </span>\n            <span class=\"ml-auto text-[16px] text-[#707070]\" data-kid=\"1-4-1-3\" data-name=\"expanded chevron indicator\">\n                <i class=\"icon-chevron-down\" data-kid=\"1-4-1-3-1\" data-name=\"chevron down icon\">\n                </i>\n            </span>\n        </button>\n        <article class=\"rounded-xl border border-[#dfdfdf] p-3.5\" data-kid=\"1-4-2\" data-name=\"recommended course card\">\n            <span class=\"inline-block rounded-full bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-4-2-1\" data-name=\"course code badge\">\n                HVAC-201\n            </span>\n            <h4 class=\"font-display mt-2 text-[14px] font-semibold leading-snug\" data-kid=\"1-4-2-2\" data-name=\"course name heading\">\n                AC Repair & Servicing\n            </h4>\n            <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-4-2-3\" data-name=\"course provider and duration text\">\n                Voltas Academy · 8 weeks\n            </p>\n            <div class=\"mt-3 flex items-center\" data-kid=\"1-4-2-4\" data-name=\"course action buttons row\">\n                <button class=\"flex items-center gap-1.5 text-[13px] font-medium text-[#171717]\" data-kid=\"1-4-2-4-1\" data-name=\"save course button\">\n                    <span class=\"text-[15px]\" data-kid=\"1-4-2-4-1-1\" data-name=\"heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-4-2-4-1-1-1\" data-name=\"heart icon\">\n                        </i>\n                    </span>\n                    Save\n                </button>\n                <button class=\"ml-auto flex h-8 items-center gap-1.5 rounded-md border border-[#c7c7c7] px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-4-2-4-2\" data-name=\"notify me button\">\n                    <span class=\"text-[14px]\" data-kid=\"1-4-2-4-2-1\" data-name=\"bell icon wrapper\">\n                        <i class=\"icon-bell\" data-kid=\"1-4-2-4-2-1-1\" data-name=\"bell icon\">\n                        </i>\n                    </span>\n                    Notify me\n                </button>\n            </div>\n        </article>\n        <p class=\"mt-2 text-[11px] text-[#9a9a9a]\" data-kid=\"1-4-3\" data-name=\"disclaimer footnote text\">\n            Saving tracks it — the demo never enrolls you.\n        </p>\n    </section>\n    <div class=\"mx-5 mt-4 h-px bg-[#dfdfdf]\" data-kid=\"1-5\" data-name=\"section divider line\">\n    </div>\n    <!-- Row 2 · expanded · zero courses -->\n    <section class=\"px-5\" data-kid=\"1-6\" data-name=\"second missing requirement row section\">\n        <button class=\"flex w-full items-center gap-2 py-3.5 text-left\" data-kid=\"1-6-1\" data-name=\"requirement toggle button row\">\n            <span class=\"font-display text-[15px] font-semibold\" data-kid=\"1-6-1-1\" data-name=\"requirement name text\">\n                AC gas charging\n            </span>\n            <span class=\"rounded-full bg-[#fafafa] px-2 py-0.5 text-[11px] font-medium text-[#707070]\" data-kid=\"1-6-1-2\" data-name=\"requirement type badge\">\n                Skill\n            </span>\n            <span class=\"ml-auto text-[16px] text-[#707070]\" data-kid=\"1-6-1-3\" data-name=\"expanded chevron indicator\">\n                <i class=\"icon-chevron-down\" data-kid=\"1-6-1-3-1\" data-name=\"chevron down icon\">\n                </i>\n            </span>\n        </button>\n        <div class=\"rounded-lg bg-[#fafafa] p-3.5\" data-kid=\"1-6-2\" data-name=\"no available course empty state\">\n            <p class=\"text-[13px] leading-snug text-[#707070]\" data-kid=\"1-6-2-1\" data-name=\"empty state message text\">\n                No course available yet — check back soon.\n            </p>\n        </div>\n    </section>\n    <div class=\"mx-5 mt-4 h-px bg-[#dfdfdf]\" data-kid=\"1-7\" data-name=\"section divider line\">\n    </div>\n    <!-- Row 3 · collapsed -->\n    <section class=\"px-5\" data-kid=\"1-8\" data-name=\"third requirement row collapsed section\">\n        <div class=\"py-3.5\" data-kid=\"1-8-1\" data-name=\"collapsed requirement content wrapper\">\n            <button class=\"flex w-full items-center gap-2 text-left\" data-kid=\"1-8-1-1\" data-name=\"requirement toggle button row\">\n                <span class=\"font-display text-[15px] font-semibold\" data-kid=\"1-8-1-1-1\" data-name=\"requirement name text\">\n                    Experience ≥ 3 years\n                </span>\n                <span class=\"rounded-full bg-[#fafafa] px-2 py-0.5 text-[11px] font-medium text-[#707070]\" data-kid=\"1-8-1-1-2\" data-name=\"requirement type badge\">\n                    Criterion\n                </span>\n                <span class=\"ml-auto text-[16px] text-[#707070]\" data-kid=\"1-8-1-1-3\" data-name=\"collapsed chevron indicator\">\n                    <i class=\"icon-chevron-right\" data-kid=\"1-8-1-1-3-1\" data-name=\"chevron right icon\">\n                    </i>\n                </span>\n            </button>\n            <p class=\"mt-1.5 text-[12px] leading-snug text-[#707070]\" data-kid=\"1-8-1-2\" data-name=\"requirement description text\">\n                Comes with time on the job — no course adds this.\n            </p>\n        </div>\n    </section>\n    <!-- Footer helper -->\n    <p class=\"mt-auto px-5 pb-6 pt-8 text-center text-[12px] leading-snug text-[#9a9a9a]\" data-kid=\"1-9\" data-name=\"footer help note text\">\n        Courses come from the verified catalogue — nothing is invented.\n    </p>\n</div>\n",
