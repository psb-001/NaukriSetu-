      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  html { background: #ffffff; }\n  body { background: #ffffff; margin: 0; }\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif;\">\n    <!-- Top navbar -->\n    <header class=\"w-full border-b border-[#dfdfdf] bg-white\" data-kid=\"1-1\" data-name=\"site header bar\">\n        <div class=\"mx-auto flex h-16 w-full max-w-[1200px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"header inner container\">\n            <div class=\"font-display text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"site brand logo text\">\n                Naukri\n                <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1-1\" data-name=\"brand name accent span\">\n                    Setu\n                </span>\n            </div>\n            <nav class=\"flex h-16 items-stretch gap-7 text-[14px]\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <a class=\"flex items-center border-b-2 border-[#171717] font-semibold text-[#171717]\" data-kid=\"1-1-1-2-1\" data-name=\"nav link: Post Job (active)\">\n                    Post Job\n                </a>\n                <a class=\"flex items-center border-b-2 border-transparent text-[#707070]\" data-kid=\"1-1-1-2-2\" data-name=\"nav link: My Postings\">\n                    My Postings\n                </a>\n                <a class=\"flex items-center border-b-2 border-transparent text-[#707070]\" data-kid=\"1-1-1-2-3\" data-name=\"nav link: Profile\">\n                    Profile\n                </a>\n            </nav>\n        </div>\n    </header>\n    <!-- Page -->\n    <main class=\"mx-auto w-full max-w-[1200px] flex-1 px-8 py-8\" data-kid=\"1-2\" data-name=\"main page content\">\n        <!-- Page header -->\n        <div class=\"mb-7\" data-kid=\"1-2-1\" data-name=\"page header block\">\n            <h1 class=\"font-display text-[24px] font-bold leading-tight\" data-kid=\"1-2-1-1\" data-name=\"page title heading\">\n                Employer\n            </h1>\n            <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-1-2\" data-name=\"employer identity subtitle\">\n                Sharma Enterprises · posting as verified employer\n            </p>\n        </div>\n        <div class=\"grid grid-cols-[58fr_42fr] items-start gap-8\" data-kid=\"1-2-2\" data-name=\"two-column content grid\">\n            <!-- LEFT: Post a job form -->\n            <section class=\"rounded-xl border border-[#dfdfdf] bg-white p-6\" data-kid=\"1-2-2-1\" data-name=\"post a job form section\">\n                <h2 class=\"font-display text-[18px] font-semibold\" data-kid=\"1-2-2-1-1\" data-name=\"form section title\">\n                    Post a job\n                </h2>\n                <div class=\"mt-5 flex flex-col gap-5\" data-kid=\"1-2-2-1-2\" data-name=\"form fields wrapper\">\n                    <div data-kid=\"1-2-2-1-2-1\" data-name=\"job title field group\">\n                        <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"job title label\">\n                            Job title\n                            <span class=\"font-normal text-[#707070]\" data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"required field asterisk\">\n                                *\n                            </span>\n                        </label>\n                        <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3 text-[14px] text-[#171717]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"job title text input\" readonly=\"\" value=\"AC Technician — Voltas Service Partner\"/>\n                    </div>\n                    <div data-kid=\"1-2-2-1-2-2\" data-name=\"description field group\">\n                        <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"description field label\">\n                            Description\n                        </label>\n                        <textarea class=\"w-full rounded-lg border border-[#c7c7c7] bg-white px-3 py-2.5 text-[14px] leading-relaxed text-[#171717]\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"job description textarea\" readonly=\"\" rows=\"3\">Split-AC install, servicing and gas top-ups for residential customers.</textarea>\n                    </div>\n                    <div data-kid=\"1-2-2-1-2-3\" data-name=\"required skills field group\">\n                        <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-2-3-1\" data-name=\"required skills label\">\n                            Required skills\n                            <span class=\"font-normal text-[#707070]\" data-kid=\"1-2-2-1-2-3-1-1\" data-name=\"required field asterisk\">\n                                *\n                            </span>\n                        </label>\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-2-2-1-2-3-2\" data-name=\"skills tags container\">\n                            <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[#dfdfdf] bg-[#fafafa] px-3 py-1.5 text-[13px]\" data-kid=\"1-2-2-1-2-3-2-1\" data-name=\"skill tag: AC repair & servicing\">\n                                AC repair & servicing\n                                <i class=\"icon-x text-[13px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-2-3-2-1-1\" data-name=\"tag remove icon\">\n                                </i>\n                            </span>\n                            <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[#dfdfdf] bg-[#fafafa] px-3 py-1.5 text-[13px]\" data-kid=\"1-2-2-1-2-3-2-2\" data-name=\"skill tag: House wiring\">\n                                House wiring\n                                <i class=\"icon-x text-[13px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-2-3-2-2-1\" data-name=\"tag remove icon\">\n                                </i>\n                            </span>\n                            <input class=\"h-9 w-[180px] rounded-lg border border-[#c7c7c7] bg-white px-3 text-[13px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-2-3-2-3\" data-name=\"new skill tag input\" readonly=\"\" value=\"e.g. Fan repair\"/>\n                        </div>\n                        <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-2-2-1-2-3-3\" data-name=\"skills helper text\">\n                            Suggestions come from the standard skills list.\n                        </p>\n                    </div>\n                    <div data-kid=\"1-2-2-1-2-4\" data-name=\"hard criteria field group\">\n                        <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-2-4-1\" data-name=\"hard criteria label\">\n                            Hard criteria\n                            <span class=\"font-normal text-[#707070]\" data-kid=\"1-2-2-1-2-4-1-1\" data-name=\"required field asterisk\">\n                                *\n                            </span>\n                        </label>\n                        <p class=\"mb-2.5 text-[12px] text-[#707070]\" data-kid=\"1-2-2-1-2-4-2\" data-name=\"hard criteria helper text\">\n                            At least one required — failing seekers are excluded, not ranked lower.\n                        </p>\n                        <div class=\"flex flex-col gap-2.5\" data-kid=\"1-2-2-1-2-4-3\" data-name=\"hard criteria rows container\">\n                            <div class=\"flex items-stretch overflow-hidden rounded-lg border border-[#c7c7c7] text-[13px]\" data-kid=\"1-2-2-1-2-4-3-1\" data-name=\"criteria row: Certificate requires AC Repair & Servicing\">\n                                <div class=\"flex items-center gap-2 px-3 py-2.5 text-[#171717]\" data-kid=\"1-2-2-1-2-4-3-1-1\" data-name=\"criteria type select: Certificate\">\n                                    Certificate\n                                    <i class=\"icon-chevron-down text-[14px] text-[#707070]\" data-kid=\"1-2-2-1-2-4-3-1-1-1\" data-name=\"criteria type dropdown chevron icon\">\n                                    </i>\n                                </div>\n                                <div class=\"flex items-center gap-2 border-l border-[#dfdfdf] px-3 py-2.5 text-[#707070]\" data-kid=\"1-2-2-1-2-4-3-1-2\" data-name=\"criteria operator select: requires\">\n                                    requires\n                                    <i class=\"icon-chevron-down text-[14px]\" data-kid=\"1-2-2-1-2-4-3-1-2-1\" data-name=\"criteria operator dropdown chevron icon\">\n                                    </i>\n                                </div>\n                                <div class=\"flex flex-1 items-center justify-between border-l border-[#dfdfdf] px-3 py-2.5\" data-kid=\"1-2-2-1-2-4-3-1-3\" data-name=\"criteria value: AC Repair & Servicing\">\n                                    <span class=\"text-[#171717]\" data-kid=\"1-2-2-1-2-4-3-1-3-1\" data-name=\"criteria value text\">\n                                        AC Repair & Servicing\n                                    </span>\n                                    <i class=\"icon-x text-[14px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-2-4-3-1-3-2\" data-name=\"criteria row remove icon\">\n                                    </i>\n                                </div>\n                            </div>\n                            <div class=\"flex items-stretch overflow-hidden rounded-lg border border-[#c7c7c7] text-[13px]\" data-kid=\"1-2-2-1-2-4-3-2\" data-name=\"criteria row: City equals Pune\">\n                                <div class=\"flex items-center gap-2 px-3 py-2.5 text-[#171717]\" data-kid=\"1-2-2-1-2-4-3-2-1\" data-name=\"criteria type select: City\">\n                                    City\n                                    <i class=\"icon-chevron-down text-[14px] text-[#707070]\" data-kid=\"1-2-2-1-2-4-3-2-1-1\" data-name=\"criteria type dropdown chevron icon\">\n                                    </i>\n                                </div>\n                                <div class=\"flex items-center gap-2 border-l border-[#dfdfdf] px-3 py-2.5 text-[#707070]\" data-kid=\"1-2-2-1-2-4-3-2-2\" data-name=\"criteria operator select: equals\">\n                                    equals\n                                    <i class=\"icon-chevron-down text-[14px]\" data-kid=\"1-2-2-1-2-4-3-2-2-1\" data-name=\"criteria operator dropdown chevron icon\">\n                                    </i>\n                                </div>\n                                <div class=\"flex flex-1 items-center justify-between border-l border-[#dfdfdf] px-3 py-2.5\" data-kid=\"1-2-2-1-2-4-3-2-3\" data-name=\"criteria value: Pune\">\n                                    <span class=\"text-[#171717]\" data-kid=\"1-2-2-1-2-4-3-2-3-1\" data-name=\"criteria value text\">\n                                        Pune\n                                    </span>\n                                    <i class=\"icon-x text-[14px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-2-4-3-2-3-2\" data-name=\"criteria row remove icon\">\n                                    </i>\n                                </div>\n                            </div>\n                            <button class=\"flex items-center justify-center gap-2 rounded-lg border border-dashed border-[#c7c7c7] py-2.5 text-[13px] text-[#171717]\" data-kid=\"1-2-2-1-2-4-3-3\" data-name=\"add criterion button\">\n                                <span class=\"text-[16px] leading-none\" data-kid=\"1-2-2-1-2-4-3-3-1\" data-name=\"add icon wrapper\">\n                                    <i class=\"icon-plus-circle\" data-kid=\"1-2-2-1-2-4-3-3-1-1\" data-name=\"add plus circle icon\">\n                                    </i>\n                                </span>\n                                Add criterion\n                            </button>\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-4\" data-kid=\"1-2-2-1-2-5\" data-name=\"city and pay field grid\">\n                        <div data-kid=\"1-2-2-1-2-5-1\" data-name=\"city field group\">\n                            <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-2-5-1-1\" data-name=\"city field label\">\n                                City\n                                <span class=\"font-normal text-[#707070]\" data-kid=\"1-2-2-1-2-5-1-1-1\" data-name=\"required field asterisk\">\n                                    *\n                                </span>\n                            </label>\n                            <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3 text-[14px] text-[#171717]\" data-kid=\"1-2-2-1-2-5-1-2\" data-name=\"city text input\" readonly=\"\" value=\"Pune\"/>\n                        </div>\n                        <div data-kid=\"1-2-2-1-2-5-2\" data-name=\"pay field group\">\n                            <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-2-5-2-1\" data-name=\"pay field label\">\n                                Pay (₹ / month)\n                            </label>\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-2-5-2-2\" data-name=\"pay range container\">\n                                <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3 text-[14px] text-[#171717]\" data-kid=\"1-2-2-1-2-5-2-2-1\" data-name=\"pay min input\" readonly=\"\" value=\"24,000\"/>\n                                <span class=\"text-[14px] text-[#707070]\" data-kid=\"1-2-2-1-2-5-2-2-2\" data-name=\"pay range dash separator\">\n                                    –\n                                </span>\n                                <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3 text-[14px] text-[#171717]\" data-kid=\"1-2-2-1-2-5-2-2-3\" data-name=\"pay max input\" readonly=\"\" value=\"28,000\"/>\n                            </div>\n                        </div>\n                    </div>\n                    <div data-kid=\"1-2-2-1-2-6\" data-name=\"work involved field group\">\n                        <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-2-6-1\" data-name=\"work involved label\">\n                            Work involved\n                        </label>\n                        <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3 text-[14px] text-[#171717]\" data-kid=\"1-2-2-1-2-6-2\" data-name=\"work involved text input\" readonly=\"\" value=\"Install, service, gas charging\"/>\n                    </div>\n                    <div class=\"border-t border-[#dfdfdf] pt-5\" data-kid=\"1-2-2-1-2-7\" data-name=\"form submit block\">\n                        <button class=\"h-11 w-full rounded-md bg-[#3ecf8e] font-display text-[15px] font-semibold text-[#171717]\" data-kid=\"1-2-2-1-2-7-1\" data-name=\"send for verification button\">\n                            Send for verification\n                        </button>\n                        <p class=\"mt-2 text-center text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-2-7-2\" data-name=\"submit helper note\">\n                            Invisible to seekers until a verifier approves it.\n                        </p>\n                    </div>\n                </div>\n            </section>\n            <!-- RIGHT: My postings -->\n            <section data-kid=\"1-2-2-2\" data-name=\"my postings section\">\n                <h2 class=\"font-display text-[18px] font-semibold\" data-kid=\"1-2-2-2-1\" data-name=\"my postings section title\">\n                    My postings\n                </h2>\n                <div class=\"mt-4 flex items-start gap-2.5 rounded-lg bg-[#e7f8ef] px-3.5 py-3\" data-kid=\"1-2-2-2-2\" data-name=\"verification status banner\">\n                    <span class=\"text-[18px] leading-none text-[#3ecf8e]\" data-kid=\"1-2-2-2-2-1\" data-name=\"status banner icon wrapper\">\n                        <i class=\"icon-circle-check\" data-kid=\"1-2-2-2-2-1-1\" data-name=\"circle check status icon\">\n                        </i>\n                    </span>\n                    <p class=\"text-[13px] leading-snug text-[#171717]\" data-kid=\"1-2-2-2-2-2\" data-name=\"verification status message\">\n                        AC Technician — sent for verification. Live after approval.\n                    </p>\n                </div>\n                <div class=\"mt-4 flex flex-col gap-3\" data-kid=\"1-2-2-2-3\" data-name=\"job postings list\">\n                    <article class=\"rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-2-2-2-3-1\" data-name=\"job posting card: AC Technician (Live)\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-2-3-1-1\" data-name=\"job card header row\">\n                            <h3 class=\"font-display text-[15px] font-semibold leading-snug\" data-kid=\"1-2-2-2-3-1-1-1\" data-name=\"job card title\">\n                                AC Technician — Voltas Service Partner\n                            </h3>\n                            <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#e7f8ef] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-2-2-3-1-1-2\" data-name=\"job status badge: Live\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#3ecf8e]\" data-kid=\"1-2-2-2-3-1-1-2-1\" data-name=\"status dot indicator\">\n                                </span>\n                                Live\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-2-2-3-1-2\" data-name=\"job criteria and pay meta\">\n                            3 criteria · ₹24–28k\n                        </p>\n                        <p class=\"mt-2 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-2-2-3-1-3\" data-name=\"job qualified seekers count\">\n                            12 seekers qualify\n                        </p>\n                        <div class=\"mt-3 flex items-center justify-end gap-4 border-t border-[#dfdfdf] pt-3 text-[12px] text-[#707070]\" data-kid=\"1-2-2-2-3-1-4\" data-name=\"job card actions row\">\n                            <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-1-4-1\" data-name=\"edit action link\">\n                                <span class=\"text-[14px] leading-none\" data-kid=\"1-2-2-2-3-1-4-1-1\" data-name=\"edit icon wrapper\">\n                                    <i class=\"icon-pencil\" data-kid=\"1-2-2-2-3-1-4-1-1-1\" data-name=\"pencil edit icon\">\n                                    </i>\n                                </span>\n                                Edit\n                            </span>\n                            <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-1-4-2\" data-name=\"delete action link\">\n                                <span class=\"text-[14px] leading-none\" data-kid=\"1-2-2-2-3-1-4-2-1\" data-name=\"delete icon wrapper\">\n                                    <i class=\"icon-trash-2\" data-kid=\"1-2-2-2-3-1-4-2-1-1\" data-name=\"trash delete icon\">\n                                    </i>\n                                </span>\n                                Delete\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-2-2-2-3-2\" data-name=\"job posting card: Fan Repair Technician (Pending)\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-2-3-2-1\" data-name=\"job card header row\">\n                            <h3 class=\"font-display text-[15px] font-semibold leading-snug\" data-kid=\"1-2-2-2-3-2-1-1\" data-name=\"job card title\">\n                                Fan Repair Technician — RBI Colony Society\n                            </h3>\n                            <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#fff8d6] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-2-2-3-2-1-2\" data-name=\"job status badge: Pending\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#ffdb13]\" data-kid=\"1-2-2-2-3-2-1-2-1\" data-name=\"status dot indicator\">\n                                </span>\n                                Pending\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-2-2-3-2-2\" data-name=\"job criteria and pay meta\">\n                            2 criteria · ₹18–21k\n                        </p>\n                        <p class=\"mt-2 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-2-2-3-2-3\" data-name=\"job pending visibility note\">\n                            Not visible to seekers yet\n                        </p>\n                        <div class=\"mt-3 flex items-center justify-end gap-4 border-t border-[#dfdfdf] pt-3 text-[12px] text-[#707070]\" data-kid=\"1-2-2-2-3-2-4\" data-name=\"job card actions row\">\n                            <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-2-4-1\" data-name=\"edit action link\">\n                                <span class=\"text-[14px] leading-none\" data-kid=\"1-2-2-2-3-2-4-1-1\" data-name=\"edit icon wrapper\">\n                                    <i class=\"icon-pencil\" data-kid=\"1-2-2-2-3-2-4-1-1-1\" data-name=\"pencil edit icon\">\n                                    </i>\n                                </span>\n                                Edit\n                            </span>\n                            <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-2-4-2\" data-name=\"delete action link\">\n                                <span class=\"text-[14px] leading-none\" data-kid=\"1-2-2-2-3-2-4-2-1\" data-name=\"delete icon wrapper\">\n                                    <i class=\"icon-trash-2\" data-kid=\"1-2-2-2-3-2-4-2-1-1\" data-name=\"trash delete icon\">\n                                    </i>\n                                </span>\n                                Delete\n                            </span>\n                        </div>\n                    </article>\n                    <article class=\"rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-2-2-2-3-3\" data-name=\"job posting card: Plumbing Helper (Rejected)\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-2-2-3-3-1\" data-name=\"job card header row\">\n                            <h3 class=\"font-display text-[15px] font-semibold leading-snug\" data-kid=\"1-2-2-2-3-3-1-1\" data-name=\"job card title\">\n                                Plumbing Helper — Rao Constructions\n                            </h3>\n                            <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-2-2-3-3-1-2\" data-name=\"job status badge: Rejected\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-2-2-2-3-3-1-2-1\" data-name=\"status dot indicator\">\n                                </span>\n                                Rejected\n                            </span>\n                        </div>\n                        <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-2-2-2-3-3-2\" data-name=\"job criteria and pay meta\">\n                            2 criteria · ₹13–16k\n                        </p>\n                        <div class=\"mt-2 rounded-lg bg-[#ffeceb] px-3 py-2\" data-kid=\"1-2-2-2-3-3-3\" data-name=\"verification rejection note box\">\n                            <p class=\"text-[12px] leading-snug text-[#171717]\" data-kid=\"1-2-2-2-3-3-3-1\" data-name=\"verifier rejection message\">\n                                Verifier note: add a fixed maximum pay so seekers see a realistic range.\n                            </p>\n                        </div>\n                        <div class=\"mt-3 flex items-center justify-end gap-4 border-t border-[#dfdfdf] pt-3 text-[12px] text-[#707070]\" data-kid=\"1-2-2-2-3-3-4\" data-name=\"job card actions row\">\n                            <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-3-4-1\" data-name=\"edit action link\">\n                                <span class=\"text-[14px] leading-none\" data-kid=\"1-2-2-2-3-3-4-1-1\" data-name=\"edit icon wrapper\">\n                                    <i class=\"icon-pencil\" data-kid=\"1-2-2-2-3-3-4-1-1-1\" data-name=\"pencil edit icon\">\n                                    </i>\n                                </span>\n                                Edit\n                            </span>\n                            <span class=\"inline-flex items-center gap-1.5\" data-kid=\"1-2-2-2-3-3-4-2\" data-name=\"delete action link\">\n                                <span class=\"text-[14px] leading-none\" data-kid=\"1-2-2-2-3-3-4-2-1\" data-name=\"delete icon wrapper\">\n                                    <i class=\"icon-trash-2\" data-kid=\"1-2-2-2-3-3-4-2-1-1\" data-name=\"trash delete icon\">\n                                    </i>\n                                </span>\n                                Delete\n                            </span>\n                        </div>\n                    </article>\n                </div>\n                <p class=\"mt-4 text-[11px] leading-snug text-[#9a9a9a]\" data-kid=\"1-2-2-2-4\" data-name=\"postings section footnote\">\n                    Editing re-sends the post for verification. Pending/rejected posts never appear in seeker matches — enforced in the engine.\n                </p>\n            </section>\n        </div>\n    </main>\n</div>\n",
      "comments": [],
