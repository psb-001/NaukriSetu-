      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n</style>\n<div class=\"flex min-h-screen flex-col bg-white\" data-kid=\"1\" data-name=\"app full-page layout container\" style=\"font-family:'Inter',sans-serif;\">\n    <div class=\"h-[110px] shrink-0\" data-kid=\"1-1\" data-name=\"top header placeholder spacer\">\n    </div>\n    <div class=\"flex flex-col items-center px-6\" data-kid=\"1-2\" data-name=\"centered hero content column\">\n        <img alt=\"Illustration: a bridge from a worker's toolkit to opportunity\" class=\"w-[290px]\" data-kid=\"1-2-1\" data-name=\"toolkit-to-opportunity bridge illustration\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/splash-bridge.svg\"/>\n        <h1 class=\"mt-8 text-[34px] font-extrabold leading-[1.15] tracking-[-0.5px] text-[#171717]\" data-kid=\"1-2-2\" data-name=\"hero headline text\" style=\"font-family:'Plus Jakarta Sans',sans-serif;\">\n            Naukri\n            <span class=\"text-[#3ecf8e]\" data-kid=\"1-2-2-1\" data-name=\"accent-colored brand name span\">\n                Setu\n            </span>\n        </h1>\n        <p class=\"mt-2 text-[15px] leading-[1.5] text-[#707070]\" data-kid=\"1-2-3\" data-name=\"hero tagline text\">\n            Skill se opportunity tak.\n        </p>\n    </div>\n    <div class=\"grow\" data-kid=\"1-3\" data-name=\"flex-grow content spacer\">\n    </div>\n    <div class=\"shrink-0 px-6 pb-10\" data-kid=\"1-4\" data-name=\"footer action area\">\n        <button class=\"h-12 w-full rounded-[6px] bg-[#3ecf8e] text-[16px] font-semibold text-[#171717]\" data-kid=\"1-4-1\" data-name=\"primary get-started button\" style=\"font-family:'Plus Jakarta Sans',sans-serif;\">\n            Get started\n        </button>\n        <p class=\"mt-3 text-center text-[12px] leading-[1.45] text-[#9a9a9a]\" data-kid=\"1-4-2\" data-name=\"session notice caption text\">\n            Have a session? You'll land on Home automatically.\n        </p>\n    </div>\n</div>\n",
