      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  html { background: #ffffff; }\n  body { background: #ffffff; margin: 0; }\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif;\">\n    <!-- Top navbar -->\n    <header class=\"w-full border-b border-[#dfdfdf] bg-white\" data-kid=\"1-1\" data-name=\"top navigation bar\">\n        <div class=\"mx-auto flex h-16 max-w-[1200px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"navbar inner container\">\n            <div class=\"font-display text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"brand logo text\">\n                Naukri\n                <span class=\"text-[#3ecf8e]\" data-dynamic=\"true\" data-kid=\"1-1-1-1-1\" data-name=\"brand accent word\" data-reason=\"word 'Setu' text replaced and class set by runtime replaceState script\">\n                    Setu\n                </span>\n            </div>\n            <nav class=\"flex items-center gap-8\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <a class=\"flex h-16 items-center gap-2 border-b-2 border-transparent text-[14px] font-medium text-[#707070]\" data-kid=\"1-1-1-2-1\" data-name=\"home nav link\">\n                    <span class=\"text-[16px]\" data-kid=\"1-1-1-2-1-1\" data-name=\"nav link icon wrapper\">\n                        <i class=\"icon-house\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"home house icon\">\n                        </i>\n                    </span>\n                    Home\n                </a>\n                <a class=\"flex h-16 items-center gap-2 border-b-2 border-transparent text-[14px] font-medium text-[#707070]\" data-kid=\"1-1-1-2-2\" data-name=\"matches nav link\">\n                    <span class=\"text-[16px]\" data-kid=\"1-1-1-2-2-1\" data-name=\"nav link icon wrapper\">\n                        <i class=\"icon-briefcase-business\" data-kid=\"1-1-1-2-2-1-1\" data-name=\"briefcase business icon\">\n                        </i>\n                    </span>\n                    Matches\n                </a>\n                <a class=\"flex h-16 items-center gap-2 border-b-2 border-[#171717] text-[14px] font-semibold text-[#171717]\" data-kid=\"1-1-1-2-3\" data-name=\"courses nav active link\">\n                    <span class=\"text-[16px] text-[#3ecf8e]\" data-kid=\"1-1-1-2-3-1\" data-name=\"nav link icon wrapper\">\n                        <i class=\"icon-book-open\" data-kid=\"1-1-1-2-3-1-1\" data-name=\"open book icon\">\n                        </i>\n                    </span>\n                    Courses\n                </a>\n                <a class=\"flex h-16 items-center gap-2 border-b-2 border-transparent text-[14px] font-medium text-[#707070]\" data-kid=\"1-1-1-2-4\" data-name=\"profile nav link\">\n                    <span class=\"text-[16px]\" data-kid=\"1-1-1-2-4-1\" data-name=\"nav link icon wrapper\">\n                        <i class=\"icon-user-round\" data-kid=\"1-1-1-2-4-1-1\" data-name=\"user profile icon\">\n                        </i>\n                    </span>\n                    Profile\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[1200px] flex-1 px-8 pb-16 pt-10\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Page header -->\n        <h1 class=\"font-display text-[24px] font-bold leading-tight\" data-kid=\"1-2-1\" data-name=\"page title heading\">\n            Courses\n        </h1>\n        <p class=\"mt-1 text-[14px] text-[#707070]\" data-kid=\"1-2-2\" data-name=\"page subtitle text\">\n            From the verified catalogue — never invented.\n        </p>\n        <!-- Toolbar -->\n        <div class=\"mt-7 flex flex-wrap items-center gap-3\" data-kid=\"1-2-3\" data-name=\"search toolbar row\">\n            <div class=\"flex h-11 w-[320px] items-center gap-2.5 rounded-full border border-[#dfdfdf] bg-[#fafafa] px-4\" data-kid=\"1-2-3-1\" data-name=\"course search input field\">\n                <span class=\"text-[16px] text-[#9a9a9a]\" data-kid=\"1-2-3-1-1\" data-name=\"search icon wrapper\">\n                    <i class=\"icon-search\" data-kid=\"1-2-3-1-1-1\" data-name=\"search magnifier icon\">\n                    </i>\n                </span>\n                <span class=\"text-[14px] text-[#9a9a9a]\" data-kid=\"1-2-3-1-2\" data-name=\"search placeholder text\">\n                    Search courses or skills — try “wiring”\n                </span>\n            </div>\n            <button class=\"flex h-10 items-center gap-1.5 rounded-full border border-[#c7c7c7] bg-white px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-2\" data-name=\"trade filter dropdown button\">\n                Trade: All\n                <span class=\"text-[14px] text-[#707070]\" data-kid=\"1-2-3-2-1\" data-name=\"dropdown chevron wrapper\">\n                    <i class=\"icon-chevron-down\" data-kid=\"1-2-3-2-1-1\" data-name=\"chevron down icon\">\n                    </i>\n                </span>\n            </button>\n            <button class=\"flex h-10 items-center rounded-full border border-[#c7c7c7] bg-white px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-3\" data-name=\"duration filter under 4 weeks\">\n                <4 wks\n            </button>\n            <button class=\"flex h-10 items-center rounded-full border border-[#c7c7c7] bg-white px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-4\" data-name=\"duration filter 4 to 8 weeks\">\n                4–8 wks\n            </button>\n            <button class=\"flex h-10 items-center rounded-full border border-[#c7c7c7] bg-white px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-3-5\" data-name=\"duration filter 8 plus weeks\">\n                8+ wks\n            </button>\n            <div class=\"ml-auto flex items-center gap-1.5 text-[13px] font-medium text-[#707070]\" data-kid=\"1-2-3-6\" data-name=\"sort control group\">\n                Sort: A–Z\n                <span class=\"text-[14px]\" data-kid=\"1-2-3-6-1\" data-name=\"sort chevron wrapper\">\n                    <i class=\"icon-arrow-up-down\" data-kid=\"1-2-3-6-1-1\" data-name=\"up down arrow icon\">\n                    </i>\n                </span>\n            </div>\n        </div>\n        <!-- Course grid -->\n        <div class=\"mt-6 grid grid-cols-3 gap-5\" data-kid=\"1-2-4\" data-name=\"course card grid\">\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-4-1\" data-name=\"course card House Wiring Fundamentals\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-2-4-1-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-4-1-1-1\" data-name=\"course code badge\">\n                        ELEC-101\n                    </span>\n                    <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-4-1-1-2\" data-name=\"save heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-2-4-1-1-2-1\" data-name=\"heart outline icon\">\n                        </i>\n                    </span>\n                </div>\n                <h3 class=\"font-display mt-3 text-[16px] font-semibold leading-snug\" data-kid=\"1-2-4-1-2\" data-name=\"course title heading\">\n                    House Wiring Fundamentals\n                </h3>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-4-1-3\" data-name=\"provider attribution text\">\n                    NSDC / Skill India\n                </p>\n                <div class=\"mt-3 flex items-center gap-1.5 text-[13px] text-[#707070]\" data-kid=\"1-2-4-1-4\" data-name=\"duration meta row\">\n                    <span class=\"text-[14px]\" data-kid=\"1-2-4-1-4-1\" data-name=\"clock icon wrapper\">\n                        <i class=\"icon-clock\" data-kid=\"1-2-4-1-4-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    4 weeks\n                </div>\n                <div class=\"mt-auto flex items-center justify-between border-t border-[#dfdfdf] pt-3.5\" data-kid=\"1-2-4-1-5\" data-name=\"card footer action row\" style=\"margin-top:16px;\">\n                    <button class=\"text-[13px] font-medium text-[#171717] underline decoration-[#dfdfdf] underline-offset-4\" data-kid=\"1-2-4-1-5-1\" data-name=\"save course link button\">\n                        Save\n                    </button>\n                    <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-2-4-1-5-2\" data-name=\"notify me pill button\">\n                        <span class=\"text-[13px]\" data-kid=\"1-2-4-1-5-2-1\" data-name=\"bell icon wrapper\">\n                            <i class=\"icon-bell\" data-kid=\"1-2-4-1-5-2-1-1\" data-name=\"bell icon\">\n                            </i>\n                        </span>\n                        Notify me\n                    </button>\n                </div>\n            </article>\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-4-2\" data-name=\"course card AC Repair and Servicing\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-2-4-2-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-4-2-1-1\" data-name=\"course code badge\">\n                        HVAC-201\n                    </span>\n                    <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-4-2-1-2\" data-name=\"save heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-2-4-2-1-2-1\" data-name=\"heart outline icon\">\n                        </i>\n                    </span>\n                </div>\n                <h3 class=\"font-display mt-3 text-[16px] font-semibold leading-snug\" data-kid=\"1-2-4-2-2\" data-name=\"course title heading\">\n                    AC Repair & Servicing\n                </h3>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-4-2-3\" data-name=\"provider attribution text\">\n                    Voltas Academy\n                </p>\n                <div class=\"mt-3 flex items-center gap-1.5 text-[13px] text-[#707070]\" data-kid=\"1-2-4-2-4\" data-name=\"duration meta row\">\n                    <span class=\"text-[14px]\" data-kid=\"1-2-4-2-4-1\" data-name=\"clock icon wrapper\">\n                        <i class=\"icon-clock\" data-kid=\"1-2-4-2-4-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    8 weeks\n                </div>\n                <div class=\"mt-auto flex items-center justify-between border-t border-[#dfdfdf] pt-3.5\" data-kid=\"1-2-4-2-5\" data-name=\"card footer action row\" style=\"margin-top:16px;\">\n                    <button class=\"text-[13px] font-medium text-[#171717] underline decoration-[#dfdfdf] underline-offset-4\" data-kid=\"1-2-4-2-5-1\" data-name=\"save course link button\">\n                        Save\n                    </button>\n                    <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-2-4-2-5-2\" data-name=\"notify me pill button\">\n                        <span class=\"text-[13px]\" data-kid=\"1-2-4-2-5-2-1\" data-name=\"bell icon wrapper\">\n                            <i class=\"icon-bell\" data-kid=\"1-2-4-2-5-2-1-1\" data-name=\"bell icon\">\n                            </i>\n                        </span>\n                        Notify me\n                    </button>\n                </div>\n            </article>\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-4-3\" data-name=\"course card Fan Motor Repair\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-2-4-3-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-4-3-1-1\" data-name=\"course code badge\">\n                        ELEC-104\n                    </span>\n                    <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-4-3-1-2\" data-name=\"save heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-2-4-3-1-2-1\" data-name=\"heart outline icon\">\n                        </i>\n                    </span>\n                </div>\n                <h3 class=\"font-display mt-3 text-[16px] font-semibold leading-snug\" data-kid=\"1-2-4-3-2\" data-name=\"course title heading\">\n                    Fan Motor Repair\n                </h3>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-4-3-3\" data-name=\"provider attribution text\">\n                    NSDC / Skill India\n                </p>\n                <div class=\"mt-3 flex items-center gap-1.5 text-[13px] text-[#707070]\" data-kid=\"1-2-4-3-4\" data-name=\"duration meta row\">\n                    <span class=\"text-[14px]\" data-kid=\"1-2-4-3-4-1\" data-name=\"clock icon wrapper\">\n                        <i class=\"icon-clock\" data-kid=\"1-2-4-3-4-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    3 weeks\n                </div>\n                <div class=\"mt-auto flex items-center justify-between border-t border-[#dfdfdf] pt-3.5\" data-kid=\"1-2-4-3-5\" data-name=\"card footer action row\" style=\"margin-top:16px;\">\n                    <button class=\"text-[13px] font-medium text-[#171717] underline decoration-[#dfdfdf] underline-offset-4\" data-kid=\"1-2-4-3-5-1\" data-name=\"save course link button\">\n                        Save\n                    </button>\n                    <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-2-4-3-5-2\" data-name=\"notify me pill button\">\n                        <span class=\"text-[13px]\" data-kid=\"1-2-4-3-5-2-1\" data-name=\"bell icon wrapper\">\n                            <i class=\"icon-bell\" data-kid=\"1-2-4-3-5-2-1-1\" data-name=\"bell icon\">\n                            </i>\n                        </span>\n                        Notify me\n                    </button>\n                </div>\n            </article>\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-4-4\" data-name=\"course card Basic Plumbing\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-2-4-4-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-4-4-1-1\" data-name=\"course code badge\">\n                        PLMB-102\n                    </span>\n                    <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-4-4-1-2\" data-name=\"save heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-2-4-4-1-2-1\" data-name=\"heart outline icon\">\n                        </i>\n                    </span>\n                </div>\n                <h3 class=\"font-display mt-3 text-[16px] font-semibold leading-snug\" data-kid=\"1-2-4-4-2\" data-name=\"course title heading\">\n                    Basic Plumbing\n                </h3>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-4-4-3\" data-name=\"provider attribution text\">\n                    ITI Pune\n                </p>\n                <div class=\"mt-3 flex items-center gap-1.5 text-[13px] text-[#707070]\" data-kid=\"1-2-4-4-4\" data-name=\"duration meta row\">\n                    <span class=\"text-[14px]\" data-kid=\"1-2-4-4-4-1\" data-name=\"clock icon wrapper\">\n                        <i class=\"icon-clock\" data-kid=\"1-2-4-4-4-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    6 weeks\n                </div>\n                <div class=\"mt-auto flex items-center justify-between border-t border-[#dfdfdf] pt-3.5\" data-kid=\"1-2-4-4-5\" data-name=\"card footer action row\" style=\"margin-top:16px;\">\n                    <button class=\"text-[13px] font-medium text-[#171717] underline decoration-[#dfdfdf] underline-offset-4\" data-kid=\"1-2-4-4-5-1\" data-name=\"save course link button\">\n                        Save\n                    </button>\n                    <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-2-4-4-5-2\" data-name=\"notify me pill button\">\n                        <span class=\"text-[13px]\" data-kid=\"1-2-4-4-5-2-1\" data-name=\"bell icon wrapper\">\n                            <i class=\"icon-bell\" data-kid=\"1-2-4-4-5-2-1-1\" data-name=\"bell icon\">\n                            </i>\n                        </span>\n                        Notify me\n                    </button>\n                </div>\n            </article>\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-4-5\" data-name=\"course card Woodwork Basics\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-2-4-5-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-4-5-1-1\" data-name=\"course code badge\">\n                        CARP-110\n                    </span>\n                    <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-4-5-1-2\" data-name=\"save heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-2-4-5-1-2-1\" data-name=\"heart outline icon\">\n                        </i>\n                    </span>\n                </div>\n                <h3 class=\"font-display mt-3 text-[16px] font-semibold leading-snug\" data-kid=\"1-2-4-5-2\" data-name=\"course title heading\">\n                    Woodwork Basics\n                </h3>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-4-5-3\" data-name=\"provider attribution text\">\n                    ITI Nagpur\n                </p>\n                <div class=\"mt-3 flex items-center gap-1.5 text-[13px] text-[#707070]\" data-kid=\"1-2-4-5-4\" data-name=\"duration meta row\">\n                    <span class=\"text-[14px]\" data-kid=\"1-2-4-5-4-1\" data-name=\"clock icon wrapper\">\n                        <i class=\"icon-clock\" data-kid=\"1-2-4-5-4-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    6 weeks\n                </div>\n                <div class=\"mt-auto flex items-center justify-between border-t border-[#dfdfdf] pt-3.5\" data-kid=\"1-2-4-5-5\" data-name=\"card footer action row\" style=\"margin-top:16px;\">\n                    <button class=\"text-[13px] font-medium text-[#171717] underline decoration-[#dfdfdf] underline-offset-4\" data-kid=\"1-2-4-5-5-1\" data-name=\"save course link button\">\n                        Save\n                    </button>\n                    <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-2-4-5-5-2\" data-name=\"notify me pill button\">\n                        <span class=\"text-[13px]\" data-kid=\"1-2-4-5-5-2-1\" data-name=\"bell icon wrapper\">\n                            <i class=\"icon-bell\" data-kid=\"1-2-4-5-5-2-1-1\" data-name=\"bell icon\">\n                            </i>\n                        </span>\n                        Notify me\n                    </button>\n                </div>\n            </article>\n            <article class=\"flex flex-col rounded-xl border border-[#dfdfdf] bg-white p-5\" data-kid=\"1-2-4-6\" data-name=\"course card Arc Welding Introduction\">\n                <div class=\"flex items-start justify-between\" data-kid=\"1-2-4-6-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-4-6-1-1\" data-name=\"course code badge\">\n                        WELD-120\n                    </span>\n                    <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-4-6-1-2\" data-name=\"save heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-2-4-6-1-2-1\" data-name=\"heart outline icon\">\n                        </i>\n                    </span>\n                </div>\n                <h3 class=\"font-display mt-3 text-[16px] font-semibold leading-snug\" data-kid=\"1-2-4-6-2\" data-name=\"course title heading\">\n                    Arc Welding Introduction\n                </h3>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-4-6-3\" data-name=\"provider attribution text\">\n                    NSDC / Skill India\n                </p>\n                <div class=\"mt-3 flex items-center gap-1.5 text-[13px] text-[#707070]\" data-kid=\"1-2-4-6-4\" data-name=\"duration meta row\">\n                    <span class=\"text-[14px]\" data-kid=\"1-2-4-6-4-1\" data-name=\"clock icon wrapper\">\n                        <i class=\"icon-clock\" data-kid=\"1-2-4-6-4-1-1\" data-name=\"clock icon\">\n                        </i>\n                    </span>\n                    8 weeks\n                </div>\n                <div class=\"mt-auto flex items-center justify-between border-t border-[#dfdfdf] pt-3.5\" data-kid=\"1-2-4-6-5\" data-name=\"card footer action row\" style=\"margin-top:16px;\">\n                    <button class=\"text-[13px] font-medium text-[#171717] underline decoration-[#dfdfdf] underline-offset-4\" data-kid=\"1-2-4-6-5-1\" data-name=\"save course link button\">\n                        Save\n                    </button>\n                    <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-2-4-6-5-2\" data-name=\"notify me pill button\">\n                        <span class=\"text-[13px]\" data-kid=\"1-2-4-6-5-2-1\" data-name=\"bell icon wrapper\">\n                            <i class=\"icon-bell\" data-kid=\"1-2-4-6-5-2-1-1\" data-name=\"bell icon\">\n                            </i>\n                        </span>\n                        Notify me\n                    </button>\n                </div>\n            </article>\n        </div>\n        <p class=\"mt-6 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-5\" data-name=\"helper description text\">\n            Search matches titles and taught skills through the standard taxonomy — “wiring” finds ELEC-101.\n        </p>\n    </main>\n</div>\n",
