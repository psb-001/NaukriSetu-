      "themeId": null,
      "rect": {
        "x": 6650,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif\">\n    <!-- Header -->\n    <header class=\"px-5 pt-7\" data-kid=\"1-1\" data-name=\"header section\">\n        <h1 class=\"font-display text-[20px] font-bold leading-tight\" data-kid=\"1-1-1\" data-name=\"verification page title\">\n            Verification queue\n        </h1>\n        <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-1-2\" data-name=\"header subtitle description\">\n            One trust pattern for people and jobs.\n        </p>\n    </header>\n    <!-- Queue tabs -->\n    <div class=\"flex items-center gap-2 px-5 pt-5\" data-kid=\"1-2\" data-name=\"queue filter tab bar\">\n        <button class=\"font-display flex h-9 items-center rounded-full bg-[#171717] px-4 text-[13px] font-semibold text-white\" data-kid=\"1-2-1\" data-name=\"active KYC docs filter tab with count\">\n            KYC docs (4)\n        </button>\n        <button class=\"flex h-9 items-center rounded-full border border-[#c7c7c7] px-4 text-[13px] font-medium text-[#707070]\" data-kid=\"1-2-2\" data-name=\"inactive Jobs filter tab with count\">\n            Jobs (2)\n        </button>\n    </div>\n    <p class=\"px-5 pt-2.5 text-[12px] leading-snug text-[#9a9a9a]\" data-kid=\"1-3\" data-name=\"queue helper caption text\">\n        Approvals update that seeker's matches immediately.\n    </p>\n    <!-- Queue list -->\n    <div class=\"mt-3 px-5\" data-kid=\"1-4\" data-name=\"verification queue list container\">\n        <ul class=\"divide-y divide-[#dfdfdf]\" data-kid=\"1-4-1\" data-name=\"queue items list with dividers\">\n            <!-- Row 1 — expanded with evidence -->\n            <li class=\"py-4\" data-kid=\"1-4-1-1\" data-name=\"verification queue row with expanded evidence\">\n                <div class=\"flex items-start gap-3\" data-kid=\"1-4-1-1-1\" data-name=\"queue row header layout\">\n                    <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[#707070]\" data-kid=\"1-4-1-1-1-1\" data-name=\"document type icon container\">\n                        <svg aria-hidden=\"true\" data-kid=\"1-4-1-1-1-1-1\" data-name=\"document file icon\" fill=\"none\" height=\"18\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"18\" xmlns=\"http://www.w3.org/2000/svg\">\n                            <path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\">\n                            </path>\n                            <path d=\"M14 2v4a2 2 0 0 0 2 2h4\">\n                            </path>\n                        </svg>\n                    </div>\n                    <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-4-1-1-1-2\" data-name=\"queue row identity text block\">\n                        <p class=\"font-display text-[14px] font-semibold leading-snug\" data-kid=\"1-4-1-1-1-2-1\" data-name=\"seeker name text\">\n                            Ravi Kadam\n                        </p>\n                        <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-4-1-1-1-2-2\" data-name=\"document type label text\">\n                            Aadhaar card\n                        </p>\n                    </div>\n                    <div class=\"flex flex-col items-end gap-2\" data-kid=\"1-4-1-1-1-3\" data-name=\"queue row action column\">\n                        <span class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"1-4-1-1-1-3-1\" data-name=\"submission timestamp text\">\n                            2 min ago\n                        </span>\n                        <div class=\"flex gap-1.5\" data-kid=\"1-4-1-1-1-3-2\" data-name=\"approve and reject button group\">\n                            <button class=\"font-display flex h-8 items-center rounded-md bg-[#3ecf8e] px-3 text-[12px] font-semibold text-[#171717]\" data-kid=\"1-4-1-1-1-3-2-1\" data-name=\"approve action button\">\n                                Approve\n                            </button>\n                            <button class=\"flex h-8 items-center rounded-md border border-[#c7c7c7] bg-white px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-4-1-1-1-3-2-2\" data-name=\"reject action button\">\n                                Reject\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <!-- Evidence block — grouped decision panel -->\n                <div class=\"mt-3 rounded-lg bg-[#fafafa] p-3\" data-kid=\"1-4-1-1-2\" data-name=\"evidence detail panel with decision controls\">\n                    <div class=\"flex items-start gap-3\" data-kid=\"1-4-1-1-2-1\" data-name=\"evidence media and reason row\">\n                        <div class=\"flex h-20 w-20 shrink-0 flex-col items-center justify-center gap-1.5 rounded-lg border border-dashed border-[#c7c7c7] bg-white text-[#9a9a9a]\" data-kid=\"1-4-1-1-2-1-1\" data-name=\"photo upload placeholder card\">\n                            <svg aria-hidden=\"true\" data-kid=\"1-4-1-1-2-1-1-1-1\" data-name=\"camera icon\" fill=\"none\" height=\"20\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" viewbox=\"0 0 24 24\" width=\"20\" xmlns=\"http://www.w3.org/2000/svg\">\n                                <path d=\"M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z\">\n                                </path>\n                                <circle cx=\"12\" cy=\"13\" r=\"3\">\n                                </circle>\n                            </svg>\n                            <span class=\"text-[10px] leading-none\" data-kid=\"1-4-1-1-2-1-1-2\" data-name=\"photo label text\">\n                                Aadhaar photo\n                            </span>\n                        </div>\n                        <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-4-1-1-2-1-2\" data-name=\"rejection reason input column\">\n                            <label class=\"block text-[12px] font-semibold\" data-kid=\"1-4-1-1-2-1-2-1\" data-name=\"rejection reason field label\" for=\"reject-reason-input\">\n                                Reason\n                                <span class=\"font-normal text-[#707070]\" data-kid=\"1-4-1-1-2-1-2-1-1\" data-name=\"reason requirement hint text\">\n                                    (required to reject)\n                                </span>\n                            </label>\n                            <input class=\"mt-1.5 h-9 w-full rounded-lg border border-[#c7c7c7] bg-white px-3 text-[13px] text-[#171717] placeholder:text-[#b2b2b2] focus:border-[#3ecf8e] focus:outline-none\" data-kid=\"1-4-1-1-2-1-2-2\" data-name=\"rejection reason text input\" id=\"reject-reason-input\" placeholder=\"e.g. Photo unreadable\" type=\"text\"/>\n                        </div>\n                    </div>\n                    <button class=\"mt-3 h-9 w-full rounded-md border border-[#ff2201] bg-white text-[12px] font-semibold text-[#ff2201]\" data-kid=\"1-4-1-1-2-2\" data-name=\"reject with note action button\">\n                        Reject with note\n                    </button>\n                </div>\n            </li>\n            <!-- Row 2 -->\n            <li class=\"flex items-start gap-3 py-4\" data-kid=\"1-4-1-2\" data-name=\"verification queue row\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[18px] text-[#707070]\" data-kid=\"1-4-1-2-1\" data-name=\"document type icon container\">\n                    <i class=\"icon-file\" data-kid=\"1-4-1-2-1-1\" data-name=\"document file icon\">\n                    </i>\n                </div>\n                <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-4-1-2-2\" data-name=\"queue row identity text block\">\n                    <p class=\"font-display text-[14px] font-semibold leading-snug\" data-kid=\"1-4-1-2-2-1\" data-name=\"seeker name text\">\n                        Ravi Kadam\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-4-1-2-2-2\" data-name=\"document type label text\">\n                        Address proof\n                    </p>\n                </div>\n                <div class=\"flex flex-col items-end gap-2\" data-kid=\"1-4-1-2-3\" data-name=\"queue row action column\">\n                    <span class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"1-4-1-2-3-1\" data-name=\"submission timestamp text\">\n                        just now\n                    </span>\n                    <div class=\"flex gap-1.5\" data-kid=\"1-4-1-2-3-2\" data-name=\"approve and reject button group\">\n                        <button class=\"font-display flex h-8 items-center rounded-md bg-[#3ecf8e] px-3 text-[12px] font-semibold text-[#171717]\" data-kid=\"1-4-1-2-3-2-1\" data-name=\"approve action button\">\n                            Approve\n                        </button>\n                        <button class=\"flex h-8 items-center rounded-md border border-[#c7c7c7] bg-white px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-4-1-2-3-2-2\" data-name=\"reject action button\">\n                            Reject\n                        </button>\n                    </div>\n                </div>\n            </li>\n            <!-- Row 3 -->\n            <li class=\"flex items-start gap-3 py-4\" data-kid=\"1-4-1-3\" data-name=\"verification queue row\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[18px] text-[#707070]\" data-kid=\"1-4-1-3-1\" data-name=\"document type icon container\">\n                    <i class=\"icon-file\" data-kid=\"1-4-1-3-1-1\" data-name=\"document file icon\">\n                    </i>\n                </div>\n                <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-4-1-3-2\" data-name=\"queue row identity text block\">\n                    <p class=\"font-display text-[14px] font-semibold leading-snug\" data-kid=\"1-4-1-3-2-1\" data-name=\"seeker name text\">\n                        Meena Iyer\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-4-1-3-2-2\" data-name=\"document type label text\">\n                        Aadhaar card\n                    </p>\n                </div>\n                <div class=\"flex flex-col items-end gap-2\" data-kid=\"1-4-1-3-3\" data-name=\"queue row action column\">\n                    <span class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"1-4-1-3-3-1\" data-name=\"submission timestamp text\">\n                        18 min ago\n                    </span>\n                    <div class=\"flex gap-1.5\" data-kid=\"1-4-1-3-3-2\" data-name=\"approve and reject button group\">\n                        <button class=\"font-display flex h-8 items-center rounded-md bg-[#3ecf8e] px-3 text-[12px] font-semibold text-[#171717]\" data-kid=\"1-4-1-3-3-2-1\" data-name=\"approve action button\">\n                            Approve\n                        </button>\n                        <button class=\"flex h-8 items-center rounded-md border border-[#c7c7c7] bg-white px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-4-1-3-3-2-2\" data-name=\"reject action button\">\n                            Reject\n                        </button>\n                    </div>\n                </div>\n            </li>\n            <!-- Row 4 -->\n            <li class=\"flex items-start gap-3 py-4\" data-kid=\"1-4-1-4\" data-name=\"verification queue row\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[18px] text-[#707070]\" data-kid=\"1-4-1-4-1\" data-name=\"document type icon container\">\n                    <i class=\"icon-file\" data-kid=\"1-4-1-4-1-1\" data-name=\"document file icon\">\n                    </i>\n                </div>\n                <div class=\"min-w-0 flex-1 pt-0.5\" data-kid=\"1-4-1-4-2\" data-name=\"queue row identity text block\">\n                    <p class=\"font-display text-[14px] font-semibold leading-snug\" data-kid=\"1-4-1-4-2-1\" data-name=\"seeker name text\">\n                        Suresh Pawar\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-4-1-4-2-2\" data-name=\"document type label text\">\n                        Certificate: ITI Electrician\n                    </p>\n                </div>\n                <div class=\"flex flex-col items-end gap-2\" data-kid=\"1-4-1-4-3\" data-name=\"queue row action column\">\n                    <span class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"1-4-1-4-3-1\" data-name=\"submission timestamp text\">\n                        1 hr ago\n                    </span>\n                    <div class=\"flex gap-1.5\" data-kid=\"1-4-1-4-3-2\" data-name=\"approve and reject button group\">\n                        <button class=\"font-display flex h-8 items-center rounded-md bg-[#3ecf8e] px-3 text-[12px] font-semibold text-[#171717]\" data-kid=\"1-4-1-4-3-2-1\" data-name=\"approve action button\">\n                            Approve\n                        </button>\n                        <button class=\"flex h-8 items-center rounded-md border border-[#c7c7c7] bg-white px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-4-1-4-3-2-2\" data-name=\"reject action button\">\n                            Reject\n                        </button>\n                    </div>\n                </div>\n            </li>\n        </ul>\n    </div>\n    <!-- Privacy caption -->\n    <p class=\"mt-auto px-5 pb-4 pt-8 text-center text-[11px] text-[#9a9a9a]\" data-kid=\"1-5\" data-name=\"demo privacy caption text\">\n        Demo data — nothing leaves this device.\n    </p>\n    <!-- Verifier tab bar -->\n    <nav class=\"border-t border-[#dfdfdf] bg-white px-2 pb-6 pt-2.5\" data-kid=\"1-6\" data-name=\"bottom navigation tab bar\">\n        <div class=\"grid grid-cols-3\" data-kid=\"1-6-1\" data-name=\"nav tabs grid layout\">\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-6-1-1\" data-name=\"KYC queue nav tab\">\n                <span class=\"text-[22px] text-[#3ecf8e]\" data-kid=\"1-6-1-1-1\" data-name=\"shield check icon wrapper\">\n                    <i class=\"icon-shield-check\" data-kid=\"1-6-1-1-1-1\" data-name=\"shield check icon\">\n                    </i>\n                </span>\n                <span class=\"font-display text-[11px] font-semibold text-[#171717]\" data-kid=\"1-6-1-1-2\" data-name=\"KYC queue tab label\">\n                    KYC Queue\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-6-1-2\" data-name=\"jobs queue nav tab\">\n                <span class=\"text-[22px] text-[#707070]\" data-kid=\"1-6-1-2-1\" data-name=\"file check icon wrapper\">\n                    <i class=\"icon-file-check-2\" data-kid=\"1-6-1-2-1-1\" data-name=\"file check icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-6-1-2-2\" data-name=\"jobs queue tab label\">\n                    Jobs Queue\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-6-1-3\" data-name=\"profile nav tab\">\n                <span class=\"text-[22px] text-[#707070]\" data-kid=\"1-6-1-3-1\" data-name=\"user profile icon wrapper\">\n                    <i class=\"icon-user-round\" data-kid=\"1-6-1-3-1-1\" data-name=\"user profile icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-6-1-3-2\" data-name=\"profile tab label\">\n                    Profile\n                </span>\n            </div>\n        </div>\n    </nav>\n</div>\n",
