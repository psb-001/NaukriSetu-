    "var_ce4cf84c23e1": {
      "type": "variant",
      "label": "M14 · Employer — My Postings",
      "parentId": "null",
      "themeId": null,
      "rect": {
        "x": 5225,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif;\">\n    <main class=\"flex-1 px-5 pb-6 pt-7\" data-kid=\"1-1\" data-name=\"main content area\">\n        <!-- Header -->\n        <h1 class=\"font-display text-[20px] font-bold leading-tight\" data-kid=\"1-1-1\" data-name=\"page title heading\">\n            My postings\n        </h1>\n        <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-1-2\" data-name=\"page subtitle description\">\n            Seekers only ever see Live posts.\n        </p>\n        <!-- Confirmation banner -->\n        <div class=\"mt-5 flex items-start gap-2.5 rounded-lg bg-[#e7f8ef] px-3.5 py-3\" data-kid=\"1-1-3\" data-name=\"verification confirmation banner\">\n            <span class=\"text-[16px] leading-none text-[#3ecf8e]\" data-kid=\"1-1-3-1\" data-name=\"confirmation checkmark wrapper\">\n                <i class=\"icon-circle-check\" data-kid=\"1-1-3-1-1\" data-name=\"checkmark circle icon\">\n                </i>\n            </span>\n            <p class=\"text-[13px] leading-snug\" data-kid=\"1-1-3-2\" data-name=\"confirmation message text\">\n                AC Technician — sent for verification. Live after approval.\n            </p>\n        </div>\n        <!-- Postings -->\n        <div class=\"mt-5 flex flex-col gap-3\" data-kid=\"1-1-4\" data-name=\"postings list container\">\n            <!-- 1 · Live -->\n            <article class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-1-4-1\" data-name=\"live job posting card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-4-1-1\" data-name=\"posting title row\">\n                    <h2 class=\"font-display text-[15px] font-semibold leading-snug\" data-kid=\"1-1-4-1-1-1\" data-name=\"posting title text\">\n                        AC Technician — Voltas Service Partner\n                    </h2>\n                    <span class=\"flex shrink-0 items-center gap-1.5 rounded-full bg-[#e7f8ef] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-1-4-1-1-2\" data-name=\"live status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#3ecf8e]\" data-kid=\"1-1-4-1-1-2-1\" data-name=\"live status indicator dot\">\n                        </span>\n                        Live\n                    </span>\n                </div>\n                <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-1-4-1-2\" data-name=\"posting criteria and salary text\">\n                    3 criteria · ₹24–28k\n                </p>\n                <div class=\"mt-3 flex items-center justify-between border-t border-[#ebebeb] pt-3\" data-kid=\"1-1-4-1-3\" data-name=\"posting footer action row\">\n                    <p class=\"text-[13px] font-medium\" data-kid=\"1-1-4-1-3-1\" data-name=\"seeker qualification count\">\n                        12 seekers qualify\n                    </p>\n                    <div class=\"flex items-center gap-4 text-[12px] text-[#707070]\" data-kid=\"1-1-4-1-3-2\" data-name=\"posting action buttons row\">\n                        <span class=\"flex items-center gap-1\" data-kid=\"1-1-4-1-3-2-1\" data-name=\"edit action button\">\n                            <span class=\"text-[14px] leading-none\" data-kid=\"1-1-4-1-3-2-1-1\" data-name=\"edit icon container\">\n                                <i class=\"icon-pencil\" data-kid=\"1-1-4-1-3-2-1-1-1\" data-name=\"pencil edit icon\">\n                                </i>\n                            </span>\n                            Edit\n                        </span>\n                        <span class=\"flex items-center gap-1\" data-kid=\"1-1-4-1-3-2-2\" data-name=\"delete action button\">\n                            <span class=\"text-[14px] leading-none\" data-kid=\"1-1-4-1-3-2-2-1\" data-name=\"delete icon container\">\n                                <i class=\"icon-trash-2\" data-kid=\"1-1-4-1-3-2-2-1-1\" data-name=\"trash delete icon\">\n                                </i>\n                            </span>\n                            Delete\n                        </span>\n                    </div>\n                </div>\n            </article>\n            <!-- 2 · Pending -->\n            <article class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-1-4-2\" data-name=\"pending job posting card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-4-2-1\" data-name=\"posting title row\">\n                    <h2 class=\"font-display text-[15px] font-semibold leading-snug\" data-kid=\"1-1-4-2-1-1\" data-name=\"posting title text\">\n                        Fan Repair Technician — RBI Colony Society\n                    </h2>\n                    <span class=\"flex shrink-0 items-center gap-1.5 rounded-full bg-[#fff8d6] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-1-4-2-1-2\" data-name=\"pending status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#ffdb13]\" data-kid=\"1-1-4-2-1-2-1\" data-name=\"pending status indicator dot\">\n                        </span>\n                        Pending\n                    </span>\n                </div>\n                <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-1-4-2-2\" data-name=\"posting criteria and salary text\">\n                    2 criteria · ₹18–21k\n                </p>\n                <div class=\"mt-3 flex items-center justify-between border-t border-[#ebebeb] pt-3\" data-kid=\"1-1-4-2-3\" data-name=\"posting footer action row\">\n                    <p class=\"text-[12px] text-[#9a9a9a]\" data-kid=\"1-1-4-2-3-1\" data-name=\"visibility status text\">\n                        Not visible to seekers yet\n                    </p>\n                    <div class=\"flex items-center gap-4 text-[12px] text-[#707070]\" data-kid=\"1-1-4-2-3-2\" data-name=\"posting action buttons row\">\n                        <span class=\"flex items-center gap-1\" data-kid=\"1-1-4-2-3-2-1\" data-name=\"edit action button\">\n                            <span class=\"text-[14px] leading-none\" data-kid=\"1-1-4-2-3-2-1-1\" data-name=\"edit icon container\">\n                                <i class=\"icon-pencil\" data-kid=\"1-1-4-2-3-2-1-1-1\" data-name=\"pencil edit icon\">\n                                </i>\n                            </span>\n                            Edit\n                        </span>\n                        <span class=\"flex items-center gap-1\" data-kid=\"1-1-4-2-3-2-2\" data-name=\"delete action button\">\n                            <span class=\"text-[14px] leading-none\" data-kid=\"1-1-4-2-3-2-2-1\" data-name=\"delete icon container\">\n                                <i class=\"icon-trash-2\" data-kid=\"1-1-4-2-3-2-2-1-1\" data-name=\"trash delete icon\">\n                                </i>\n                            </span>\n                            Delete\n                        </span>\n                    </div>\n                </div>\n            </article>\n            <!-- 3 · Rejected -->\n            <article class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-1-4-3\" data-name=\"rejected job posting card\">\n                <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-1-4-3-1\" data-name=\"posting title row\">\n                    <h2 class=\"font-display text-[15px] font-semibold leading-snug\" data-kid=\"1-1-4-3-1-1\" data-name=\"posting title text\">\n                        Plumbing Helper — Rao Constructions\n                    </h2>\n                    <span class=\"flex shrink-0 items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-1-4-3-1-2\" data-name=\"rejected status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-1-4-3-1-2-1\" data-name=\"rejected status indicator dot\">\n                        </span>\n                        Rejected\n                    </span>\n                </div>\n                <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-1-4-3-2\" data-name=\"posting criteria and salary text\">\n                    2 criteria · ₹13–16k\n                </p>\n                <div class=\"mt-2.5 rounded-lg bg-[#ffeceb] px-3 py-2.5 text-[12px] leading-snug\" data-kid=\"1-1-4-3-3\" data-name=\"verifier note callout\">\n                    <span class=\"font-semibold\" data-kid=\"1-1-4-3-3-1\" data-name=\"verifier note label\">\n                        Verifier note:\n                    </span>\n                    add a fixed maximum pay so seekers see a realistic range.\n                </div>\n                <div class=\"mt-3 flex items-center justify-between border-t border-[#ebebeb] pt-3\" data-kid=\"1-1-4-3-4\" data-name=\"posting footer action row\">\n                    <p class=\"text-[12px] text-[#9a9a9a]\" data-kid=\"1-1-4-3-4-1\" data-name=\"visibility status text\">\n                        Hidden from seekers\n                    </p>\n                    <div class=\"flex items-center gap-4 text-[12px] text-[#707070]\" data-kid=\"1-1-4-3-4-2\" data-name=\"posting action buttons row\">\n                        <span class=\"flex items-center gap-1\" data-kid=\"1-1-4-3-4-2-1\" data-name=\"edit action button\">\n                            <span class=\"text-[14px] leading-none\" data-kid=\"1-1-4-3-4-2-1-1\" data-name=\"edit icon container\">\n                                <i class=\"icon-pencil\" data-kid=\"1-1-4-3-4-2-1-1-1\" data-name=\"pencil edit icon\">\n                                </i>\n                            </span>\n                            Edit\n                        </span>\n                        <span class=\"flex items-center gap-1\" data-kid=\"1-1-4-3-4-2-2\" data-name=\"delete action button\">\n                            <span class=\"text-[14px] leading-none\" data-kid=\"1-1-4-3-4-2-2-1\" data-name=\"delete icon container\">\n                                <i class=\"icon-trash-2\" data-kid=\"1-1-4-3-4-2-2-1-1\" data-name=\"trash delete icon\">\n                                </i>\n                            </span>\n                            Delete\n                        </span>\n                    </div>\n                </div>\n            </article>\n        </div>\n        <p class=\"mt-3 text-[11px] text-[#9a9a9a]\" data-kid=\"1-1-5\" data-name=\"editing disclaimer footnote\">\n            Editing re-sends the post for verification.\n        </p>\n    </main>\n    <!-- Employer tab bar -->\n    <nav class=\"mt-auto border-t border-[#dfdfdf] bg-white\" data-kid=\"1-2\" data-name=\"bottom tab navigation bar\">\n        <div class=\"grid grid-cols-3 px-2 pb-5 pt-2.5\" data-kid=\"1-2-1\" data-name=\"tab grid container\">\n            <div class=\"flex flex-col items-center gap-1 text-[#707070]\" data-kid=\"1-2-1-1\" data-name=\"post job tab\">\n                <span class=\"text-[22px] leading-none\" data-kid=\"1-2-1-1-1\" data-name=\"post job icon container\">\n                    <i class=\"icon-plus-circle\" data-kid=\"1-2-1-1-1-1\" data-name=\"plus circle icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium\" data-kid=\"1-2-1-1-2\" data-name=\"post job tab label\">\n                    Post Job\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-2-1-2\" data-name=\"my postings tab (active)\">\n                <span class=\"text-[22px] leading-none text-[#3ecf8e]\" data-kid=\"1-2-1-2-1\" data-name=\"my postings icon container\">\n                    <i class=\"icon-list\" data-kid=\"1-2-1-2-1-1\" data-name=\"list icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-1-2-2\" data-name=\"my postings tab label\">\n                    My Postings\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1 text-[#707070]\" data-kid=\"1-2-1-3\" data-name=\"profile tab\">\n                <span class=\"text-[22px] leading-none\" data-kid=\"1-2-1-3-1\" data-name=\"profile icon container\">\n                    <i class=\"icon-user-round\" data-kid=\"1-2-1-3-1-1\" data-name=\"user profile icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium\" data-kid=\"1-2-1-3-2\" data-name=\"profile tab label\">\n                    Profile\n                </span>\n            </div>\n        </div>\n    </nav>\n</div>\n",
