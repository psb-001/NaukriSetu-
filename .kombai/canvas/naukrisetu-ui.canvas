    "var_78ef34c5231b": {
      "type": "variant",
      "label": "M16 · Verifier — Jobs Queue",
      "parentId": "null",
      "themeId": null,
      "rect": {
        "x": 7125,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif\">\n    <main class=\"flex-1 px-5 pb-6 pt-6\" data-kid=\"1-1\" data-name=\"main verification queue content\">\n        <!-- Header -->\n        <header data-kid=\"1-1-1\" data-name=\"page header section\">\n            <h1 class=\"text-[20px] font-bold leading-tight\" data-kid=\"1-1-1-1\" data-name=\"page title heading\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                Verification queue\n            </h1>\n            <p class=\"mt-1 text-[13px] leading-snug text-[#707070]\" data-kid=\"1-1-1-2\" data-name=\"page subtitle description\">\n                Approve once — the post is live for every seeker instantly.\n            </p>\n        </header>\n        <!-- Queue tabs -->\n        <div class=\"mt-5 flex items-center gap-2\" data-kid=\"1-1-2\" data-name=\"queue filter tab list\" role=\"tablist\">\n            <button class=\"flex h-9 shrink-0 items-center rounded-full border border-[#c7c7c7] bg-white px-4 text-[13px] font-semibold text-[#171717]\" data-kid=\"1-1-2-1\" data-name=\"KYC docs tab button\">\n                KYC docs (4)\n            </button>\n            <button aria-current=\"true\" class=\"flex h-9 shrink-0 items-center rounded-full bg-[#171717] px-4 text-[13px] font-semibold text-white\" data-kid=\"1-1-2-2\" data-name=\"jobs tab button (active)\">\n                Jobs (2)\n            </button>\n        </div>\n        <!-- Queue rows -->\n        <div class=\"mt-4 flex flex-col gap-3\" data-kid=\"1-1-3\" data-name=\"queue card list container\">\n            <!-- Row 1 · Pending job -->\n            <article class=\"rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-1-3-1\" data-name=\"pending job verification card\">\n                <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-1-3-1-1\" data-name=\"card header row\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-3-1-1-1\" data-name=\"company and role info block\">\n                        <p class=\"text-[12px] text-[#707070]\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"company name label\">\n                            Sharma Enterprises\n                        </p>\n                        <h3 class=\"mt-0.5 text-[16px] font-semibold leading-snug\" data-kid=\"1-1-3-1-1-1-2\" data-name=\"job role title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Fan Repair Technician\n                        </h3>\n                    </div>\n                    <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#fff8d6] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-1-3-1-1-2\" data-name=\"pending status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#ffdb13]\" data-kid=\"1-1-3-1-1-2-1\" data-name=\"pending status indicator dot\">\n                        </span>\n                        Pending\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-1-3-1-2\" data-name=\"job summary line (criteria, pay, city)\">\n                    2 criteria · ₹18–21k · Pune\n                </p>\n                <div class=\"mt-3 flex flex-wrap gap-1.5\" data-kid=\"1-1-3-1-3\" data-name=\"job criteria tags container\">\n                    <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] leading-none text-[#171717]\" data-kid=\"1-1-3-1-3-1\" data-name=\"certificate criteria tag\">\n                        Certificate: Fan Motor Repair\n                    </span>\n                    <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] leading-none text-[#171717]\" data-kid=\"1-1-3-1-3-2\" data-name=\"city criteria tag\">\n                        City = Pune\n                    </span>\n                </div>\n                <div class=\"mt-4 flex items-center gap-2\" data-kid=\"1-1-3-1-4\" data-name=\"card action button row\">\n                    <button class=\"h-9 shrink-0 rounded-md bg-[#3ecf8e] px-4 text-[13px] font-semibold text-[#171717]\" data-kid=\"1-1-3-1-4-1\" data-name=\"approve job button\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                        Approve\n                    </button>\n                    <button class=\"h-9 shrink-0 rounded-md border border-[#c7c7c7] bg-white px-4 text-[13px] font-medium text-[#171717]\" data-kid=\"1-1-3-1-4-2\" data-name=\"reject job button\">\n                        Reject\n                    </button>\n                    <span class=\"ml-auto cursor-pointer text-[12px] text-[#171717] underline underline-offset-2\" data-kid=\"1-1-3-1-4-3\" data-name=\"view full post link\">\n                        View full post\n                    </span>\n                </div>\n            </article>\n            <!-- Row 2 · Rejected job -->\n            <article class=\"rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-1-3-2\" data-name=\"rejected job verification card\">\n                <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-1-3-2-1\" data-name=\"card header row\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-3-2-1-1\" data-name=\"company and role info block\">\n                        <p class=\"text-[12px] text-[#707070]\" data-kid=\"1-1-3-2-1-1-1\" data-name=\"company name label\">\n                            Rao Constructions\n                        </p>\n                        <h3 class=\"mt-0.5 text-[16px] font-semibold leading-snug\" data-kid=\"1-1-3-2-1-1-2\" data-name=\"job role title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Plumbing Helper\n                        </h3>\n                    </div>\n                    <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#ffeceb] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-1-3-2-1-2\" data-name=\"rejected status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#ff2201]\" data-kid=\"1-1-3-2-1-2-1\" data-name=\"rejected status indicator dot\">\n                        </span>\n                        Rejected\n                    </span>\n                </div>\n                <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-1-3-2-2\" data-name=\"job summary line (criteria, pay, city)\">\n                    2 criteria · ₹13–16k · Pune\n                </p>\n                <div class=\"mt-3 rounded-lg bg-[#ffeceb] p-3\" data-kid=\"1-1-3-2-3\" data-name=\"rejection reason notice block\">\n                    <p class=\"text-[12px] leading-snug text-[#171717]\" data-kid=\"1-1-3-2-3-1\" data-name=\"rejection note text\">\n                        <span class=\"font-semibold\" data-kid=\"1-1-3-2-3-1-1\" data-name=\"rejected status word in note\">\n                            Rejected\n                        </span>\n                        — verifier note: add a fixed maximum pay so seekers see a realistic range.\n                    </p>\n                </div>\n                <div class=\"mt-3\" data-kid=\"1-1-3-2-4\" data-name=\"resubmit action container\">\n                    <button class=\"h-9 rounded-md border border-[#c7c7c7] bg-white px-3 text-[12px] font-medium text-[#171717]\" data-kid=\"1-1-3-2-4-1\" data-name=\"re-submit after edit button\">\n                        Re-submit after edit\n                    </button>\n                </div>\n            </article>\n        </div>\n        <p class=\"mt-4 text-[11px] leading-snug text-[#9a9a9a]\" data-kid=\"1-1-4\" data-name=\"queue footer disclaimer text\">\n            Pending and rejected posts never appear in seeker matches — enforced in the engine.\n        </p>\n        <!-- Approved today -->\n        <section class=\"mt-6\" data-kid=\"1-1-5\" data-name=\"approved today section\">\n            <div class=\"flex items-center justify-between\" data-kid=\"1-1-5-1\" data-name=\"approved section header row\">\n                <h2 class=\"text-[13px] font-semibold text-[#171717]\" data-kid=\"1-1-5-1-1\" data-name=\"approved section heading\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                    Approved today\n                </h2>\n                <span class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"1-1-5-1-2\" data-name=\"approved post count label\">\n                    1 post\n                </span>\n            </div>\n            <div class=\"mt-2 rounded-xl border border-[#dfdfdf] bg-white p-4\" data-kid=\"1-1-5-2\" data-name=\"approved post card\">\n                <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-1-5-2-1\" data-name=\"approved card header row\">\n                    <div class=\"min-w-0\" data-kid=\"1-1-5-2-1-1\" data-name=\"company and role info block\">\n                        <p class=\"text-[12px] text-[#707070]\" data-kid=\"1-1-5-2-1-1-1\" data-name=\"company name label\">\n                            Kesari Electricals\n                        </p>\n                        <h3 class=\"mt-0.5 text-[15px] font-semibold leading-snug\" data-kid=\"1-1-5-2-1-1-2\" data-name=\"approved job role title\" style=\"font-family:'Plus Jakarta Sans',sans-serif\">\n                            Wiring Assistant\n                        </h3>\n                    </div>\n                    <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#e7f8ef] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-1-5-2-1-2\" data-name=\"live status badge\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#3ecf8e]\" data-kid=\"1-1-5-2-1-2-1\" data-name=\"live status indicator dot\">\n                        </span>\n                        Live\n                    </span>\n                </div>\n                <p class=\"mt-1.5 text-[12px] leading-snug text-[#707070]\" data-kid=\"1-1-5-2-2\" data-name=\"approval detail line (time, seekers)\">\n                    Approved 10:24 · appears in seeker matches instantly · 3 seekers qualify\n                </p>\n            </div>\n        </section>\n    </main>\n    <!-- Verifier bottom tab bar -->\n    <nav class=\"mt-auto border-t border-[#dfdfdf] bg-white px-2 pb-6 pt-2.5\" data-kid=\"1-2\" data-name=\"verifier bottom tab navigation\">\n        <div class=\"grid grid-cols-3\" data-kid=\"1-2-1\" data-name=\"bottom tab grid container\">\n            <a class=\"flex flex-col items-center gap-1 py-1 text-[#707070]\" data-kid=\"1-2-1-1\" data-name=\"KYC queue tab item\">\n                <span class=\"text-[22px] leading-none\" data-kid=\"1-2-1-1-1\" data-name=\"KYC queue icon container\">\n                    <i class=\"icon-shield-check\" data-kid=\"1-2-1-1-1-1\" data-name=\"shield check icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium\" data-kid=\"1-2-1-1-2\" data-name=\"KYC queue tab label\">\n                    KYC Queue\n                </span>\n            </a>\n            <a class=\"flex flex-col items-center gap-1 py-1\" data-kid=\"1-2-1-2\" data-name=\"jobs queue tab item (active)\">\n                <span class=\"text-[22px] leading-none text-[#3ecf8e]\" data-kid=\"1-2-1-2-1\" data-name=\"jobs queue icon container\">\n                    <i class=\"icon-file-check-2\" data-kid=\"1-2-1-2-1-1\" data-name=\"file check icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-1-2-2\" data-name=\"jobs queue tab label\">\n                    Jobs Queue\n                </span>\n            </a>\n            <a class=\"flex flex-col items-center gap-1 py-1 text-[#707070]\" data-kid=\"1-2-1-3\" data-name=\"profile tab item\">\n                <span class=\"text-[22px] leading-none\" data-kid=\"1-2-1-3-1\" data-name=\"profile icon container\">\n                    <i class=\"icon-user-round\" data-kid=\"1-2-1-3-1-1\" data-name=\"user profile icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium\" data-kid=\"1-2-1-3-2\" data-name=\"profile tab label\">\n                    Profile\n                </span>\n            </a>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T07:45:27.681437+00:00",
      "modified": "2026-10-11T07:46:25.434666+00:00",
      "id": "var_78ef34c5231b",
      "contentHeight": 1000
    },
    "var_c913d821add3": {
      "type": "variant",
      "label": "M10 · Profile / KYC + Settings",
      "parentId": "null",
      "themeId": null,
      "rect": {
        "x": 7600,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.font-display{font-family:'Plus Jakarta Sans',sans-serif;}\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif;\">\n    <main class=\"flex-1 px-5 pb-8 pt-6\" data-kid=\"1-1\" data-name=\"main content area\">\n        <!-- Header -->\n        <header data-kid=\"1-1-1\" data-name=\"profile header with name and email\">\n            <h1 class=\"font-display text-[20px] font-bold leading-tight\" data-kid=\"1-1-1-1\" data-name=\"page title heading\">\n                Profile\n            </h1>\n            <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-1-1-2\" data-name=\"user name and email subtitle\">\n                Ravi Kadam · ravi.kadam@gmail.com\n            </p>\n        </header>\n        <!-- Amber verification banner -->\n        <div class=\"mt-4 flex items-center gap-2.5 rounded-lg bg-[#fff8d6] px-3.5 py-3\" data-kid=\"1-1-2\" data-name=\"verification pending banner\">\n            <span class=\"h-2 w-2 shrink-0 rounded-full bg-[#ffdb13]\" data-kid=\"1-1-2-1\" data-name=\"yellow pending indicator dot\">\n            </span>\n            <p class=\"text-[13px] leading-snug\" data-kid=\"1-1-2-2\" data-name=\"verification status message\">\n                Verification pending — you can browse, some jobs stay locked.\n            </p>\n        </div>\n        <!-- Progress header -->\n        <section class=\"mt-5\" data-kid=\"1-1-3\" data-name=\"profile completeness section\">\n            <div class=\"flex items-baseline justify-between\" data-kid=\"1-1-3-1\" data-name=\"progress header row\">\n                <p class=\"font-display text-[15px] font-semibold\" data-kid=\"1-1-3-1-1\" data-name=\"profile completion percentage label\">\n                    Profile 40% complete\n                </p>\n                <p class=\"text-[12px] text-[#707070]\" data-kid=\"1-1-3-1-2\" data-name=\"completed checks count label\">\n                    2 of 5 checks done\n                </p>\n            </div>\n            <div class=\"mt-2 h-2 w-full overflow-hidden rounded-full bg-[#ebebeb]\" data-kid=\"1-1-3-2\" data-name=\"progress bar track\">\n                <div class=\"h-full w-[40%] rounded-full bg-[#3ecf8e]\" data-kid=\"1-1-3-2-1\" data-name=\"progress bar fill at 40 percent\">\n                </div>\n            </div>\n            <p class=\"mt-2.5 text-[13px]\" data-kid=\"1-1-3-3\" data-name=\"completing KYC unlocks note\">\n                Completing KYC unlocks\n                <span class=\"font-semibold\" data-kid=\"1-1-3-3-1\" data-name=\"lockable jobs count emphasis\">\n                    2 more jobs\n                </span>\n            </p>\n        </section>\n        <!-- KYC steps — vertical stepper -->\n        <section class=\"mt-7\" data-kid=\"1-1-4\" data-name=\"KYC vertical stepper section\">\n            <!-- Step 1 · Aadhaar (done) -->\n            <div class=\"flex gap-4\" data-kid=\"1-1-4-1\" data-name=\"Aadhaar verification step row\">\n                <div class=\"flex w-8 shrink-0 flex-col items-center\" data-kid=\"1-1-4-1-1\" data-name=\"step 1 indicator column\">\n                    <div class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#3ecf8e]\" data-kid=\"1-1-4-1-1-1\" data-name=\"completed step circle badge\">\n                        <span class=\"text-[15px] text-white\" data-kid=\"1-1-4-1-1-1-1\" data-name=\"checkmark icon holder\">\n                            <i class=\"icon-check\" data-kid=\"1-1-4-1-1-1-1-1\" data-name=\"checkmark icon\">\n                            </i>\n                        </span>\n                    </div>\n                    <div class=\"my-1.5 w-px flex-1 bg-[#dfdfdf]\" data-kid=\"1-1-4-1-1-2\" data-name=\"vertical connector line\">\n                    </div>\n                </div>\n                <div class=\"min-w-0 flex-1 pb-7\" data-kid=\"1-1-4-1-2\" data-name=\"step 1 content area\">\n                    <div class=\"flex items-center justify-between gap-3\" data-kid=\"1-1-4-1-2-1\" data-name=\"step title and status row\">\n                        <h2 class=\"font-display text-[15px] font-semibold\" data-kid=\"1-1-4-1-2-1-1\" data-name=\"Aadhaar step title\">\n                            Aadhaar\n                        </h2>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#fff8d6] px-2.5 py-1 text-[11px] font-medium\" data-kid=\"1-1-4-1-2-1-2\" data-name=\"pending status badge\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#ffdb13]\" data-kid=\"1-1-4-1-2-1-2-1\" data-name=\"pending dot icon\">\n                            </span>\n                            Pending\n                        </span>\n                    </div>\n                    <div class=\"mt-2.5 flex items-center gap-3\" data-kid=\"1-1-4-1-2-2\" data-name=\"upload status row\">\n                        <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-[#ebebeb] bg-[#fafafa] text-[18px] text-[#707070]\" data-kid=\"1-1-4-1-2-2-1\" data-name=\"file icon thumbnail\">\n                            <i class=\"icon-file\" data-kid=\"1-1-4-1-2-2-1-1\" data-name=\"file icon\">\n                            </i>\n                        </div>\n                        <p class=\"text-[12px] text-[#707070]\" data-kid=\"1-1-4-1-2-2-2\" data-name=\"uploaded status text\">\n                            Uploaded · awaiting check\n                        </p>\n                    </div>\n                    <p class=\"mt-2.5 text-[11px] leading-snug text-[#9a9a9a]\" data-kid=\"1-1-4-1-2-3\" data-name=\"demo disclaimer note\">\n                        12-digit format check only — demo does not contact UIDAI.\n                    </p>\n                </div>\n            </div>\n            <!-- Step 2 · Address (current) -->\n            <div class=\"flex gap-4\" data-kid=\"1-1-4-2\" data-name=\"Address verification step row\">\n                <div class=\"flex w-8 shrink-0 flex-col items-center\" data-kid=\"1-1-4-2-1\" data-name=\"step 2 indicator column\">\n                    <div class=\"flex h-8 w-8 items-center justify-center rounded-full border-2 border-[#3ecf8e] bg-white\" data-kid=\"1-1-4-2-1-1\" data-name=\"current step circle badge\">\n                        <span class=\"font-display text-[13px] font-bold text-[#3ecf8e]\" data-kid=\"1-1-4-2-1-1-1\" data-name=\"step number two text\">\n                            2\n                        </span>\n                    </div>\n                    <div class=\"my-1.5 w-px flex-1 bg-[#dfdfdf]\" data-kid=\"1-1-4-2-1-2\" data-name=\"vertical connector line\">\n                    </div>\n                </div>\n                <div class=\"min-w-0 flex-1 pb-7\" data-kid=\"1-1-4-2-2\" data-name=\"step 2 content area\">\n                    <h2 class=\"font-display text-[15px] font-semibold\" data-kid=\"1-1-4-2-2-1\" data-name=\"Address step title\">\n                        Address\n                    </h2>\n                    <label class=\"mb-1.5 mt-3 block text-[13px] font-semibold\" data-kid=\"1-1-4-2-2-2\" data-name=\"full address field label\">\n                        Full address\n                    </label>\n                    <div class=\"rounded-lg border border-[#c7c7c7] px-3 py-2.5 text-[14px] leading-snug\" data-kid=\"1-1-4-2-2-3\" data-name=\"full address input display\">\n                        Flat 4, Sai Residency, Kothrud\n                    </div>\n                    <label class=\"mb-1.5 mt-3.5 block text-[13px] font-semibold\" data-kid=\"1-1-4-2-2-4\" data-name=\"city field label\">\n                        City\n                    </label>\n                    <div class=\"flex items-center justify-between rounded-lg border border-[#c7c7c7] px-3 py-2.5\" data-kid=\"1-1-4-2-2-5\" data-name=\"city selector field\">\n                        <span class=\"flex items-center gap-2 text-[14px]\" data-kid=\"1-1-4-2-2-5-1\" data-name=\"city value with pin icon\">\n                            <span class=\"text-[16px] text-[#707070]\" data-kid=\"1-1-4-2-2-5-1-1\" data-name=\"map pin icon holder\">\n                                <i class=\"icon-map-pin\" data-kid=\"1-1-4-2-2-5-1-1-1\" data-name=\"map pin icon\">\n                                </i>\n                            </span>\n                            Pune\n                        </span>\n                        <span class=\"text-[16px] text-[#b2b2b2]\" data-kid=\"1-1-4-2-2-5-2\" data-name=\"chevron down indicator holder\">\n                            <i class=\"icon-chevron-down\" data-kid=\"1-1-4-2-2-5-2-1\" data-name=\"chevron down icon\">\n                            </i>\n                        </span>\n                    </div>\n                    <p class=\"mt-1.5 text-[11px] leading-snug text-[#9a9a9a]\" data-kid=\"1-1-4-2-2-6\" data-name=\"city change note\">\n                        Changing city re-runs your matches instantly.\n                    </p>\n                    <div class=\"mt-3.5 flex items-center justify-center gap-2 rounded-lg border border-dashed border-[#c7c7c7] py-3.5\" data-kid=\"1-1-4-2-2-7\" data-name=\"address proof upload dropzone\">\n                        <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-1-4-2-2-7-1\" data-name=\"camera icon holder\">\n                            <i class=\"icon-camera\" data-kid=\"1-1-4-2-2-7-1-1\" data-name=\"camera icon\">\n                            </i>\n                        </span>\n                        <p class=\"text-[13px] font-medium\" data-kid=\"1-1-4-2-2-7-2\" data-name=\"upload address proof label\">\n                            Take photo or upload address proof\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- Step 3 · Certificates (upcoming) -->\n            <div class=\"flex gap-4\" data-kid=\"1-1-4-3\" data-name=\"Certificates step row\">\n                <div class=\"flex w-8 shrink-0 flex-col items-center\" data-kid=\"1-1-4-3-1\" data-name=\"step 3 indicator column\">\n                    <div class=\"flex h-8 w-8 items-center justify-center rounded-full border border-[#dfdfdf] bg-white\" data-kid=\"1-1-4-3-1-1\" data-name=\"upcoming step circle badge\">\n                        <span class=\"font-display text-[13px] font-bold text-[#9a9a9a]\" data-kid=\"1-1-4-3-1-1-1\" data-name=\"step number three text\">\n                            3\n                        </span>\n                    </div>\n                </div>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-4-3-2\" data-name=\"step 3 content area\">\n                    <h2 class=\"font-display text-[15px] font-semibold\" data-kid=\"1-1-4-3-2-1\" data-name=\"Certificates step title\">\n                        Certificates\n                    </h2>\n                    <div class=\"mt-2.5 flex items-center justify-between gap-3\" data-kid=\"1-1-4-3-2-2\" data-name=\"certificate entry row\">\n                        <div class=\"min-w-0\" data-kid=\"1-1-4-3-2-2-1\" data-name=\"certificate detail container\">\n                            <p class=\"font-display truncate text-[14px] font-medium\" data-kid=\"1-1-4-3-2-2-1-1\" data-name=\"certificate name text\">\n                                ITI Electrician Certificate\n                            </p>\n                            <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-1-4-3-2-2-1-2\" data-name=\"certificate issuer and expiry text\">\n                                NCVT · expires 2028\n                            </p>\n                        </div>\n                        <span class=\"inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#fff8d6] px-2.5 py-1 text-[11px] font-medium\" data-kid=\"1-1-4-3-2-2-2\" data-name=\"pending status badge\">\n                            <span class=\"h-1.5 w-1.5 rounded-full bg-[#ffdb13]\" data-kid=\"1-1-4-3-2-2-2-1\" data-name=\"pending dot icon\">\n                            </span>\n                            Pending\n                        </span>\n                    </div>\n                    <p class=\"mt-2.5 text-[11px] leading-snug text-[#9a9a9a]\" data-kid=\"1-1-4-3-2-3\" data-name=\"matching disclaimer note\">\n                        Write the name exactly as on the certificate — it is matched letter for letter.\n                    </p>\n                    <button class=\"mt-3 flex items-center gap-1.5 text-[13px] font-medium\" data-kid=\"1-1-4-3-2-4\" data-name=\"add certificate button\">\n                        <span class=\"text-[17px] text-[#707070]\" data-kid=\"1-1-4-3-2-4-1\" data-name=\"plus icon holder\">\n                            <i class=\"icon-plus-circle\" data-kid=\"1-1-4-3-2-4-1-1\" data-name=\"plus circle icon\">\n                            </i>\n                        </span>\n                        Add certificate\n                    </button>\n                </div>\n            </div>\n        </section>\n        <!-- Privacy line -->\n        <p class=\"mt-7 text-center text-[11px] text-[#9a9a9a]\" data-kid=\"1-1-5\" data-name=\"privacy note about devices\">\n            Documents stay on this device in the demo.\n        </p>\n        <!-- Settings -->\n        <section class=\"mt-8 border-t border-[#dfdfdf] pt-5\" data-kid=\"1-1-6\" data-name=\"settings section\">\n            <h2 class=\"font-display text-[16px] font-semibold\" data-kid=\"1-1-6-1\" data-name=\"Settings section heading\">\n                Settings\n            </h2>\n            <div class=\"mt-1\" data-kid=\"1-1-6-2\" data-name=\"settings list container\">\n                <div class=\"flex items-center justify-between gap-3 border-b border-[#dfdfdf] py-3.5\" data-kid=\"1-1-6-2-1\" data-name=\"app language settings row\">\n                    <div data-kid=\"1-1-6-2-1-1\" data-name=\"language label and subtext\">\n                        <p class=\"text-[14px]\" data-kid=\"1-1-6-2-1-1-1\" data-name=\"app language label\">\n                            App language\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#9a9a9a]\" data-kid=\"1-1-6-2-1-1-2\" data-name=\"language availability subtext\">\n                            Hindi / Marathi coming\n                        </p>\n                    </div>\n                    <div class=\"flex shrink-0 items-center gap-1 text-[13px] text-[#707070]\" data-kid=\"1-1-6-2-1-2\" data-name=\"current language value with arrow\">\n                        English\n                        <span class=\"text-[16px]\" data-kid=\"1-1-6-2-1-2-1\" data-name=\"chevron right icon holder\">\n                            <i class=\"icon-chevron-right\" data-kid=\"1-1-6-2-1-2-1-1\" data-name=\"chevron right icon\">\n                            </i>\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center justify-between gap-3 border-b border-[#dfdfdf] py-3.5\" data-kid=\"1-1-6-2-2\" data-name=\"about settings row\">\n                    <p class=\"text-[14px]\" data-kid=\"1-1-6-2-2-1\" data-name=\"About label\">\n                        About\n                    </p>\n                    <p class=\"text-[12px] text-[#707070]\" data-kid=\"1-1-6-2-2-2\" data-name=\"app version text\">\n                        NaukriSetu v0.1.0 (demo)\n                    </p>\n                </div>\n                <div class=\"flex items-center justify-between gap-3 py-3.5\" data-kid=\"1-1-6-2-3\" data-name=\"demo reset settings row\">\n                    <div data-kid=\"1-1-6-2-3-1\" data-name=\"demo reset label and subtext\">\n                        <p class=\"text-[14px] text-[#ff2201]\" data-kid=\"1-1-6-2-3-1-1\" data-name=\"demo reset label in red\">\n                            Demo reset\n                        </p>\n                        <p class=\"mt-0.5 text-[11px] text-[#9a9a9a]\" data-kid=\"1-1-6-2-3-1-2\" data-name=\"clears local data subtext\">\n                            Clears all local data\n                        </p>\n                    </div>\n                    <span class=\"text-[16px] text-[#b2b2b2]\" data-kid=\"1-1-6-2-3-2\" data-name=\"chevron right arrow holder\">\n                        <i class=\"icon-chevron-right\" data-kid=\"1-1-6-2-3-2-1\" data-name=\"chevron right icon\">\n                        </i>\n                    </span>\n                </div>\n            </div>\n            <button class=\"mt-2 h-11 w-full rounded-md border border-[#c7c7c7] bg-white text-[15px] font-medium\" data-kid=\"1-1-6-3\" data-name=\"log out button\">\n                Log out\n            </button>\n        </section>\n    </main>\n    <!-- Bottom tab bar -->\n    <nav class=\"border-t border-[#dfdfdf] bg-white\" data-kid=\"1-2\" data-name=\"bottom tab navigation bar\">\n        <div class=\"grid grid-cols-4 px-2 pb-4 pt-2.5\" data-kid=\"1-2-1\" data-name=\"tab grid container\">\n            <div class=\"flex flex-col items-center gap-1 text-[#707070]\" data-kid=\"1-2-1-1\" data-name=\"home tab item\">\n                <span class=\"text-[22px]\" data-kid=\"1-2-1-1-1\" data-name=\"home icon holder\">\n                    <i class=\"icon-house\" data-kid=\"1-2-1-1-1-1\" data-name=\"house icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium\" data-kid=\"1-2-1-1-2\" data-name=\"home tab label\">\n                    Home\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1 text-[#707070]\" data-kid=\"1-2-1-2\" data-name=\"matches tab item\">\n                <span class=\"text-[22px]\" data-kid=\"1-2-1-2-1\" data-name=\"matches icon holder\">\n                    <i class=\"icon-briefcase-business\" data-kid=\"1-2-1-2-1-1\" data-name=\"briefcase icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium\" data-kid=\"1-2-1-2-2\" data-name=\"matches tab label\">\n                    Matches\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1 text-[#707070]\" data-kid=\"1-2-1-3\" data-name=\"courses tab item\">\n                <span class=\"text-[22px]\" data-kid=\"1-2-1-3-1\" data-name=\"courses icon holder\">\n                    <i class=\"icon-book-open\" data-kid=\"1-2-1-3-1-1\" data-name=\"open book icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium\" data-kid=\"1-2-1-3-2\" data-name=\"courses tab label\">\n                    Courses\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-2-1-4\" data-name=\"profile tab item active\">\n                <span class=\"text-[22px] text-[#3ecf8e]\" data-kid=\"1-2-1-4-1\" data-name=\"profile icon holder\">\n                    <i class=\"icon-user-round\" data-kid=\"1-2-1-4-1-1\" data-name=\"user icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-1-4-2\" data-name=\"profile tab label active\">\n                    Profile\n                </span>\n            </div>\n        </div>\n    </nav>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T07:45:44.917579+00:00",
      "modified": "2026-10-11T07:45:58.775629+00:00",
      "id": "var_c913d821add3",
      "contentHeight": 1348
    },
    "var_e152906ff24b": {
      "type": "variant",
      "label": "M13 · Employer — Post a Job",
      "parentId": "null",
      "themeId": null,
      "rect": {
        "x": 8075,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"post job form page container\" style=\"font-family:'Inter',sans-serif;\">\n    <main class=\"flex-1 px-5 pb-8 pt-6\" data-kid=\"1-1\" data-name=\"main job posting form\">\n        <!-- Header -->\n        <h1 class=\"font-display text-[20px] font-bold leading-tight\" data-kid=\"1-1-1\" data-name=\"page title heading\">\n            Post a job\n        </h1>\n        <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-1-2\" data-name=\"submission status helper text\">\n            Live after a verifier approves it.\n        </p>\n        <div class=\"mt-6 flex flex-col gap-6\" data-kid=\"1-1-3\" data-name=\"form fields layout container\">\n            <!-- Job title -->\n            <div data-kid=\"1-1-3-1\" data-name=\"job title form field group\">\n                <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-1-1\" data-name=\"job title label\">\n                    Job title\n                    <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-1-1-1\" data-name=\"required field indicator asterisk\">\n                        *\n                    </span>\n                </label>\n                <input class=\"h-12 w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 text-[15px] font-medium outline-none\" data-kid=\"1-1-3-1-2\" data-name=\"job title text input\" value=\"AC Technician — Voltas Service Partner\"/>\n            </div>\n            <!-- Description -->\n            <div data-kid=\"1-1-3-2\" data-name=\"description form field group\">\n                <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-2-1\" data-name=\"description label\">\n                    Description\n                </label>\n                <textarea class=\"w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 py-3 text-[15px] leading-relaxed outline-none\" data-kid=\"1-1-3-2-2\" data-name=\"job description textarea input\" rows=\"3\">Split-AC install, servicing and gas top-ups for residential customers.</textarea>\n            </div>\n            <!-- Required skills -->\n            <div data-kid=\"1-1-3-3\" data-name=\"required skills form field group\">\n                <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-3-1\" data-name=\"required skills label\">\n                    Required skills\n                    <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-3-1-1\" data-name=\"required field indicator asterisk\">\n                        *\n                    </span>\n                </label>\n                <div class=\"flex flex-wrap gap-2\" data-kid=\"1-1-3-3-2\" data-name=\"selected skill tags container\">\n                    <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[#dfdfdf] bg-[#fafafa] px-3 py-1.5 text-[13px] font-medium\" data-kid=\"1-1-3-3-2-1\" data-name=\"AC repair skill tag chip\">\n                        AC repair & servicing\n                        <span class=\"text-[13px] leading-none text-[#707070]\" data-kid=\"1-1-3-3-2-1-1\" data-name=\"skill tag remove icon wrapper\">\n                            <i class=\"icon-x\" data-kid=\"1-1-3-3-2-1-1-1\" data-name=\"close X icon\">\n                            </i>\n                        </span>\n                    </span>\n                    <span class=\"inline-flex items-center gap-1.5 rounded-full border border-[#dfdfdf] bg-[#fafafa] px-3 py-1.5 text-[13px] font-medium\" data-kid=\"1-1-3-3-2-2\" data-name=\"house wiring skill tag chip\">\n                        House wiring\n                        <span class=\"text-[13px] leading-none text-[#707070]\" data-kid=\"1-1-3-3-2-2-1\" data-name=\"skill tag remove icon wrapper\">\n                            <i class=\"icon-x\" data-kid=\"1-1-3-3-2-2-1-1\" data-name=\"close X icon\">\n                            </i>\n                        </span>\n                    </span>\n                </div>\n                <input class=\"mt-2 h-12 w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 text-[15px] outline-none placeholder:text-[#b2b2b2]\" data-kid=\"1-1-3-3-3\" data-name=\"add skill input field\" placeholder=\"e.g. Fan repair\"/>\n                <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-1-3-3-4\" data-name=\"skill suggestion helper text\">\n                    Suggestions come from the standard skills list.\n                </p>\n            </div>\n            <!-- Hard criteria -->\n            <div data-kid=\"1-1-3-4\" data-name=\"hard criteria form field group\">\n                <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-4-1\" data-name=\"hard criteria label\">\n                    Hard criteria\n                    <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-4-1-1\" data-name=\"required field indicator asterisk\">\n                        *\n                    </span>\n                </label>\n                <p class=\"mb-2.5 text-[12px] leading-snug text-[#707070]\" data-kid=\"1-1-3-4-2\" data-name=\"hard criteria explanation text\">\n                    At least one required. Seekers who fail are excluded — not just ranked lower.\n                </p>\n                <div class=\"flex flex-col gap-2\" data-kid=\"1-1-3-4-3\" data-name=\"hard criteria rows container\">\n                    <!-- Row 1: certificate -->\n                    <div class=\"flex items-stretch overflow-hidden rounded-lg border border-[#c7c7c7] bg-white\" data-kid=\"1-1-3-4-3-1\" data-name=\"certificate criterion row\">\n                        <button class=\"flex flex-none items-center gap-1.5 px-2.5 py-2.5 text-[12.5px] font-medium\" data-kid=\"1-1-3-4-3-1-1\" data-name=\"subject drop-down button\">\n                            Certificate\n                            <span class=\"text-[12px] leading-none text-[#707070]\" data-kid=\"1-1-3-4-3-1-1-1\" data-name=\"subject drop-down chevron icon wrapper\">\n                                <i class=\"icon-chevron-down\" data-kid=\"1-1-3-4-3-1-1-1-1\" data-name=\"chevron down icon\">\n                                </i>\n                            </span>\n                        </button>\n                        <div class=\"w-px bg-[#dfdfdf]\" data-kid=\"1-1-3-4-3-1-2\" data-name=\"criterion row divider\">\n                        </div>\n                        <button class=\"flex flex-none items-center gap-1.5 px-2.5 py-2.5 text-[12.5px] font-medium text-[#707070]\" data-kid=\"1-1-3-4-3-1-3\" data-name=\"operator drop-down button\">\n                            requires\n                            <span class=\"text-[12px] leading-none\" data-kid=\"1-1-3-4-3-1-3-1\" data-name=\"operator drop-down chevron icon wrapper\">\n                                <i class=\"icon-chevron-down\" data-kid=\"1-1-3-4-3-1-3-1-1\" data-name=\"chevron down icon\">\n                                </i>\n                            </span>\n                        </button>\n                        <div class=\"w-px bg-[#dfdfdf]\" data-kid=\"1-1-3-4-3-1-4\" data-name=\"criterion row divider\">\n                        </div>\n                        <div class=\"flex min-w-0 flex-1 items-center gap-2 px-2.5 py-2\" data-kid=\"1-1-3-4-3-1-5\" data-name=\"criterion value area\">\n                            <span class=\"text-[13px] font-medium leading-snug\" data-kid=\"1-1-3-4-3-1-5-1\" data-name=\"criterion subject value text\">\n                                AC Repair & Servicing\n                            </span>\n                            <span class=\"ml-auto shrink-0 text-[14px] leading-none text-[#707070]\" data-kid=\"1-1-3-4-3-1-5-2\" data-name=\"remove criterion icon wrapper\">\n                                <i class=\"icon-x\" data-kid=\"1-1-3-4-3-1-5-2-1\" data-name=\"close X icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                    <!-- Row 2: city -->\n                    <div class=\"flex items-stretch overflow-hidden rounded-lg border border-[#c7c7c7] bg-white\" data-kid=\"1-1-3-4-3-2\" data-name=\"city criterion row\">\n                        <button class=\"flex flex-none items-center gap-1.5 px-2.5 py-2.5 text-[12.5px] font-medium\" data-kid=\"1-1-3-4-3-2-1\" data-name=\"subject drop-down button\">\n                            City\n                            <span class=\"text-[12px] leading-none text-[#707070]\" data-kid=\"1-1-3-4-3-2-1-1\" data-name=\"subject drop-down chevron icon wrapper\">\n                                <i class=\"icon-chevron-down\" data-kid=\"1-1-3-4-3-2-1-1-1\" data-name=\"chevron down icon\">\n                                </i>\n                            </span>\n                        </button>\n                        <div class=\"w-px bg-[#dfdfdf]\" data-kid=\"1-1-3-4-3-2-2\" data-name=\"criterion row divider\">\n                        </div>\n                        <button class=\"flex flex-none items-center gap-1.5 px-2.5 py-2.5 text-[12.5px] font-medium text-[#707070]\" data-kid=\"1-1-3-4-3-2-3\" data-name=\"operator drop-down button\">\n                            equals\n                            <span class=\"text-[12px] leading-none\" data-kid=\"1-1-3-4-3-2-3-1\" data-name=\"operator drop-down chevron icon wrapper\">\n                                <i class=\"icon-chevron-down\" data-kid=\"1-1-3-4-3-2-3-1-1\" data-name=\"chevron down icon\">\n                                </i>\n                            </span>\n                        </button>\n                        <div class=\"w-px bg-[#dfdfdf]\" data-kid=\"1-1-3-4-3-2-4\" data-name=\"criterion row divider\">\n                        </div>\n                        <div class=\"flex min-w-0 flex-1 items-center gap-2 px-2.5 py-2\" data-kid=\"1-1-3-4-3-2-5\" data-name=\"criterion value area\">\n                            <span class=\"text-[13px] font-medium leading-snug\" data-kid=\"1-1-3-4-3-2-5-1\" data-name=\"criterion value text\">\n                                Pune\n                            </span>\n                            <span class=\"ml-auto shrink-0 text-[14px] leading-none text-[#707070]\" data-kid=\"1-1-3-4-3-2-5-2\" data-name=\"remove criterion icon wrapper\">\n                                <i class=\"icon-x\" data-kid=\"1-1-3-4-3-2-5-2-1\" data-name=\"close X icon\">\n                                </i>\n                            </span>\n                        </div>\n                    </div>\n                    <!-- Add criterion -->\n                    <button class=\"flex items-center justify-center gap-1.5 rounded-lg border border-dashed border-[#c7c7c7] py-2.5 text-[13px] font-medium\" data-kid=\"1-1-3-4-3-3\" data-name=\"add criterion button\">\n                        <span class=\"text-[16px] leading-none\" data-kid=\"1-1-3-4-3-3-1\" data-name=\"add criterion plus icon wrapper\">\n                            <i class=\"icon-plus-circle\" data-kid=\"1-1-3-4-3-3-1-1\" data-name=\"plus in circle icon\">\n                            </i>\n                        </span>\n                        Add criterion\n                    </button>\n                </div>\n            </div>\n            <!-- City + Pay -->\n            <div class=\"grid grid-cols-[1fr_1.35fr] gap-3\" data-kid=\"1-1-3-5\" data-name=\"city and pay grid row\">\n                <div data-kid=\"1-1-3-5-1\" data-name=\"city form field group\">\n                    <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-5-1-1\" data-name=\"city label\">\n                        City\n                        <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-5-1-1-1\" data-name=\"required field indicator asterisk\">\n                            *\n                        </span>\n                    </label>\n                    <input class=\"h-12 w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 text-[15px] font-medium outline-none\" data-kid=\"1-1-3-5-1-2\" data-name=\"city text input\" value=\"Pune\"/>\n                </div>\n                <div data-kid=\"1-1-3-5-2\" data-name=\"pay form field group\">\n                    <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-5-2-1\" data-name=\"pay label\">\n                        Pay\n                        <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-5-2-1-1\" data-name=\"pay currency unit note\">\n                            (₹ / month)\n                        </span>\n                    </label>\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-5-2-2\" data-name=\"pay range input row\">\n                        <input class=\"h-12 w-full min-w-0 rounded-lg border border-[#c7c7c7] bg-white px-3 text-[15px] font-medium outline-none\" data-kid=\"1-1-3-5-2-2-1\" data-name=\"pay range minimum input\" value=\"24,000\"/>\n                        <span class=\"text-[13px] text-[#707070]\" data-kid=\"1-1-3-5-2-2-2\" data-name=\"range dash separator text\">\n                            –\n                        </span>\n                        <input class=\"h-12 w-full min-w-0 rounded-lg border border-[#c7c7c7] bg-white px-3 text-[15px] font-medium outline-none\" data-kid=\"1-1-3-5-2-2-3\" data-name=\"pay range maximum input\" value=\"28,000\"/>\n                    </div>\n                </div>\n            </div>\n            <!-- Work involved -->\n            <div data-kid=\"1-1-3-6\" data-name=\"work involved form field group\">\n                <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-6-1\" data-name=\"work involved label\">\n                    Work involved\n                </label>\n                <input class=\"h-12 w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 text-[15px] font-medium outline-none\" data-kid=\"1-1-3-6-2\" data-name=\"work involved text input\" value=\"Install, service, gas charging\"/>\n                <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-1-3-6-3\" data-name=\"work involved helper text\">\n                    Shown on the job card seekers see.\n                </p>\n            </div>\n            <!-- Submit -->\n            <div class=\"pt-1\" data-kid=\"1-1-3-7\" data-name=\"submit area container\">\n                <button class=\"h-12 w-full rounded-md bg-[#3ecf8e] font-display text-[16px] font-semibold text-[#171717]\" data-kid=\"1-1-3-7-1\" data-name=\"submit for verification button\">\n                    Send for verification\n                </button>\n                <p class=\"mt-3 text-center text-[12px] leading-snug text-[#9a9a9a]\" data-kid=\"1-1-3-7-2\" data-name=\"visibility disclaimer caption\">\n                    Your post is invisible to seekers until a verifier approves it.\n                </p>\n            </div>\n        </div>\n    </main>\n    <!-- Employer tab bar -->\n    <nav class=\"border-t border-[#dfdfdf] bg-white px-2 pb-5 pt-2\" data-kid=\"1-2\" data-name=\"employer bottom tab navigation bar\">\n        <div class=\"grid grid-cols-3\" data-kid=\"1-2-1\" data-name=\"tab navigation grid\">\n            <div class=\"flex flex-col items-center gap-1 py-1\" data-kid=\"1-2-1-1\" data-name=\"post job tab item\">\n                <span class=\"text-[22px] leading-none text-[#3ecf8e]\" data-kid=\"1-2-1-1-1\" data-name=\"post job tab icon wrapper\">\n                    <i class=\"icon-plus-circle\" data-kid=\"1-2-1-1-1-1\" data-name=\"plus in circle icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-1-1-2\" data-name=\"post job tab label text\">\n                    Post Job\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1 py-1\" data-kid=\"1-2-1-2\" data-name=\"my postings tab item\">\n                <span class=\"text-[22px] leading-none text-[#707070]\" data-kid=\"1-2-1-2-1\" data-name=\"my postings tab icon wrapper\">\n                    <i class=\"icon-list\" data-kid=\"1-2-1-2-1-1\" data-name=\"list icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-2-1-2-2\" data-name=\"my postings tab label text\">\n                    My Postings\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1 py-1\" data-kid=\"1-2-1-3\" data-name=\"profile tab item\">\n                <span class=\"text-[22px] leading-none text-[#707070]\" data-kid=\"1-2-1-3-1\" data-name=\"profile tab icon wrapper\">\n                    <i class=\"icon-user-round\" data-kid=\"1-2-1-3-1-1\" data-name=\"user profile icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-2-1-3-2\" data-name=\"profile tab label text\">\n                    Profile\n                </span>\n            </div>\n        </div>\n    </nav>\n</div>\n",
