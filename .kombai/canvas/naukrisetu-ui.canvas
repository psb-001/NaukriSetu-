      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\nhtml { background: #ffffff; }\nbody { background: #ffffff; margin: 0; }\n.font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif\">\n    <!-- Top navbar -->\n    <header class=\"w-full border-b border-[#dfdfdf] bg-white\" data-kid=\"1-1\" data-name=\"site top header bar\">\n        <div class=\"mx-auto flex h-16 max-w-[1200px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"header inner layout row\">\n            <span class=\"font-display text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"brand logo wordmark\">\n                Naukri\n                <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1-1\" data-name=\"brand accent text\">\n                    Setu\n                </span>\n            </span>\n            <nav class=\"flex h-16 items-center gap-8 text-[15px]\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n                <a class=\"flex h-full items-center border-b-2 border-transparent font-medium text-[#707070]\" data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\">\n                    Home\n                </a>\n                <a class=\"flex h-full items-center border-b-2 border-transparent font-medium text-[#707070]\" data-kid=\"1-1-1-2-2\" data-name=\"matches navigation link\">\n                    Matches\n                </a>\n                <a class=\"flex h-full items-center border-b-2 border-transparent font-medium text-[#707070]\" data-kid=\"1-1-1-2-3\" data-name=\"courses navigation link\">\n                    Courses\n                </a>\n                <a class=\"flex h-full items-center border-b-2 border-[#171717] font-semibold text-[#171717]\" data-kid=\"1-1-1-2-4\" data-name=\"profile navigation link\">\n                    Profile\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-3\" data-name=\"account identity group\">\n                <span class=\"flex h-8 w-8 items-center justify-center rounded-full bg-[#fafafa] text-[16px] text-[#707070]\" data-kid=\"1-1-1-3-1\" data-name=\"user avatar circle\">\n                    <i class=\"icon-user-round\" data-kid=\"1-1-1-3-1-1\" data-name=\"user profile icon\">\n                    </i>\n                </span>\n                <span class=\"text-[13px] font-medium\" data-kid=\"1-1-1-3-2\" data-name=\"account owner name label\">\n                    Ravi Kadam\n                </span>\n            </div>\n        </div>\n    </header>\n    <!-- Main -->\n    <main class=\"mx-auto w-full max-w-[1200px] flex-1 px-8 pb-16 pt-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Page header row -->\n        <div class=\"flex items-start justify-between gap-8\" data-kid=\"1-2-1\" data-name=\"page header row\">\n            <div data-kid=\"1-2-1-1\" data-name=\"page title heading block\">\n                <h1 class=\"font-display text-[24px] font-bold leading-tight\" data-kid=\"1-2-1-1-1\" data-name=\"page title heading\">\n                    Profile\n                </h1>\n                <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-2-1-1-2\" data-name=\"page subtitle with contact info\">\n                    Ravi Kadam · ravi.kadam@gmail.com · Pune\n                </p>\n            </div>\n            <div class=\"flex max-w-[460px] shrink-0 items-center gap-2.5 rounded-lg bg-[#fff8d6] px-4 py-2.5\" data-kid=\"1-2-1-2\" data-name=\"verification pending notice banner\">\n                <span class=\"h-2 w-2 shrink-0 rounded-full bg-[#ffdb13]\" data-kid=\"1-2-1-2-1\" data-name=\"notice status dot\">\n                </span>\n                <p class=\"text-[13px] leading-snug text-[#171717]\" data-kid=\"1-2-1-2-2\" data-name=\"verification pending message text\">\n                    Verification pending — you can browse, some jobs stay locked.\n                </p>\n            </div>\n        </div>\n        <!-- Two columns -->\n        <div class=\"mt-10 grid grid-cols-[1.65fr_1fr] items-start gap-10\" data-kid=\"1-2-2\" data-name=\"two column content layout\">\n            <!-- LEFT: KYC stepper -->\n            <section class=\"relative\" data-kid=\"1-2-2-1\" data-name=\"KYC stepper section\">\n                <div aria-hidden=\"true\" class=\"absolute bottom-6 left-[19px] top-6 w-px bg-[#dfdfdf]\" data-kid=\"1-2-2-1-1\" data-name=\"stepper vertical connector line\">\n                </div>\n                <!-- Step 1 — done -->\n                <div class=\"relative flex gap-5\" data-kid=\"1-2-2-1-2\" data-name=\"step 1 complete step row\">\n                    <span class=\"z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#3ecf8e] text-[18px] text-white\" data-kid=\"1-2-2-1-2-1\" data-name=\"step 1 completed indicator circle\">\n                        <i class=\"icon-check\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"checkmark icon\">\n                        </i>\n                    </span>\n                    <div class=\"min-w-0 flex-1 pb-9\" data-kid=\"1-2-2-1-2-2\" data-name=\"step 1 detail content\">\n                        <div class=\"flex items-center gap-3\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"step 1 title with status row\">\n                            <h2 class=\"font-display text-[16px] font-semibold\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"step 1 title text\">\n                                Aadhaar\n                            </h2>\n                            <span class=\"inline-flex items-center gap-1.5 rounded-full bg-[#fff8d6] px-2.5 py-1 text-[11px] font-medium text-[#171717]\" data-kid=\"1-2-2-1-2-2-1-2\" data-name=\"pending status badge\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#ffdb13]\" data-kid=\"1-2-2-1-2-2-1-2-1\" data-name=\"badge status dot\">\n                                </span>\n                                Pending\n                            </span>\n                        </div>\n                        <div class=\"mt-3 flex items-center gap-3.5\" data-kid=\"1-2-2-1-2-2-2\" data-name=\"uploaded document row\">\n                            <span class=\"flex h-14 w-14 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[20px] text-[#707070]\" data-kid=\"1-2-2-1-2-2-2-1\" data-name=\"document file icon tile\">\n                                <i class=\"icon-file\" data-kid=\"1-2-2-1-2-2-2-1-1\" data-name=\"document file icon\">\n                                </i>\n                            </span>\n                            <p class=\"text-[13px] text-[#707070]\" data-kid=\"1-2-2-1-2-2-2-2\" data-name=\"document upload status text\">\n                                Uploaded · awaiting check\n                            </p>\n                        </div>\n                        <p class=\"mt-3 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-2-2-3\" data-name=\"step 1 helper note text\">\n                            12-digit format check only — demo does not contact UIDAI.\n                        </p>\n                    </div>\n                </div>\n                <!-- Step 2 — current -->\n                <div class=\"relative flex gap-5\" data-kid=\"1-2-2-1-3\" data-name=\"step 2 current step row\">\n                    <span class=\"z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 border-[#3ecf8e] bg-white font-display text-[14px] font-bold\" data-kid=\"1-2-2-1-3-1\" data-name=\"step 2 active indicator circle\">\n                        2\n                    </span>\n                    <div class=\"min-w-0 flex-1 pb-9\" data-kid=\"1-2-2-1-3-2\" data-name=\"step 2 detail content\">\n                        <h2 class=\"font-display text-[16px] font-semibold\" data-kid=\"1-2-2-1-3-2-1\" data-name=\"step 2 title text\">\n                            Address\n                        </h2>\n                        <div class=\"mt-4 max-w-[520px]\" data-kid=\"1-2-2-1-3-2-2\" data-name=\"address form group\">\n                            <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-3-2-2-1\" data-name=\"full address field label\">\n                                Full address\n                            </label>\n                            <div class=\"rounded-lg border border-[#c7c7c7] px-3.5 py-3 text-[14px] leading-snug\" data-kid=\"1-2-2-1-3-2-2-2\" data-name=\"full address value display\">\n                                Flat 4, Sai Residency, Kothrud\n                            </div>\n                            <label class=\"mb-1.5 mt-4 block text-[13px] font-semibold\" data-kid=\"1-2-2-1-3-2-2-3\" data-name=\"city field label\">\n                                City\n                            </label>\n                            <div class=\"flex h-11 items-center justify-between rounded-lg border border-[#c7c7c7] px-3.5\" data-kid=\"1-2-2-1-3-2-2-4\" data-name=\"city select field\">\n                                <span class=\"text-[14px]\" data-kid=\"1-2-2-1-3-2-2-4-1\" data-name=\"city selected value text\">\n                                    Pune\n                                </span>\n                                <span class=\"text-[16px] text-[#707070]\" data-kid=\"1-2-2-1-3-2-2-4-2\" data-name=\"select chevron icon wrapper\">\n                                    <i class=\"icon-chevron-down\" data-kid=\"1-2-2-1-3-2-2-4-2-1\" data-name=\"chevron down icon\">\n                                    </i>\n                                </span>\n                            </div>\n                            <p class=\"mt-2 flex items-center gap-1.5 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-3-2-2-5\" data-name=\"city change note text\">\n                                <span class=\"text-[14px]\" data-kid=\"1-2-2-1-3-2-2-5-1\" data-name=\"map pin icon wrapper\">\n                                    <i class=\"icon-map-pin\" data-kid=\"1-2-2-1-3-2-2-5-1-1\" data-name=\"map pin icon\">\n                                    </i>\n                                </span>\n                                Changing city re-runs your matches instantly.\n                            </p>\n                            <div class=\"mt-5 flex items-center justify-center gap-2.5 rounded-lg border border-dashed border-[#c7c7c7] py-4\" data-kid=\"1-2-2-1-3-2-2-6\" data-name=\"photo upload drop zone\">\n                                <span class=\"text-[18px] text-[#707070]\" data-kid=\"1-2-2-1-3-2-2-6-1\" data-name=\"camera icon wrapper\">\n                                    <i class=\"icon-camera\" data-kid=\"1-2-2-1-3-2-2-6-1-1\" data-name=\"camera icon\">\n                                    </i>\n                                </span>\n                                <p class=\"text-[13px] text-[#171717]\" data-kid=\"1-2-2-1-3-2-2-6-2\" data-name=\"upload prompt text\">\n                                    Take photo or upload address proof\n                                </p>\n                            </div>\n                            <p class=\"mt-2 text-[11px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-3-2-2-7\" data-name=\"photo storage helper note\">\n                                Photos via file input — stored as object URLs for the session.\n                            </p>\n                            <button class=\"mt-5 h-10 rounded-md border border-[#c7c7c7] px-5 text-[14px] font-medium text-[#171717]\" data-kid=\"1-2-2-1-3-2-2-8\" data-name=\"save address button\">\n                                Save address\n                            </button>\n                        </div>\n                    </div>\n                </div>\n                <!-- Step 3 — upcoming -->\n                <div class=\"relative flex gap-5\" data-kid=\"1-2-2-1-4\" data-name=\"step 3 upcoming step row\">\n                    <span class=\"z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#dfdfdf] bg-[#fafafa] font-display text-[14px] font-bold text-[#707070]\" data-kid=\"1-2-2-1-4-1\" data-name=\"step 3 inactive indicator circle\">\n                        3\n                    </span>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-2-2-1-4-2\" data-name=\"step 3 detail content\">\n                        <h2 class=\"font-display text-[16px] font-semibold\" data-kid=\"1-2-2-1-4-2-1\" data-name=\"step 3 title text\">\n                            Certificates\n                        </h2>\n                        <div class=\"mt-3 flex flex-wrap items-center gap-x-3 gap-y-2\" data-kid=\"1-2-2-1-4-2-2\" data-name=\"existing certificate row\">\n                            <p class=\"text-[14px] font-medium\" data-kid=\"1-2-2-1-4-2-2-1\" data-name=\"certificate name text\">\n                                ITI Electrician Certificate\n                            </p>\n                            <p class=\"text-[12px] text-[#707070]\" data-kid=\"1-2-2-1-4-2-2-2\" data-name=\"certificate issuer and expiry text\">\n                                NCVT · expires 2028\n                            </p>\n                            <span class=\"inline-flex items-center gap-1.5 rounded-full bg-[#fff8d6] px-2.5 py-1 text-[11px] font-medium text-[#171717]\" data-kid=\"1-2-2-1-4-2-2-3\" data-name=\"certificate pending status badge\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#ffdb13]\" data-kid=\"1-2-2-1-4-2-2-3-1\" data-name=\"badge status dot\">\n                                </span>\n                                Pending\n                            </span>\n                        </div>\n                        <p class=\"mt-2 max-w-[520px] text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-2-1-4-2-3\" data-name=\"certificate name helper note\">\n                            Write the name exactly as on the certificate — it is matched letter for letter.\n                        </p>\n                        <a class=\"mt-3 inline-flex items-center gap-1.5 text-[13px] font-medium text-[#171717] underline underline-offset-2\" data-kid=\"1-2-2-1-4-2-4\" data-name=\"add certificate link\">\n                            <span class=\"text-[16px]\" data-kid=\"1-2-2-1-4-2-4-1\" data-name=\"plus circle icon wrapper\">\n                                <i class=\"icon-plus-circle\" data-kid=\"1-2-2-1-4-2-4-1-1\" data-name=\"plus circle icon\">\n                                </i>\n                            </span>\n                            Add certificate\n                        </a>\n                    </div>\n                </div>\n            </section>\n            <!-- RIGHT rail -->\n            <aside class=\"flex flex-col\" data-kid=\"1-2-2-2\" data-name=\"right sidebar rail\">\n                <!-- Progress card -->\n                <div class=\"rounded-xl border border-[#dfdfdf] p-6\" data-kid=\"1-2-2-2-1\" data-name=\"profile progress card\">\n                    <h3 class=\"font-display text-[16px] font-semibold\" data-kid=\"1-2-2-2-1-1\" data-name=\"progress card heading\">\n                        Profile 40% complete\n                    </h3>\n                    <div class=\"mt-4 h-2 overflow-hidden rounded-full bg-[#ebebeb]\" data-kid=\"1-2-2-2-1-2\" data-name=\"progress bar track\">\n                        <div class=\"h-full w-[40%] rounded-full bg-[#3ecf8e]\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"progress bar fill\">\n                        </div>\n                    </div>\n                    <p class=\"mt-2 text-[12px] text-[#707070]\" data-kid=\"1-2-2-2-1-3\" data-name=\"progress count text\">\n                        2 of 5 checks done\n                    </p>\n                    <p class=\"mt-4 text-[13px] text-[#171717]\" data-kid=\"1-2-2-2-1-4\" data-name=\"unlock jobs description text\">\n                        Completing KYC unlocks 2 more jobs\n                    </p>\n                    <p class=\"mt-4 text-[11px] text-[#9a9a9a]\" data-kid=\"1-2-2-2-1-5\" data-name=\"preview label text\">\n                        After saving a step:\n                    </p>\n                    <div class=\"mt-1.5 flex items-center gap-2 rounded-lg bg-[#e7f8ef] px-3.5 py-3\" data-kid=\"1-2-2-2-1-6\" data-name=\"unlocked jobs success message\">\n                        <span class=\"text-[16px] text-[#3ecf8e]\" data-kid=\"1-2-2-2-1-6-1\" data-name=\"success check icon wrapper\">\n                            <i class=\"icon-circle-check\" data-kid=\"1-2-2-2-1-6-1-1\" data-name=\"circle check icon\">\n                            </i>\n                        </span>\n                        <p class=\"text-[13px] font-medium text-[#171717]\" data-kid=\"1-2-2-2-1-6-2\" data-name=\"unlocked jobs message text\">\n                            You unlocked 2 more jobs!\n                        </p>\n                    </div>\n                    <p class=\"mt-4 border-t border-[#dfdfdf] pt-3 text-[11px] text-[#9a9a9a]\" data-kid=\"1-2-2-2-1-7\" data-name=\"demo storage note text\">\n                        Documents stay on this device in the demo.\n                    </p>\n                </div>\n                <!-- Settings section -->\n                <div class=\"mt-8 border-t border-[#dfdfdf] pt-6\" data-kid=\"1-2-2-2-2\" data-name=\"settings section\">\n                    <h3 class=\"font-display text-[16px] font-semibold\" data-kid=\"1-2-2-2-2-1\" data-name=\"settings heading\">\n                        Settings\n                    </h3>\n                    <div class=\"mt-1 divide-y divide-[#dfdfdf]\" data-kid=\"1-2-2-2-2-2\" data-name=\"settings rows list\">\n                        <div class=\"flex items-center justify-between py-3.5\" data-kid=\"1-2-2-2-2-2-1\" data-name=\"app language setting row\">\n                            <p class=\"text-[14px]\" data-kid=\"1-2-2-2-2-2-1-1\" data-name=\"app language label\">\n                                App language\n                            </p>\n                            <div class=\"text-right\" data-kid=\"1-2-2-2-2-2-1-2\" data-name=\"language value block\">\n                                <p class=\"text-[13px] font-medium\" data-kid=\"1-2-2-2-2-2-1-2-1\" data-name=\"selected language text\">\n                                    English\n                                </p>\n                                <p class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"1-2-2-2-2-2-1-2-2\" data-name=\"language availability note\">\n                                    Hindi / Marathi coming\n                                </p>\n                            </div>\n                        </div>\n                        <div class=\"flex items-center justify-between py-3.5\" data-kid=\"1-2-2-2-2-2-2\" data-name=\"about setting row\">\n                            <p class=\"text-[14px]\" data-kid=\"1-2-2-2-2-2-2-1\" data-name=\"about label\">\n                                About\n                            </p>\n                            <p class=\"text-[12px] text-[#707070]\" data-kid=\"1-2-2-2-2-2-2-2\" data-name=\"app version text\">\n                                NaukriSetu v0.1.0 (demo)\n                            </p>\n                        </div>\n                        <div class=\"flex items-center justify-between py-3.5\" data-kid=\"1-2-2-2-2-2-3\" data-name=\"reset demo setting row\">\n                            <p class=\"text-[14px] text-[#ff2201]\" data-kid=\"1-2-2-2-2-2-3-1\" data-name=\"reset demo label\">\n                                Demo reset\n                            </p>\n                            <p class=\"text-[11px] text-[#9a9a9a]\" data-kid=\"1-2-2-2-2-2-3-2\" data-name=\"reset demo description\">\n                                Clears all local data\n                            </p>\n                        </div>\n                    </div>\n                    <button class=\"mt-3 h-10 w-full rounded-md border border-[#c7c7c7] text-[14px] font-medium text-[#171717]\" data-kid=\"1-2-2-2-2-3\" data-name=\"log out button\">\n                        Log out\n                    </button>\n                    <p class=\"mt-2 text-[11px] text-[#9a9a9a]\" data-kid=\"1-2-2-2-2-4\" data-name=\"log out helper note\">\n                        Returns to Login and clears the session.\n                    </p>\n                </div>\n            </aside>\n        </div>\n    </main>\n</div>\n",
