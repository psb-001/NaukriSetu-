    "var_c8eab25b227c": {
      "type": "variant",
      "label": "M02 · Login",
      "parentId": "null",
      "themeId": null,
      "rect": {
        "x": 950,
        "y": 0,
        "w": 375,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white px-6 pt-9 pb-5 text-[#171717]\" data-kid=\"1\" data-name=\"login page root container\" style=\"font-family:'Inter',system-ui,sans-serif;\">\n    <!-- Wordmark -->\n    <div class=\"text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1\" data-name=\"brand wordmark\" style=\"font-family:'Plus Jakarta Sans',sans-serif;\">\n        Naukri\n        <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1\" data-name=\"brand wordmark suffix\">\n            Setu\n        </span>\n    </div>\n    <!-- Heading -->\n    <div class=\"mt-9\" data-kid=\"1-2\" data-name=\"heading section\">\n        <h1 class=\"text-[22px] font-bold leading-[1.2]\" data-kid=\"1-2-1\" data-name=\"page main headline\" style=\"font-family:'Plus Jakarta Sans',sans-serif;\">\n            Log in to find work near you\n        </h1>\n        <p class=\"mt-2 text-[14px] leading-snug text-[#707070]\" data-kid=\"1-2-2\" data-name=\"page supporting subtitle\">\n            Your profile and matches stay in one place.\n        </p>\n    </div>\n    <!-- Google button -->\n    <div class=\"mt-7 flex h-12 w-full items-center justify-center gap-3 rounded-[6px] border border-[#c7c7c7] bg-white text-[16px] font-medium\" data-kid=\"1-3\" data-name=\"Google sign-in button\">\n        <svg aria-hidden=\"true\" data-kid=\"1-3-1\" data-name=\"Google four-colored logo icon\" height=\"20\" viewbox=\"0 0 18 18\" width=\"20\" xmlns=\"http://www.w3.org/2000/svg\">\n            <path d=\"M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844a4.14 4.14 0 0 1-1.796 2.716v2.259h2.908c1.702-1.567 2.684-3.875 2.684-6.615z\" fill=\"#4285F4\">\n            </path>\n            <path d=\"M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332A8.997 8.997 0 0 0 9 18z\" fill=\"#34A853\">\n            </path>\n            <path d=\"M3.964 10.71A5.41 5.41 0 0 1 3.682 9c0-.593.102-1.17.282-1.71V4.958H.957A8.996 8.996 0 0 0 0 9c0 1.452.348 2.827.957 4.042l3.007-2.332z\" fill=\"#FBBC05\">\n            </path>\n            <path d=\"M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0A8.997 8.997 0 0 0 .957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z\" fill=\"#EA4335\">\n            </path>\n        </svg>\n        <span data-kid=\"1-3-2\" data-name=\"Google sign-in button label\">\n            Continue with Google\n        </span>\n    </div>\n    <!-- Demo hint -->\n    <div class=\"mt-3 flex items-start gap-2 rounded-[8px] bg-[#fafafa] px-3.5 py-3 text-[13px] leading-snug text-[#707070]\" data-kid=\"1-4\" data-name=\"informational hint banner\">\n        <i class=\"icon-info mt-[1px] shrink-0 text-[14px]\" data-kid=\"1-4-1\" data-name=\"info icon\">\n        </i>\n        <span data-kid=\"1-4-2\" data-name=\"informational hint text\">\n            Hackathon demo — any Gmail works, OTP is\n            <span class=\"font-semibold text-[#171717]\" data-kid=\"1-4-2-1\" data-name=\"otp value highlight text\">\n                1234\n            </span>\n        </span>\n    </div>\n    <!-- Email field -->\n    <div class=\"mt-7\" data-kid=\"1-5\" data-name=\"email field section\">\n        <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-5-1\" data-name=\"email field label\">\n            Gmail address\n        </label>\n        <div class=\"flex h-12 w-full items-center rounded-[8px] border border-[#dfdfdf] bg-white px-3.5 text-[15px]\" data-kid=\"1-5-2\" data-name=\"email input field\">\n            ravi.kadam@gmail.com\n        </div>\n        <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-5-3\" data-name=\"email field helper text\">\n            Must end in @gmail.com\n        </p>\n    </div>\n    <!-- Continue — the single filled emerald action -->\n    <div class=\"mt-5 flex h-12 w-full items-center justify-center rounded-[6px] bg-[#3ecf8e] text-[16px] font-semibold\" data-kid=\"1-6\" data-name=\"continue submit button\" style=\"font-family:'Plus Jakarta Sans',sans-serif;\">\n        Continue\n    </div>\n    <!-- Divider -->\n    <div class=\"mt-8 flex items-center gap-3\" data-kid=\"1-7\" data-name=\"separator divider section\">\n        <span class=\"h-px flex-1 bg-[#dfdfdf]\" data-kid=\"1-7-1\" data-name=\"separator line left\">\n        </span>\n        <span class=\"text-[12px] text-[#9a9a9a]\" data-kid=\"1-7-2\" data-name=\"separator label text\">\n            or continue as\n        </span>\n        <span class=\"h-px flex-1 bg-[#dfdfdf]\" data-kid=\"1-7-3\" data-name=\"separator line right\">\n        </span>\n    </div>\n    <!-- Employer entry -->\n    <div class=\"mt-5 flex w-full items-center gap-3 rounded-[12px] border border-[#c7c7c7] bg-white px-4 py-3.5\" data-kid=\"1-8\" data-name=\"employer entry card\">\n        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-[8px] bg-[#fafafa] text-[16px] text-[#171717]\" data-kid=\"1-8-1\" data-name=\"employer icon container\">\n            <i class=\"icon-briefcase-business\" data-kid=\"1-8-1-1\" data-name=\"briefcase icon\">\n            </i>\n        </span>\n        <span class=\"min-w-0\" data-kid=\"1-8-2\" data-name=\"employer entry text block\">\n            <span class=\"block text-[15px] font-semibold\" data-kid=\"1-8-2-1\" data-name=\"employer entry title\" style=\"font-family:'Plus Jakarta Sans',sans-serif;\">\n                Continue as Employer\n            </span>\n            <span class=\"mt-0.5 block text-[12px] text-[#707070]\" data-kid=\"1-8-2-2\" data-name=\"employer entry subtitle\">\n                Post jobs and see who qualifies\n            </span>\n        </span>\n    </div>\n    <!-- Verifier entry -->\n    <div class=\"mt-3 flex w-full items-center gap-3 rounded-[12px] border border-[#c7c7c7] bg-white px-4 py-3.5\" data-kid=\"1-9\" data-name=\"verifier entry card\">\n        <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-[8px] bg-[#fafafa] text-[16px] text-[#171717]\" data-kid=\"1-9-1\" data-name=\"verifier icon container\">\n            <i class=\"icon-shield-check\" data-kid=\"1-9-1-1\" data-name=\"shield-check icon\">\n            </i>\n        </span>\n        <span class=\"min-w-0\" data-kid=\"1-9-2\" data-name=\"verifier entry text block\">\n            <span class=\"block text-[15px] font-semibold\" data-kid=\"1-9-2-1\" data-name=\"verifier entry title\" style=\"font-family:'Plus Jakarta Sans',sans-serif;\">\n                Continue as Verifier\n            </span>\n            <span class=\"mt-0.5 block text-[12px] text-[#707070]\" data-kid=\"1-9-2-2\" data-name=\"verifier entry subtitle\">\n                Approve documents and job posts\n            </span>\n        </span>\n    </div>\n    <!-- Microcopy -->\n    <p class=\"mt-auto pt-9 text-center text-[11px] text-[#b2b2b2]\" data-kid=\"1-10\" data-name=\"footer microcopy text\">\n        Demo runs on this device only.\n    </p>\n</div>\n",
