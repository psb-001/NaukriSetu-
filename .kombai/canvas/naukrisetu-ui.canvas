    "var_3adbd0d38335": {
      "type": "variant",
      "label": "W01 · Login",
      "parentId": "null",
      "themeId": null,
      "rect": {
        "x": 14070,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  html { background: #ffffff; }\n  body { background: #ffffff; margin: 0; }\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col items-center justify-center bg-white px-6 py-12 text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif\">\n    <section class=\"w-full max-w-[420px] rounded-xl border border-[#dfdfdf] bg-white p-8\" data-kid=\"1-1\" data-name=\"login card panel with border\" style=\"box-shadow:0 1px 3px rgba(0,0,0,.06)\">\n        <h1 class=\"text-center font-display text-[22px] font-extrabold leading-none\" data-kid=\"1-1-1\" data-name=\"brand logo title\">\n            Naukri\n            <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1\" data-name=\"brand secondary wordmark in green\">\n                Setu\n            </span>\n        </h1>\n        <p class=\"mt-5 text-center font-display text-[24px] font-bold leading-[1.25]\" data-kid=\"1-1-2\" data-name=\"login headline text\">\n            Log in to find work near you\n        </p>\n        <p class=\"mt-1.5 text-center text-[14px] leading-snug text-[#707070]\" data-kid=\"1-1-3\" data-name=\"login subheadline text\">\n            Your profile and matches stay in one place.\n        </p>\n        <button class=\"mt-7 flex h-11 w-full items-center justify-center gap-3 rounded-md border border-[#c7c7c7] bg-white text-[15px] font-medium\" data-kid=\"1-1-4\" data-name=\"continue with Google button\">\n            <svg aria-hidden=\"true\" data-kid=\"1-1-4-1\" data-name=\"Google logo icon\" height=\"20\" viewbox=\"0 0 48 48\" width=\"20\">\n                <path d=\"M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z\" fill=\"#EA4335\">\n                </path>\n                <path d=\"M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z\" fill=\"#4285F4\">\n                </path>\n                <path d=\"M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z\" fill=\"#FBBC05\">\n                </path>\n                <path d=\"M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z\" fill=\"#34A853\">\n                </path>\n            </svg>\n            Continue with Google\n        </button>\n        <div class=\"mt-3 flex items-center justify-center gap-2 rounded-lg bg-[#fafafa] px-3 py-2.5 text-[13px] leading-snug text-[#707070]\" data-kid=\"1-1-5\" data-name=\"info notice banner with demo hint\">\n            <span class=\"text-[14px] leading-none\" data-kid=\"1-1-5-1\" data-name=\"info icon container\">\n                <i class=\"icon-info\" data-kid=\"1-1-5-1-1\" data-name=\"info icon\">\n                </i>\n            </span>\n            <span data-kid=\"1-1-5-2\" data-name=\"demo notice text\">\n                Hackathon demo — any Gmail works, OTP is 1234\n            </span>\n        </div>\n        <div class=\"mt-5\" data-kid=\"1-1-6\" data-name=\"email login field group\">\n            <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-6-1\" data-name=\"email label\">\n                Gmail address\n            </label>\n            <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 text-[15px]\" data-kid=\"1-1-6-2\" data-name=\"email input field\" value=\"ravi.kadam@gmail.com\"/>\n            <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-1-6-3\" data-name=\"email validation hint text\">\n                Must end in @gmail.com\n            </p>\n        </div>\n        <button class=\"mt-5 h-11 w-full rounded-md bg-[#3ecf8e] font-display text-[15px] font-semibold\" data-kid=\"1-1-7\" data-name=\"primary continue button\">\n            Continue\n        </button>\n        <div class=\"mt-7 flex items-center gap-3\" data-kid=\"1-1-8\" data-name=\"divider row with or-continue-as label\">\n            <span class=\"h-px flex-1 bg-[#dfdfdf]\" data-kid=\"1-1-8-1\" data-name=\"left divider line\">\n            </span>\n            <span class=\"text-[12px] text-[#9a9a9a]\" data-kid=\"1-1-8-2\" data-name=\"or-continue-as label text\">\n                or continue as\n            </span>\n            <span class=\"h-px flex-1 bg-[#dfdfdf]\" data-kid=\"1-1-8-3\" data-name=\"right divider line\">\n            </span>\n        </div>\n        <div class=\"mt-4 flex flex-col gap-2.5\" data-kid=\"1-1-9\" data-name=\"alternative login options container\">\n            <button class=\"flex items-center gap-3 rounded-lg border border-[#c7c7c7] bg-white px-4 py-3 text-left\" data-kid=\"1-1-9-1\" data-name=\"continue as Employer option button\">\n                <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#fafafa] text-[18px]\" data-kid=\"1-1-9-1-1\" data-name=\"employer icon container\">\n                    <i class=\"icon-briefcase-business\" data-kid=\"1-1-9-1-1-1\" data-name=\"briefcase icon\">\n                    </i>\n                </span>\n                <span class=\"flex flex-col\" data-kid=\"1-1-9-1-2\" data-name=\"employer option text group\">\n                    <span class=\"text-[14px] font-semibold\" data-kid=\"1-1-9-1-2-1\" data-name=\"employer option title\">\n                        Continue as Employer\n                    </span>\n                    <span class=\"text-[12px] text-[#707070]\" data-kid=\"1-1-9-1-2-2\" data-name=\"employer option description\">\n                        Post jobs and see who qualifies\n                    </span>\n                </span>\n            </button>\n            <button class=\"flex items-center gap-3 rounded-lg border border-[#c7c7c7] bg-white px-4 py-3 text-left\" data-kid=\"1-1-9-2\" data-name=\"continue as Verifier option button\">\n                <span class=\"flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#fafafa] text-[18px]\" data-kid=\"1-1-9-2-1\" data-name=\"verifier icon container\">\n                    <i class=\"icon-shield-check\" data-kid=\"1-1-9-2-1-1\" data-name=\"shield check icon\">\n                    </i>\n                </span>\n                <span class=\"flex flex-col\" data-kid=\"1-1-9-2-2\" data-name=\"verifier option text group\">\n                    <span class=\"text-[14px] font-semibold\" data-kid=\"1-1-9-2-2-1\" data-name=\"verifier option title\">\n                        Continue as Verifier\n                    </span>\n                    <span class=\"text-[12px] text-[#707070]\" data-kid=\"1-1-9-2-2-2\" data-name=\"verifier option description\">\n                        Approve documents and job posts\n                    </span>\n                </span>\n            </button>\n        </div>\n    </section>\n    <p class=\"mt-6 text-center text-[12px] text-[#9a9a9a]\" data-kid=\"1-2\" data-name=\"footer demo note text\">\n        Demo runs on this device only.\n    </p>\n</div>\n",
