      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.font-display{font-family:'Plus Jakarta Sans',sans-serif;}\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"courses page container\" style=\"font-family:'Inter',sans-serif;\">\n    <!-- Header -->\n    <header class=\"px-5 pt-6\" data-kid=\"1-1\" data-name=\"page header block\">\n        <h1 class=\"font-display text-[20px] font-bold leading-[1.25]\" data-kid=\"1-1-1\" data-name=\"page title text\">\n            Courses\n        </h1>\n        <p class=\"mt-1 text-[13px] leading-[1.4] text-[#707070]\" data-kid=\"1-1-2\" data-name=\"page subtitle text\">\n            From the verified catalogue — never invented.\n        </p>\n    </header>\n    <!-- Search -->\n    <div class=\"px-5 pt-4\" data-kid=\"1-2\" data-name=\"search field wrapper\">\n        <div class=\"flex h-11 items-center gap-2.5 rounded-full border border-[#ebebeb] bg-[#fafafa] px-4\" data-kid=\"1-2-1\" data-name=\"search input pill\">\n            <span class=\"text-[18px] leading-none text-[#9a9a9a]\" data-kid=\"1-2-1-1\" data-name=\"search icon container\">\n                <i class=\"icon-search\" data-kid=\"1-2-1-1-1\" data-name=\"search magnifier icon\">\n                </i>\n            </span>\n            <span class=\"text-[14px] text-[#9a9a9a]\" data-kid=\"1-2-1-2\" data-name=\"search placeholder text\">\n                Search courses or skills — try “wiring”\n            </span>\n        </div>\n    </div>\n    <!-- Filter row -->\n    <div class=\"flex flex-wrap items-center gap-2 px-5 pt-3\" data-kid=\"1-3\" data-name=\"filter row container\">\n        <button class=\"flex h-9 items-center gap-1.5 rounded-full border border-[#c7c7c7] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-3-1\" data-name=\"trade filter dropdown button\">\n            Trade: All\n            <span class=\"text-[14px] leading-none text-[#707070]\" data-kid=\"1-3-1-1\" data-name=\"chevron indicator wrapper\">\n                <i class=\"icon-chevron-down\" data-kid=\"1-3-1-1-1\" data-name=\"down chevron icon\">\n                </i>\n            </span>\n        </button>\n        <button class=\"flex h-9 items-center rounded-full border border-[#c7c7c7] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-3-2\" data-name=\"short duration filter button\">\n            <4 wks\n        </button>\n        <button class=\"flex h-9 items-center rounded-full border border-[#c7c7c7] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-3-3\" data-name=\"mid duration filter button\">\n            4–8 wks\n        </button>\n        <button class=\"flex h-9 items-center rounded-full border border-[#c7c7c7] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-3-4\" data-name=\"long duration filter button\">\n            8+ wks\n        </button>\n        <span class=\"ml-auto pt-1 text-[12px] text-[#707070]\" data-kid=\"1-3-5\" data-name=\"sort order label\">\n            Sort: A–Z\n        </span>\n    </div>\n    <!-- Course list -->\n    <div class=\"flex flex-col gap-3 px-5 pt-4\" data-kid=\"1-4\" data-name=\"course list container\">\n        <article class=\"rounded-xl border border-[#dfdfdf] p-3.5\" data-kid=\"1-4-1\" data-name=\"course card\">\n            <span class=\"inline-block rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 font-display text-[11px] font-semibold leading-none\" data-kid=\"1-4-1-1\" data-name=\"course code badge\">\n                ELEC-101\n            </span>\n            <h2 class=\"font-display mt-2 text-[15px] font-semibold leading-snug\" data-kid=\"1-4-1-2\" data-name=\"course title text\">\n                House Wiring Fundamentals\n            </h2>\n            <p class=\"mt-1 flex items-center gap-1.5 text-[12px] text-[#707070]\" data-kid=\"1-4-1-3\" data-name=\"course provider and duration row\">\n                <span class=\"text-[14px] leading-none\" data-kid=\"1-4-1-3-1\" data-name=\"clock icon wrapper\">\n                    <i class=\"icon-clock\" data-kid=\"1-4-1-3-1-1\" data-name=\"clock icon\">\n                    </i>\n                </span>\n                NSDC / Skill India · 4 weeks\n            </p>\n            <div class=\"mt-3 flex items-center gap-4 border-t border-[#ebebeb] pt-3\" data-kid=\"1-4-1-4\" data-name=\"course actions row\">\n                <button class=\"flex items-center gap-1.5 text-[13px] font-medium\" data-kid=\"1-4-1-4-1\" data-name=\"save course button\">\n                    <span class=\"text-[16px] leading-none text-[#707070]\" data-kid=\"1-4-1-4-1-1\" data-name=\"heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-4-1-4-1-1-1\" data-name=\"heart icon\">\n                        </i>\n                    </span>\n                    Save\n                </button>\n                <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium\" data-kid=\"1-4-1-4-2\" data-name=\"notify me button\">\n                    <span class=\"text-[14px] leading-none text-[#707070]\" data-kid=\"1-4-1-4-2-1\" data-name=\"bell icon wrapper\">\n                        <i class=\"icon-bell\" data-kid=\"1-4-1-4-2-1-1\" data-name=\"bell icon\">\n                        </i>\n                    </span>\n                    Notify me\n                </button>\n            </div>\n        </article>\n        <article class=\"rounded-xl border border-[#dfdfdf] p-3.5\" data-kid=\"1-4-2\" data-name=\"course card\">\n            <span class=\"inline-block rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 font-display text-[11px] font-semibold leading-none\" data-kid=\"1-4-2-1\" data-name=\"course code badge\">\n                HVAC-201\n            </span>\n            <h2 class=\"font-display mt-2 text-[15px] font-semibold leading-snug\" data-kid=\"1-4-2-2\" data-name=\"course title text\">\n                AC Repair & Servicing\n            </h2>\n            <p class=\"mt-1 flex items-center gap-1.5 text-[12px] text-[#707070]\" data-kid=\"1-4-2-3\" data-name=\"course provider and duration row\">\n                <span class=\"text-[14px] leading-none\" data-kid=\"1-4-2-3-1\" data-name=\"clock icon wrapper\">\n                    <i class=\"icon-clock\" data-kid=\"1-4-2-3-1-1\" data-name=\"clock icon\">\n                    </i>\n                </span>\n                Voltas Academy · 8 weeks\n            </p>\n            <div class=\"mt-3 flex items-center gap-4 border-t border-[#ebebeb] pt-3\" data-kid=\"1-4-2-4\" data-name=\"course actions row\">\n                <button class=\"flex items-center gap-1.5 text-[13px] font-medium\" data-kid=\"1-4-2-4-1\" data-name=\"save course button\">\n                    <span class=\"text-[16px] leading-none text-[#707070]\" data-kid=\"1-4-2-4-1-1\" data-name=\"heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-4-2-4-1-1-1\" data-name=\"heart icon\">\n                        </i>\n                    </span>\n                    Save\n                </button>\n                <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium\" data-kid=\"1-4-2-4-2\" data-name=\"notify me button\">\n                    <span class=\"text-[14px] leading-none text-[#707070]\" data-kid=\"1-4-2-4-2-1\" data-name=\"bell icon wrapper\">\n                        <i class=\"icon-bell\" data-kid=\"1-4-2-4-2-1-1\" data-name=\"bell icon\">\n                        </i>\n                    </span>\n                    Notify me\n                </button>\n            </div>\n        </article>\n        <article class=\"rounded-xl border border-[#dfdfdf] p-3.5\" data-kid=\"1-4-3\" data-name=\"course card\">\n            <span class=\"inline-block rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 font-display text-[11px] font-semibold leading-none\" data-kid=\"1-4-3-1\" data-name=\"course code badge\">\n                ELEC-104\n            </span>\n            <h2 class=\"font-display mt-2 text-[15px] font-semibold leading-snug\" data-kid=\"1-4-3-2\" data-name=\"course title text\">\n                Fan Motor Repair\n            </h2>\n            <p class=\"mt-1 flex items-center gap-1.5 text-[12px] text-[#707070]\" data-kid=\"1-4-3-3\" data-name=\"course provider and duration row\">\n                <span class=\"text-[14px] leading-none\" data-kid=\"1-4-3-3-1\" data-name=\"clock icon wrapper\">\n                    <i class=\"icon-clock\" data-kid=\"1-4-3-3-1-1\" data-name=\"clock icon\">\n                    </i>\n                </span>\n                NSDC / Skill India · 3 weeks\n            </p>\n            <div class=\"mt-3 flex items-center gap-4 border-t border-[#ebebeb] pt-3\" data-kid=\"1-4-3-4\" data-name=\"course actions row\">\n                <button class=\"flex items-center gap-1.5 text-[13px] font-medium\" data-kid=\"1-4-3-4-1\" data-name=\"save course button\">\n                    <span class=\"text-[16px] leading-none text-[#707070]\" data-kid=\"1-4-3-4-1-1\" data-name=\"heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-4-3-4-1-1-1\" data-name=\"heart icon\">\n                        </i>\n                    </span>\n                    Save\n                </button>\n                <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium\" data-kid=\"1-4-3-4-2\" data-name=\"notify me button\">\n                    <span class=\"text-[14px] leading-none text-[#707070]\" data-kid=\"1-4-3-4-2-1\" data-name=\"bell icon wrapper\">\n                        <i class=\"icon-bell\" data-kid=\"1-4-3-4-2-1-1\" data-name=\"bell icon\">\n                        </i>\n                    </span>\n                    Notify me\n                </button>\n            </div>\n        </article>\n        <article class=\"rounded-xl border border-[#dfdfdf] p-3.5\" data-kid=\"1-4-4\" data-name=\"course card\">\n            <span class=\"inline-block rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 font-display text-[11px] font-semibold leading-none\" data-kid=\"1-4-4-1\" data-name=\"course code badge\">\n                PLMB-102\n            </span>\n            <h2 class=\"font-display mt-2 text-[15px] font-semibold leading-snug\" data-kid=\"1-4-4-2\" data-name=\"course title text\">\n                Basic Plumbing\n            </h2>\n            <p class=\"mt-1 flex items-center gap-1.5 text-[12px] text-[#707070]\" data-kid=\"1-4-4-3\" data-name=\"course provider and duration row\">\n                <span class=\"text-[14px] leading-none\" data-kid=\"1-4-4-3-1\" data-name=\"clock icon wrapper\">\n                    <i class=\"icon-clock\" data-kid=\"1-4-4-3-1-1\" data-name=\"clock icon\">\n                    </i>\n                </span>\n                ITI Pune · 6 weeks\n            </p>\n            <div class=\"mt-3 flex items-center gap-4 border-t border-[#ebebeb] pt-3\" data-kid=\"1-4-4-4\" data-name=\"course actions row\">\n                <button class=\"flex items-center gap-1.5 text-[13px] font-medium\" data-kid=\"1-4-4-4-1\" data-name=\"save course button\">\n                    <span class=\"text-[16px] leading-none text-[#707070]\" data-kid=\"1-4-4-4-1-1\" data-name=\"heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-4-4-4-1-1-1\" data-name=\"heart icon\">\n                        </i>\n                    </span>\n                    Save\n                </button>\n                <button class=\"flex h-8 items-center gap-1.5 rounded-full border border-[#c7c7c7] px-3 text-[12px] font-medium\" data-kid=\"1-4-4-4-2\" data-name=\"notify me button\">\n                    <span class=\"text-[14px] leading-none text-[#707070]\" data-kid=\"1-4-4-4-2-1\" data-name=\"bell icon wrapper\">\n                        <i class=\"icon-bell\" data-kid=\"1-4-4-4-2-1-1\" data-name=\"bell icon\">\n                        </i>\n                    </span>\n                    Notify me\n                </button>\n            </div>\n        </article>\n    </div>\n    <!-- Footnote -->\n    <p class=\"px-5 pb-4 pt-3 text-[11px] leading-[1.5] text-[#9a9a9a]\" data-kid=\"1-5\" data-name=\"footnote text\">\n        Skills taught are matched through the standard taxonomy — “wiring” finds ELEC-101.\n    </p>\n    <!-- Bottom tab bar -->\n    <nav class=\"mt-auto border-t border-[#dfdfdf] bg-white\" data-kid=\"1-6\" data-name=\"bottom navigation bar\">\n        <div class=\"flex items-stretch justify-around px-2 pb-5 pt-2.5\" data-kid=\"1-6-1\" data-name=\"nav items row\">\n            <div class=\"flex flex-col items-center gap-1 px-3\" data-kid=\"1-6-1-1\" data-name=\"home nav item\">\n                <span class=\"text-[20px] leading-none text-[#707070]\" data-kid=\"1-6-1-1-1\" data-name=\"home icon wrapper\">\n                    <i class=\"icon-house\" data-kid=\"1-6-1-1-1-1\" data-name=\"home icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-6-1-1-2\" data-name=\"home nav label\">\n                    Home\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1 px-3\" data-kid=\"1-6-1-2\" data-name=\"matches nav item\">\n                <span class=\"text-[20px] leading-none text-[#707070]\" data-kid=\"1-6-1-2-1\" data-name=\"briefcase icon wrapper\">\n                    <i class=\"icon-briefcase-business\" data-kid=\"1-6-1-2-1-1\" data-name=\"briefcase icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-6-1-2-2\" data-name=\"matches nav label\">\n                    Matches\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1 px-3\" data-kid=\"1-6-1-3\" data-name=\"courses nav item active\">\n                <span class=\"text-[20px] leading-none text-[#3ecf8e]\" data-kid=\"1-6-1-3-1\" data-name=\"book icon wrapper\">\n                    <i class=\"icon-book-open\" data-kid=\"1-6-1-3-1-1\" data-name=\"open book icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-semibold text-[#171717]\" data-kid=\"1-6-1-3-2\" data-name=\"courses nav label active\">\n                    Courses\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1 px-3\" data-kid=\"1-6-1-4\" data-name=\"profile nav item\">\n                <span class=\"text-[20px] leading-none text-[#707070]\" data-kid=\"1-6-1-4-1\" data-name=\"user icon wrapper\">\n                    <i class=\"icon-user-round\" data-kid=\"1-6-1-4-1-1\" data-name=\"user icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-6-1-4-2\" data-name=\"profile nav label\">\n                    Profile\n                </span>\n            </div>\n        </div>\n    </nav>\n</div>\n",
