      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n@layer components {\n  .no-scrollbar { scrollbar-width: none; }\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n}\n</style>\n<div class=\"min-h-screen bg-white font-['Inter',sans-serif] text-[#171717] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Greeting + search -->\n    <header class=\"px-5 pt-8\" data-kid=\"1-1\" data-name=\"greeting and search header\">\n        <h1 class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[22px] font-bold leading-tight\" data-kid=\"1-1-1\" data-name=\"greeting headline\">\n            Namaste, Ravi\n        </h1>\n        <p class=\"mt-1 text-[13px] text-[#707070]\" data-kid=\"1-1-2\" data-name=\"new matches subtitle\">\n            2 new matches since yesterday\n        </p>\n        <div class=\"mt-5 flex h-11 w-full items-center gap-2.5 rounded-full bg-[#fafafa] px-4\" data-kid=\"1-1-3\" data-name=\"search bar container\">\n            <span class=\"text-[18px] leading-none text-[#9a9a9a]\" data-kid=\"1-1-3-1\" data-name=\"search icon wrapper\">\n                <i class=\"icon-search\" data-kid=\"1-1-3-1-1\" data-name=\"search magnifier icon\">\n                </i>\n            </span>\n            <span class=\"text-[14px] text-[#9a9a9a]\" data-kid=\"1-1-3-2\" data-name=\"search placeholder text\">\n                Search jobs, skills, categories…\n            </span>\n        </div>\n    </header>\n    <!-- Trade chips -->\n    <nav aria-label=\"Trade categories\" class=\"no-scrollbar mt-4 flex gap-2 overflow-x-auto pb-1 pl-5\" data-kid=\"1-2\" data-name=\"trade categories filter navigation\">\n        <span class=\"flex h-9 shrink-0 items-center whitespace-nowrap rounded-full bg-[#171717] px-3.5 text-[13px] font-medium text-white\" data-kid=\"1-2-1\" data-name=\"active all categories filter chip\">\n            All\n        </span>\n        <span class=\"flex h-9 shrink-0 items-center whitespace-nowrap rounded-full border border-[#dfdfdf] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-2-2\" data-name=\"electrician trade filter chip\">\n            Electrician\n        </span>\n        <span class=\"flex h-9 shrink-0 items-center whitespace-nowrap rounded-full border border-[#dfdfdf] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-2-3\" data-name=\"plumber trade filter chip\">\n            Plumber\n        </span>\n        <span class=\"flex h-9 shrink-0 items-center whitespace-nowrap rounded-full border border-[#dfdfdf] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-2-4\" data-name=\"carpenter trade filter chip\">\n            Carpenter\n        </span>\n        <span class=\"flex h-9 shrink-0 items-center whitespace-nowrap rounded-full border border-[#dfdfdf] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-2-5\" data-name=\"painter trade filter chip\">\n            Painter\n        </span>\n        <span class=\"flex h-9 shrink-0 items-center whitespace-nowrap rounded-full border border-[#dfdfdf] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-2-6\" data-name=\"ac and refrigeration trade filter chip\">\n            AC & Refrigeration\n        </span>\n        <span class=\"flex h-9 shrink-0 items-center whitespace-nowrap rounded-full border border-[#dfdfdf] bg-white px-3.5 text-[13px] font-medium\" data-kid=\"1-2-7\" data-name=\"welder trade filter chip\">\n            Welder\n        </span>\n    </nav>\n    <!-- Banner card -->\n    <section class=\"px-5 pt-8\" data-kid=\"1-3\" data-name=\"new intake banner section\">\n        <div class=\"flex items-center gap-3 rounded-xl border border-[#dfdfdf] bg-[#fafafa] p-4\" data-kid=\"1-3-1\" data-name=\"banner card container\">\n            <div class=\"min-w-0 flex-1\" data-kid=\"1-3-1-1\" data-name=\"banner text content wrapper\">\n                <p class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-semibold leading-snug\" data-kid=\"1-3-1-1-1\" data-name=\"banner headline text\">\n                    New AC-repair intake\n                </p>\n                <p class=\"mt-1 text-[12px] leading-snug text-[#707070]\" data-kid=\"1-3-1-1-2\" data-name=\"banner description text\">\n                    Voltas service partners hiring in Pune this week\n                </p>\n                <span class=\"mt-2 inline-block text-[13px] font-medium underline underline-offset-[3px]\" data-kid=\"1-3-1-1-3\" data-name=\"view role call-to-action link\">\n                    See the role\n                </span>\n            </div>\n            <img alt=\"Split AC unit with a wrench — new repair intake\" class=\"h-[70px] w-[88px] shrink-0 object-contain\" data-kid=\"1-3-1-2\" data-name=\"ac unit banner illustration image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/.kombai/canvas/assets/banner-ac-intake.svg\"/>\n        </div>\n    </section>\n    <!-- Matches preview -->\n    <section class=\"px-5 pt-10\" data-kid=\"1-4\" data-name=\"job matches preview section\">\n        <div class=\"flex items-baseline justify-between gap-3\" data-kid=\"1-4-1\" data-name=\"matches header row\">\n            <p class=\"flex items-baseline gap-2\" data-kid=\"1-4-1-1\" data-name=\"matches count label group\">\n                <span class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[34px] font-extrabold leading-none\" data-kid=\"1-4-1-1-1\" data-name=\"matches count number\">\n                    5\n                </span>\n                <span class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[17px] font-semibold leading-tight\" data-kid=\"1-4-1-1-2\" data-name=\"matches count label text\">\n                    jobs you qualify for\n                </span>\n            </p>\n            <span class=\"shrink-0 text-[13px] font-medium underline underline-offset-[3px]\" data-kid=\"1-4-1-2\" data-name=\"see all matches link\">\n                See all\n            </span>\n        </div>\n        <div class=\"mt-3 divide-y divide-[#ebebeb]\" data-kid=\"1-4-2\" data-name=\"matches list container\">\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-1\" data-name=\"first matched job row\">\n                <span class=\"w-6 shrink-0 text-center font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-bold text-[#9a9a9a]\" data-kid=\"1-4-2-1-1\" data-name=\"job position number indicator\">\n                    1\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-1-2\" data-name=\"job title and details container\">\n                    <p class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-semibold leading-snug\" data-kid=\"1-4-2-1-2-1\" data-name=\"job title text\">\n                        AC Technician — Voltas Service Partner\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-4-2-1-2-2\" data-name=\"job pay and distance text\">\n                        ₹26,000/mo · 3.2 km\n                    </p>\n                </div>\n                <svg class=\"shrink-0\" data-kid=\"1-4-2-1-3\" data-name=\"job match score progress ring icon\" height=\"26\" viewbox=\"0 0 28 28\" width=\"26\">\n                    <circle cx=\"14\" cy=\"14\" fill=\"none\" r=\"10.5\" stroke=\"#ebebeb\" stroke-width=\"3.5\">\n                    </circle>\n                    <circle cx=\"14\" cy=\"14\" fill=\"none\" r=\"10.5\" stroke=\"#3ecf8e\" stroke-dasharray=\"60.7 65.97\" stroke-linecap=\"round\" stroke-width=\"3.5\" transform=\"rotate(-90 14 14)\">\n                    </circle>\n                    <text dominant-baseline=\"central\" fill=\"#171717\" font-family=\"Plus Jakarta Sans, sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"middle\" x=\"14\" y=\"14.5\">\n                        92\n                    </text>\n                </svg>\n                <span class=\"shrink-0 text-[16px] leading-none text-[#9a9a9a]\" data-kid=\"1-4-2-1-4\" data-name=\"navigation chevron icon wrapper\">\n                    <i class=\"icon-chevron-right\" data-kid=\"1-4-2-1-4-1\" data-name=\"right chevron arrow icon\">\n                    </i>\n                </span>\n            </div>\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-2\" data-name=\"second matched job row\">\n                <span class=\"w-6 shrink-0 text-center font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-bold text-[#9a9a9a]\" data-kid=\"1-4-2-2-1\" data-name=\"job position number indicator\">\n                    2\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-2-2\" data-name=\"job title and details container\">\n                    <p class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-semibold leading-snug\" data-kid=\"1-4-2-2-2-1\" data-name=\"job title text\">\n                        Fan Repair Technician — RBI Colony Society\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-4-2-2-2-2\" data-name=\"job pay and distance text\">\n                        ₹19,000/mo · 1.1 km\n                    </p>\n                </div>\n                <svg class=\"shrink-0\" data-kid=\"1-4-2-2-3\" data-name=\"job match score progress ring icon\" height=\"26\" viewbox=\"0 0 28 28\" width=\"26\">\n                    <circle cx=\"14\" cy=\"14\" fill=\"none\" r=\"10.5\" stroke=\"#ebebeb\" stroke-width=\"3.5\">\n                    </circle>\n                    <circle cx=\"14\" cy=\"14\" fill=\"none\" r=\"10.5\" stroke=\"#3ecf8e\" stroke-dasharray=\"58.05 65.97\" stroke-linecap=\"round\" stroke-width=\"3.5\" transform=\"rotate(-90 14 14)\">\n                    </circle>\n                    <text dominant-baseline=\"central\" fill=\"#171717\" font-family=\"Plus Jakarta Sans, sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"middle\" x=\"14\" y=\"14.5\">\n                        88\n                    </text>\n                </svg>\n                <span class=\"shrink-0 text-[16px] leading-none text-[#9a9a9a]\" data-kid=\"1-4-2-2-4\" data-name=\"navigation chevron icon wrapper\">\n                    <i class=\"icon-chevron-right\" data-kid=\"1-4-2-2-4-1\" data-name=\"right chevron arrow icon\">\n                    </i>\n                </span>\n            </div>\n            <div class=\"flex items-center gap-3 py-3.5\" data-kid=\"1-4-2-3\" data-name=\"third matched job row\">\n                <span class=\"w-6 shrink-0 text-center font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-bold text-[#9a9a9a]\" data-kid=\"1-4-2-3-1\" data-name=\"job position number indicator\">\n                    3\n                </span>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-4-2-3-2\" data-name=\"job title and details container\">\n                    <p class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-semibold leading-snug\" data-kid=\"1-4-2-3-2-1\" data-name=\"job title text\">\n                        Plumbing Helper — Rao Constructions\n                    </p>\n                    <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-4-2-3-2-2\" data-name=\"job pay and distance text\">\n                        ₹15,500/mo · 5.8 km\n                    </p>\n                </div>\n                <svg class=\"shrink-0\" data-kid=\"1-4-2-3-3\" data-name=\"job match score progress ring icon\" height=\"26\" viewbox=\"0 0 28 28\" width=\"26\">\n                    <circle cx=\"14\" cy=\"14\" fill=\"none\" r=\"10.5\" stroke=\"#ebebeb\" stroke-width=\"3.5\">\n                    </circle>\n                    <circle cx=\"14\" cy=\"14\" fill=\"none\" r=\"10.5\" stroke=\"#3ecf8e\" stroke-dasharray=\"48.82 65.97\" stroke-linecap=\"round\" stroke-width=\"3.5\" transform=\"rotate(-90 14 14)\">\n                    </circle>\n                    <text dominant-baseline=\"central\" fill=\"#171717\" font-family=\"Plus Jakarta Sans, sans-serif\" font-size=\"10.5\" font-weight=\"700\" text-anchor=\"middle\" x=\"14\" y=\"14.5\">\n                        74\n                    </text>\n                </svg>\n                <span class=\"shrink-0 text-[16px] leading-none text-[#9a9a9a]\" data-kid=\"1-4-2-3-4\" data-name=\"navigation chevron icon wrapper\">\n                    <i class=\"icon-chevron-right\" data-kid=\"1-4-2-3-4-1\" data-name=\"right chevron arrow icon\">\n                    </i>\n                </span>\n            </div>\n        </div>\n    </section>\n    <!-- Gap of the week -->\n    <section class=\"px-5 pt-10\" data-kid=\"1-5\" data-name=\"skill gap section\">\n        <div class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-5-1\" data-name=\"skill gap card container\">\n            <p class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-semibold leading-snug\" data-kid=\"1-5-1-1\" data-name=\"skill gap headline text\">\n                You're 1 skill away from AC Technician\n            </p>\n            <p class=\"mt-1 text-[12px] text-[#707070]\" data-kid=\"1-5-1-2\" data-name=\"missing skill description text\">\n                Missing: AC Repair & Servicing certificate\n            </p>\n            <span class=\"mt-2.5 inline-block text-[13px] font-medium underline underline-offset-[3px]\" data-kid=\"1-5-1-3\" data-name=\"qualification details call-to-action link\">\n                How to qualify\n            </span>\n        </div>\n    </section>\n    <!-- KYC progress -->\n    <section class=\"px-5 pt-10\" data-kid=\"1-6\" data-name=\"profile kyc progress section\">\n        <div class=\"rounded-xl border border-[#dfdfdf] p-4\" data-kid=\"1-6-1\" data-name=\"kyc progress card container\">\n            <p class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[15px] font-semibold\" data-kid=\"1-6-1-1\" data-name=\"profile completion headline text\">\n                Profile 40% complete\n            </p>\n            <div class=\"mt-2.5 h-2 w-full overflow-hidden rounded-full bg-[#ebebeb]\" data-kid=\"1-6-1-2\" data-name=\"progress bar track\">\n                <div class=\"h-full w-[40%] rounded-full bg-[#3ecf8e]\" data-kid=\"1-6-1-2-1\" data-name=\"progress bar fill\">\n                </div>\n            </div>\n            <p class=\"mt-2 text-[12px] text-[#707070]\" data-kid=\"1-6-1-3\" data-name=\"kyc checks status text\">\n                2 of 5 checks done\n            </p>\n            <p class=\"mt-3 text-[13px] leading-snug\" data-kid=\"1-6-1-4\" data-name=\"kyc benefit description text\">\n                Completing KYC unlocks\n                <span class=\"font-semibold\" data-kid=\"1-6-1-4-1\" data-name=\"unlocked jobs count emphasis\">\n                    2 more jobs\n                </span>\n            </p>\n            <button class=\"mt-3.5 h-11 rounded-md bg-[#3ecf8e] px-5 font-['Plus_Jakarta_Sans',sans-serif] text-[14px] font-bold text-[#171717]\" data-kid=\"1-6-1-5\" data-name=\"continue kyc primary button\">\n                Continue KYC\n            </button>\n            <div class=\"mt-3.5 flex items-start gap-2 rounded-lg bg-[#fff8d6] px-3 py-2.5\" data-kid=\"1-6-1-6\" data-name=\"aadhaar status warning container\">\n                <span class=\"mt-1 h-2 w-2 shrink-0 rounded-full bg-[#ffdb13]\" data-kid=\"1-6-1-6-1\" data-name=\"warning status dot icon\">\n                </span>\n                <p class=\"text-[12px] leading-snug text-[#171717]\" data-kid=\"1-6-1-6-2\" data-name=\"aadhaar warning text\">\n                    Aadhaar pending verification — you can browse, some jobs stay locked.\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- Courses strip -->\n    <section class=\"pt-10\" data-kid=\"1-7\" data-name=\"courses recommendation section\">\n        <div class=\"flex items-baseline justify-between px-5\" data-kid=\"1-7-1\" data-name=\"courses header row\">\n            <p class=\"font-['Plus_Jakarta_Sans',sans-serif] text-[16px] font-semibold\" data-kid=\"1-7-1-1\" data-name=\"courses section headline\">\n                Courses for your gaps\n            </p>\n            <span class=\"text-[12px] text-[#707070]\" data-kid=\"1-7-1-2\" data-name=\"courses count label\">\n                12 courses\n            </span>\n        </div>\n        <div class=\"no-scrollbar mt-3 flex gap-3 overflow-x-auto px-5 pb-1\" data-kid=\"1-7-2\" data-name=\"horizontal course cards strip\">\n            <article class=\"w-[150px] shrink-0 rounded-xl border border-[#dfdfdf] p-3.5\" data-kid=\"1-7-2-1\" data-name=\"house wiring course card\">\n                <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-7-2-1-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-7-2-1-1-1\" data-name=\"course code badge\">\n                        ELEC-101\n                    </span>\n                    <span class=\"text-[18px] leading-none text-[#707070]\" data-kid=\"1-7-2-1-1-2\" data-name=\"bookmark heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-7-2-1-1-2-1\" data-name=\"bookmark heart icon\">\n                        </i>\n                    </span>\n                </div>\n                <p class=\"mt-2.5 font-['Plus_Jakarta_Sans',sans-serif] text-[14px] font-semibold leading-snug\" data-kid=\"1-7-2-1-2\" data-name=\"course title text\">\n                    House Wiring Fundamentals\n                </p>\n                <p class=\"mt-1 text-[12px] leading-snug text-[#707070]\" data-kid=\"1-7-2-1-3\" data-name=\"course provider and duration text\">\n                    NSDC / Skill India · 4 weeks\n                </p>\n            </article>\n            <article class=\"w-[150px] shrink-0 rounded-xl border border-[#dfdfdf] p-3.5\" data-kid=\"1-7-2-2\" data-name=\"ac repair course card\">\n                <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-7-2-2-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-7-2-2-1-1\" data-name=\"course code badge\">\n                        HVAC-201\n                    </span>\n                    <span class=\"text-[18px] leading-none text-[#707070]\" data-kid=\"1-7-2-2-1-2\" data-name=\"bookmark heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-7-2-2-1-2-1\" data-name=\"bookmark heart icon\">\n                        </i>\n                    </span>\n                </div>\n                <p class=\"mt-2.5 font-['Plus_Jakarta_Sans',sans-serif] text-[14px] font-semibold leading-snug\" data-kid=\"1-7-2-2-2\" data-name=\"course title text\">\n                    AC Repair & Servicing\n                </p>\n                <p class=\"mt-1 text-[12px] leading-snug text-[#707070]\" data-kid=\"1-7-2-2-3\" data-name=\"course provider and duration text\">\n                    Voltas Academy · 8 weeks\n                </p>\n            </article>\n            <article class=\"w-[150px] shrink-0 rounded-xl border border-[#dfdfdf] p-3.5\" data-kid=\"1-7-2-3\" data-name=\"basic plumbing course card\">\n                <div class=\"flex items-start justify-between gap-2\" data-kid=\"1-7-2-3-1\" data-name=\"course card header row\">\n                    <span class=\"rounded-full border border-[#ebebeb] bg-[#fafafa] px-2.5 py-1 text-[11px] font-semibold leading-none\" data-kid=\"1-7-2-3-1-1\" data-name=\"course code badge\">\n                        PLMB-102\n                    </span>\n                    <span class=\"text-[18px] leading-none text-[#707070]\" data-kid=\"1-7-2-3-1-2\" data-name=\"bookmark heart icon wrapper\">\n                        <i class=\"icon-heart\" data-kid=\"1-7-2-3-1-2-1\" data-name=\"bookmark heart icon\">\n                        </i>\n                    </span>\n                </div>\n                <p class=\"mt-2.5 font-['Plus_Jakarta_Sans',sans-serif] text-[14px] font-semibold leading-snug\" data-kid=\"1-7-2-3-2\" data-name=\"course title text\">\n                    Basic Plumbing\n                </p>\n                <p class=\"mt-1 text-[12px] leading-snug text-[#707070]\" data-kid=\"1-7-2-3-3\" data-name=\"course provider and duration text\">\n                    ITI Pune · 6 weeks\n                </p>\n            </article>\n        </div>\n    </section>\n    <!-- Bottom tab bar -->\n    <nav aria-label=\"Primary\" class=\"mt-10 border-t border-[#dfdfdf] bg-white\" data-kid=\"1-8\" data-name=\"bottom tab navigation\">\n        <div class=\"grid grid-cols-4 px-2 pb-6 pt-3\" data-kid=\"1-8-1\" data-name=\"tab grid container\">\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-8-1-1\" data-name=\"home tab item\">\n                <span class=\"text-[22px] leading-none text-[#3ecf8e]\" data-kid=\"1-8-1-1-1\" data-name=\"home tab icon wrapper\">\n                    <i class=\"icon-house\" data-kid=\"1-8-1-1-1-1\" data-name=\"home house icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-semibold text-[#171717]\" data-kid=\"1-8-1-1-2\" data-name=\"home tab label\">\n                    Home\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-8-1-2\" data-name=\"matches tab item\">\n                <span class=\"text-[22px] leading-none text-[#707070]\" data-kid=\"1-8-1-2-1\" data-name=\"matches tab icon wrapper\">\n                    <i class=\"icon-briefcase-business\" data-kid=\"1-8-1-2-1-1\" data-name=\"matches briefcase icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-8-1-2-2\" data-name=\"matches tab label\">\n                    Matches\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-8-1-3\" data-name=\"courses tab item\">\n                <span class=\"text-[22px] leading-none text-[#707070]\" data-kid=\"1-8-1-3-1\" data-name=\"courses tab icon wrapper\">\n                    <i class=\"icon-book-open\" data-kid=\"1-8-1-3-1-1\" data-name=\"courses open book icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-8-1-3-2\" data-name=\"courses tab label\">\n                    Courses\n                </span>\n            </div>\n            <div class=\"flex flex-col items-center gap-1\" data-kid=\"1-8-1-4\" data-name=\"profile tab item\">\n                <span class=\"text-[22px] leading-none text-[#707070]\" data-kid=\"1-8-1-4-1\" data-name=\"profile tab icon wrapper\">\n                    <i class=\"icon-user-round\" data-kid=\"1-8-1-4-1-1\" data-name=\"profile user icon\">\n                    </i>\n                </span>\n                <span class=\"text-[11px] font-medium text-[#707070]\" data-kid=\"1-8-1-4-2\" data-name=\"profile tab label\">\n                    Profile\n                </span>\n            </div>\n        </div>\n    </nav>\n</div>\n",
