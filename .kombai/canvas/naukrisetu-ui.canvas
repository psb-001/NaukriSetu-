      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  html { background: #ffffff; }\n  body { background: #ffffff; margin: 0; font-family: 'Inter', sans-serif; color: #171717; }\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- Top navbar -->\n    <header class=\"w-full border-b border-[#dfdfdf] bg-white\" data-kid=\"1-1\" data-name=\"top navigation header\">\n        <div class=\"mx-auto flex h-16 max-w-[1200px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"navbar inner container\">\n            <div class=\"font-display text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"brand logo text\">\n                Naukri\n                <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1-1\" data-name=\"brand name accent word\">\n                    Setu\n                </span>\n            </div>\n            <nav class=\"flex h-16 items-center gap-8 text-[15px]\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n                <a class=\"flex h-16 items-center border-b-2 border-[#171717] font-semibold\" data-kid=\"1-1-1-2-1\" data-name=\"KYC Queue navigation link\">\n                    KYC Queue\n                </a>\n                <a class=\"flex h-16 items-center border-b-2 border-transparent text-[#707070]\" data-kid=\"1-1-1-2-2\" data-name=\"Jobs Queue navigation link\">\n                    Jobs Queue\n                </a>\n                <a class=\"flex h-16 items-center border-b-2 border-transparent text-[#707070]\" data-kid=\"1-1-1-2-3\" data-name=\"Profile navigation link\">\n                    Profile\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto w-full max-w-[1200px] flex-1 px-8 pb-12 pt-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Header -->\n        <h1 class=\"font-display text-[24px] font-bold leading-tight\" data-kid=\"1-2-1\" data-name=\"page title headline\">\n            Verification queue\n        </h1>\n        <p class=\"mt-1 text-[14px] leading-snug text-[#707070]\" data-kid=\"1-2-2\" data-name=\"page subtitle description\">\n            One trust pattern for people and jobs. Approvals update that seeker's matches immediately.\n        </p>\n        <!-- Queue tabs -->\n        <div class=\"mt-6 flex items-center gap-2\" data-kid=\"1-2-3\" data-name=\"queue filter tab group\">\n            <button class=\"flex h-9 items-center rounded-full bg-[#171717] px-4 text-[14px] font-medium text-white\" data-kid=\"1-2-3-1\" data-name=\"KYC docs active filter tab\">\n                KYC docs (4)\n            </button>\n            <button class=\"flex h-9 items-center rounded-full border border-[#c7c7c7] bg-white px-4 text-[14px] text-[#171717]\" data-kid=\"1-2-3-2\" data-name=\"Jobs inactive filter tab\">\n                Jobs (2)\n            </button>\n        </div>\n        <!-- Column labels -->\n        <div class=\"mt-7 grid grid-cols-[1fr_160px_230px] items-center border-b border-[#dfdfdf] pb-2 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-4\" data-name=\"column headers row\">\n            <span data-kid=\"1-2-4-1\" data-name=\"seeker document column label\">\n                Seeker · Document\n            </span>\n            <span data-kid=\"1-2-4-2\" data-name=\"submitted column label\">\n                Submitted\n            </span>\n            <span class=\"text-right\" data-kid=\"1-2-4-3\" data-name=\"decision column label\">\n                Decision\n            </span>\n        </div>\n        <!-- Row 1 — expanded -->\n        <div class=\"grid grid-cols-[1fr_160px_230px] items-center border-b border-[#dfdfdf] py-4\" data-kid=\"1-2-5\" data-name=\"KYC queue row 1\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-5-1\" data-name=\"seeker document cell\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[18px] text-[#707070]\" data-kid=\"1-2-5-1-1\" data-name=\"document icon container\">\n                    <i class=\"icon-file\" data-kid=\"1-2-5-1-1-1\" data-name=\"document file icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-5-1-2\" data-name=\"seeker name and document info\">\n                    <div class=\"font-display text-[15px] font-semibold leading-tight\" data-kid=\"1-2-5-1-2-1\" data-name=\"seeker name text\">\n                        Ravi Kadam\n                    </div>\n                    <div class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-2-2\" data-name=\"document type text\">\n                        Aadhaar card\n                    </div>\n                </div>\n            </div>\n            <div class=\"text-[13px] text-[#707070]\" data-kid=\"1-2-5-2\" data-name=\"submission time text\">\n                2 min ago\n            </div>\n            <div class=\"flex items-center justify-end gap-2\" data-kid=\"1-2-5-3\" data-name=\"row action buttons group\">\n                <button class=\"h-8 rounded-[6px] bg-[#3ecf8e] px-4 text-[12px] font-semibold text-[#171717]\" data-kid=\"1-2-5-3-1\" data-name=\"approve button\">\n                    Approve\n                </button>\n                <button class=\"h-8 rounded-[6px] border border-[#c7c7c7] bg-white px-4 text-[12px] text-[#171717]\" data-kid=\"1-2-5-3-2\" data-name=\"reject button\">\n                    Reject\n                </button>\n            </div>\n        </div>\n        <!-- Evidence panel for expanded row -->\n        <div class=\"mb-1 mt-3 flex items-end gap-5 rounded-lg bg-[#fafafa] p-4\" data-kid=\"1-2-6\" data-name=\"evidence rejection panel\">\n            <div class=\"flex h-24 w-24 shrink-0 flex-col items-center justify-center gap-1 rounded-lg border border-dashed border-[#c7c7c7] bg-white text-[#9a9a9a]\" data-kid=\"1-2-6-1\" data-name=\"document photo placeholder\">\n                <i class=\"icon-camera text-[20px]\" data-kid=\"1-2-6-1-1\" data-name=\"camera icon\">\n                </i>\n                <span class=\"text-[11px]\" data-kid=\"1-2-6-1-2\" data-name=\"photo placeholder caption\">\n                    Aadhaar photo\n                </span>\n            </div>\n            <div class=\"flex-1\" data-kid=\"1-2-6-2\" data-name=\"rejection reason input group\">\n                <label class=\"mb-1.5 block text-[12px] font-semibold\" data-kid=\"1-2-6-2-1\" data-name=\"rejection reason label\">\n                    Reason (required to reject)\n                </label>\n                <input class=\"h-10 w-full rounded-lg border border-[#c7c7c7] bg-white px-3 text-[14px] placeholder:text-[#b2b2b2]\" data-kid=\"1-2-6-2-2\" data-name=\"rejection reason text input\" placeholder=\"e.g. Photo unreadable\"/>\n            </div>\n            <button class=\"h-9 shrink-0 rounded-[6px] border border-[#ff2201] px-4 text-[13px] font-medium text-[#ff2201]\" data-kid=\"1-2-6-3\" data-name=\"reject with note button\">\n                Reject with note\n            </button>\n        </div>\n        <!-- Row 2 -->\n        <div class=\"mt-2 grid grid-cols-[1fr_160px_230px] items-center border-b border-[#dfdfdf] py-4\" data-kid=\"1-2-7\" data-name=\"KYC queue row 2\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-7-1\" data-name=\"seeker document cell\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[18px] text-[#707070]\" data-kid=\"1-2-7-1-1\" data-name=\"document icon container\">\n                    <i class=\"icon-map-pin\" data-kid=\"1-2-7-1-1-1\" data-name=\"map pin icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-7-1-2\" data-name=\"seeker name and document info\">\n                    <div class=\"font-display text-[15px] font-semibold leading-tight\" data-kid=\"1-2-7-1-2-1\" data-name=\"seeker name text\">\n                        Ravi Kadam\n                    </div>\n                    <div class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-7-1-2-2\" data-name=\"document type text\">\n                        Address proof\n                    </div>\n                </div>\n            </div>\n            <div class=\"text-[13px] text-[#707070]\" data-kid=\"1-2-7-2\" data-name=\"submission time text\">\n                just now\n            </div>\n            <div class=\"flex items-center justify-end gap-2\" data-kid=\"1-2-7-3\" data-name=\"row action buttons group\">\n                <button class=\"h-8 rounded-[6px] bg-[#3ecf8e] px-4 text-[12px] font-semibold text-[#171717]\" data-kid=\"1-2-7-3-1\" data-name=\"approve button\">\n                    Approve\n                </button>\n                <button class=\"h-8 rounded-[6px] border border-[#c7c7c7] bg-white px-4 text-[12px] text-[#171717]\" data-kid=\"1-2-7-3-2\" data-name=\"reject button\">\n                    Reject\n                </button>\n            </div>\n        </div>\n        <!-- Row 3 -->\n        <div class=\"grid grid-cols-[1fr_160px_230px] items-center border-b border-[#dfdfdf] py-4\" data-kid=\"1-2-8\" data-name=\"KYC queue row 3\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-8-1\" data-name=\"seeker document cell\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[18px] text-[#707070]\" data-kid=\"1-2-8-1-1\" data-name=\"document icon container\">\n                    <i class=\"icon-file\" data-kid=\"1-2-8-1-1-1\" data-name=\"document file icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-8-1-2\" data-name=\"seeker name and document info\">\n                    <div class=\"font-display text-[15px] font-semibold leading-tight\" data-kid=\"1-2-8-1-2-1\" data-name=\"seeker name text\">\n                        Meena Iyer\n                    </div>\n                    <div class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-8-1-2-2\" data-name=\"document type text\">\n                        Aadhaar card\n                    </div>\n                </div>\n            </div>\n            <div class=\"text-[13px] text-[#707070]\" data-kid=\"1-2-8-2\" data-name=\"submission time text\">\n                18 min ago\n            </div>\n            <div class=\"flex items-center justify-end gap-2\" data-kid=\"1-2-8-3\" data-name=\"row action buttons group\">\n                <button class=\"h-8 rounded-[6px] bg-[#3ecf8e] px-4 text-[12px] font-semibold text-[#171717]\" data-kid=\"1-2-8-3-1\" data-name=\"approve button\">\n                    Approve\n                </button>\n                <button class=\"h-8 rounded-[6px] border border-[#c7c7c7] bg-white px-4 text-[12px] text-[#171717]\" data-kid=\"1-2-8-3-2\" data-name=\"reject button\">\n                    Reject\n                </button>\n            </div>\n        </div>\n        <!-- Row 4 -->\n        <div class=\"grid grid-cols-[1fr_160px_230px] items-center border-b border-[#dfdfdf] py-4\" data-kid=\"1-2-9\" data-name=\"KYC queue row 4\">\n            <div class=\"flex items-center gap-3\" data-kid=\"1-2-9-1\" data-name=\"seeker document cell\">\n                <div class=\"flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-[#dfdfdf] bg-[#fafafa] text-[18px] text-[#707070]\" data-kid=\"1-2-9-1-1\" data-name=\"document icon container\">\n                    <i class=\"icon-file-check-2\" data-kid=\"1-2-9-1-1-1\" data-name=\"certificate file check icon\">\n                    </i>\n                </div>\n                <div data-kid=\"1-2-9-1-2\" data-name=\"seeker name and document info\">\n                    <div class=\"font-display text-[15px] font-semibold leading-tight\" data-kid=\"1-2-9-1-2-1\" data-name=\"seeker name text\">\n                        Suresh Pawar\n                    </div>\n                    <div class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-9-1-2-2\" data-name=\"document type text\">\n                        Certificate: ITI Electrician\n                    </div>\n                </div>\n            </div>\n            <div class=\"text-[13px] text-[#707070]\" data-kid=\"1-2-9-2\" data-name=\"submission time text\">\n                1 hr ago\n            </div>\n            <div class=\"flex items-center justify-end gap-2\" data-kid=\"1-2-9-3\" data-name=\"row action buttons group\">\n                <button class=\"h-8 rounded-[6px] bg-[#3ecf8e] px-4 text-[12px] font-semibold text-[#171717]\" data-kid=\"1-2-9-3-1\" data-name=\"approve button\">\n                    Approve\n                </button>\n                <button class=\"h-8 rounded-[6px] border border-[#c7c7c7] bg-white px-4 text-[12px] text-[#171717]\" data-kid=\"1-2-9-3-2\" data-name=\"reject button\">\n                    Reject\n                </button>\n            </div>\n        </div>\n        <!-- Approved today strip -->\n        <section class=\"mt-8 border-t border-[#dfdfdf] pt-5\" data-kid=\"1-2-10\" data-name=\"approved today section\">\n            <h2 class=\"font-display text-[14px] font-semibold\" data-kid=\"1-2-10-1\" data-name=\"approved today heading\">\n                Approved today\n            </h2>\n            <div class=\"mt-3 flex flex-wrap items-center gap-3\" data-kid=\"1-2-10-2\" data-name=\"approval details row\">\n                <span class=\"inline-flex items-center gap-1.5 rounded-full bg-[#e7f8ef] px-2.5 py-1 text-[11px] font-semibold text-[#171717]\" data-kid=\"1-2-10-2-1\" data-name=\"live status badge\">\n                    <span class=\"h-1.5 w-1.5 rounded-full bg-[#3ecf8e]\" data-kid=\"1-2-10-2-1-1\" data-name=\"live indicator dot\">\n                    </span>\n                    Live\n                </span>\n                <span class=\"text-[13px]\" data-kid=\"1-2-10-2-2\" data-name=\"approval summary text\">\n                    <span class=\"font-medium text-[#171717]\" data-kid=\"1-2-10-2-2-1\" data-name=\"approved job title text\">\n                        Kesari Electricals — Wiring Assistant\n                    </span>\n                    <span class=\"text-[#707070]\" data-kid=\"1-2-10-2-2-2\" data-name=\"approval time and impact text\">\n                        approved 10:24 · appears in seeker matches instantly · 3 seekers qualify\n                    </span>\n                </span>\n            </div>\n        </section>\n        <!-- Privacy caption -->\n        <p class=\"mt-10 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-11\" data-name=\"privacy disclaimer caption\">\n            Demo data — nothing leaves this device.\n        </p>\n    </main>\n</div>\n",
