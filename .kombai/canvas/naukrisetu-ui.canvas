      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  html { background: #ffffff; }\n  body { background: #ffffff; margin: 0; }\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n</style>\n<div class=\"min-h-screen bg-white text-[#171717]\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Inter',sans-serif\">\n    <!-- Navbar (seeker) -->\n    <header class=\"border-b border-[#dfdfdf] bg-white\" data-kid=\"1-1\" data-name=\"site header navbar\">\n        <div class=\"mx-auto flex h-16 max-w-[1200px] items-center justify-between px-8\" data-kid=\"1-1-1\" data-name=\"navbar content wrapper\">\n            <span class=\"font-display text-[18px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1\" data-name=\"brand logo text\">\n                Naukri\n                <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1-1\" data-name=\"brand accent name text\">\n                    Setu\n                </span>\n            </span>\n            <nav class=\"flex h-16 items-stretch gap-8\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a class=\"flex items-center border-b-2 border-transparent text-[14px] text-[#707070]\" data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\">\n                    Home\n                </a>\n                <a class=\"flex items-center border-b-2 border-[#171717] text-[14px] font-semibold text-[#171717]\" data-kid=\"1-1-1-2-2\" data-name=\"active matches navigation link\">\n                    Matches\n                </a>\n                <a class=\"flex items-center border-b-2 border-transparent text-[14px] text-[#707070]\" data-kid=\"1-1-1-2-3\" data-name=\"courses navigation link\">\n                    Courses\n                </a>\n                <a class=\"flex items-center border-b-2 border-transparent text-[14px] text-[#707070]\" data-kid=\"1-1-1-2-4\" data-name=\"profile navigation link\">\n                    Profile\n                </a>\n            </nav>\n        </div>\n    </header>\n    <main class=\"mx-auto max-w-[1200px] px-8 pb-16 pt-8\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- Page header -->\n        <h1 class=\"font-display text-[24px] font-bold leading-tight\" data-kid=\"1-2-1\" data-name=\"page title heading\">\n            Your matches\n        </h1>\n        <p class=\"mt-1 text-[14px] text-[#707070]\" data-kid=\"1-2-2\" data-name=\"page subtitle description\">\n            Hard requirements checked first — only survivors are ranked.\n        </p>\n        <!-- Tabs with live counts -->\n        <div class=\"mt-6 border-b border-[#dfdfdf]\" data-kid=\"1-2-3\" data-name=\"tab bar container with underline border\">\n            <div class=\"flex gap-8\" data-kid=\"1-2-3-1\" data-name=\"tab buttons row\">\n                <button class=\"-mb-px border-b-2 border-[#171717] pb-3 text-[15px] font-semibold text-[#171717]\" data-kid=\"1-2-3-1-1\" data-name=\"active eligible tab button with count\">\n                    Eligible (5)\n                </button>\n                <button class=\"-mb-px border-b-2 border-transparent pb-3 text-[15px] text-[#707070]\" data-kid=\"1-2-3-1-2\" data-name=\"not eligible tab button with count\">\n                    Not eligible (3)\n                </button>\n            </div>\n        </div>\n        <p class=\"mt-3 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-4\" data-name=\"ranking info helper text\">\n            Ranked by fit score. Select a card to open its breakdown.\n        </p>\n        <!-- Two-column: ranked list + detail panel -->\n        <div class=\"mt-5 grid grid-cols-[11fr_9fr] items-start gap-6\" data-kid=\"1-2-5\" data-name=\"two-column layout container\">\n            <!-- LEFT · ranked results list -->\n            <div data-kid=\"1-2-5-1\" data-name=\"ranked results list container\">\n                <!-- Row 1 · selected -->\n                <div class=\"flex h-[72px] items-center gap-4 rounded-lg bg-[#fafafa] px-4\" data-kid=\"1-2-5-1-1\" data-name=\"selected job match row card\">\n                    <div class=\"relative h-7 w-7 shrink-0\" data-kid=\"1-2-5-1-1-1\" data-name=\"fit score ring badge with background ring\">\n                        <svg data-kid=\"1-2-5-1-1-1-1\" data-name=\"fit score circular progress ring icon\" height=\"28\" viewbox=\"0 0 28 28\" width=\"28\">\n                            <circle cx=\"14\" cy=\"14\" fill=\"none\" r=\"11\" stroke=\"#ebebeb\" stroke-width=\"3.5\">\n                            </circle>\n                            <circle cx=\"14\" cy=\"14\" fill=\"none\" r=\"11\" stroke=\"#3ecf8e\" stroke-dasharray=\"63.6 69.2\" stroke-linecap=\"round\" stroke-width=\"3.5\" transform=\"rotate(-90 14 14)\">\n                            </circle>\n                        </svg>\n                        <span class=\"absolute inset-0 flex items-center justify-center font-display text-[10px] font-bold\" data-kid=\"1-2-5-1-1-1-2\" data-name=\"fit score number inside ring\">\n                            92\n                        </span>\n                    </div>\n                    <span class=\"w-3 shrink-0 text-[12px] text-[#9a9a9a]\" data-kid=\"1-2-5-1-1-2\" data-name=\"rank position number\">\n                        1\n                    </span>\n                    <div class=\"min-w-0\" data-kid=\"1-2-5-1-1-3\" data-name=\"job title and location text block\">\n                        <p class=\"font-display text-[16px] font-semibold leading-tight\" data-kid=\"1-2-5-1-1-3-1\" data-name=\"job title text\">\n                            AC Technician\n                        </p>\n                        <p class=\"mt-0.5 text-[12px] text-[#707070]\" data-kid=\"1-2-5-1-1-3-2\" data-name=\"company and city text\">\n                            Voltas Service