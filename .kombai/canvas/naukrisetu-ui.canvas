    "var_0f38e371de01": {
      "type": "variant",
      "label": "W02 · Onboarding",
      "parentId": "null",
      "themeId": null,
      "rect": {
        "x": 9930,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  .font-display { font-family: 'Plus Jakarta Sans', sans-serif; }\n  body { font-family: 'Inter', sans-serif; background: #ffffff; color: #171717; }\n</style>\n<div class=\"flex min-h-screen w-full flex-col bg-white text-[#171717]\" data-kid=\"1\" data-name=\"form onboarding page container\">\n    <div class=\"mx-auto flex w-full max-w-[640px] flex-1 flex-col px-6 pb-16 pt-9\" data-kid=\"1-1\" data-name=\"centered onboarding content column\">\n        <!-- Minimal pre-app header -->\n        <div class=\"font-display text-[20px] font-extrabold leading-none tracking-tight\" data-kid=\"1-1-1\" data-name=\"brand logo text\">\n            Naukri\n            <span class=\"text-[#3ecf8e]\" data-kid=\"1-1-1-1\" data-name=\"brand logo highlighted suffix\">\n                Setu\n            </span>\n        </div>\n        <!-- Persistent step header -->\n        <div class=\"mt-10 flex items-center\" data-kid=\"1-1-2\" data-name=\"progress step header bar\">\n            <div class=\"flex flex-1 items-center\" data-kid=\"1-1-2-1\" data-name=\"step indicator container\">\n                <!-- Step 1 · done -->\n                <div class=\"flex shrink-0 items-center gap-2.5\" data-kid=\"1-1-2-1-1\" data-name=\"completed step indicator for Role\">\n                    <div class=\"flex h-6 w-6 items-center justify-center rounded-full bg-[#3ecf8e] text-[13px] text-white\" data-kid=\"1-1-2-1-1-1\" data-name=\"completed step circle with checkmark\">\n                        <i class=\"icon-check\" data-kid=\"1-1-2-1-1-1-1\" data-name=\"checkmark icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-[13px] font-semibold\" data-kid=\"1-1-2-1-1-2\" data-name=\"completed step label Role\">\n                        Role\n                    </span>\n                </div>\n                <div class=\"mx-3 h-px flex-1 bg-[#dfdfdf]\" data-kid=\"1-1-2-1-2\" data-name=\"step divider line one\">\n                </div>\n                <!-- Step 2 · current -->\n                <div class=\"flex shrink-0 items-center gap-2.5\" data-kid=\"1-1-2-1-3\" data-name=\"current step indicator for Basics\">\n                    <div class=\"flex h-6 w-6 items-center justify-center rounded-full border-2 border-[#3ecf8e] bg-white font-display text-[12px] font-bold\" data-kid=\"1-1-2-1-3-1\" data-name=\"current step number circle\">\n                        2\n                    </div>\n                    <span class=\"font-display text-[13px] font-bold\" data-kid=\"1-1-2-1-3-2\" data-name=\"current step label Basics\">\n                        Basics\n                    </span>\n                </div>\n                <div class=\"mx-3 h-px flex-1 bg-[#dfdfdf]\" data-kid=\"1-1-2-1-4\" data-name=\"step divider line two\">\n                </div>\n                <!-- Step 3 · upcoming -->\n                <div class=\"flex shrink-0 items-center gap-2.5\" data-kid=\"1-1-2-1-5\" data-name=\"upcoming step indicator for Skills\">\n                    <div class=\"flex h-6 w-6 items-center justify-center rounded-full bg-[#dfdfdf] text-[12px] font-medium text-[#707070]\" data-kid=\"1-1-2-1-5-1\" data-name=\"upcoming step number circle\">\n                        3\n                    </div>\n                    <span class=\"text-[13px] font-medium text-[#707070]\" data-kid=\"1-1-2-1-5-2\" data-name=\"upcoming step label Skills\">\n                        Skills\n                    </span>\n                </div>\n            </div>\n            <span class=\"ml-6 shrink-0 text-[12px] text-[#707070]\" data-kid=\"1-1-2-2\" data-name=\"step progress caption Step 2 of 3\">\n                Step 2 of 3\n            </span>\n        </div>\n        <!-- Form card -->\n        <div class=\"mt-7 rounded-xl border border-[#dfdfdf] bg-white p-8\" data-kid=\"1-1-3\" data-name=\"basics form card\">\n            <h1 class=\"font-display text-[24px] font-bold leading-tight\" data-kid=\"1-1-3-1\" data-name=\"form card headline\">\n                The basics\n            </h1>\n            <p class=\"mt-1.5 text-[14px] text-[#707070]\" data-kid=\"1-1-3-2\" data-name=\"form card subtitle\">\n                Only name, phone and city are required to start matching.\n            </p>\n            <div class=\"mt-7 grid grid-cols-2 gap-x-5 gap-y-5\" data-kid=\"1-1-3-3\" data-name=\"form fields grid\">\n                <!-- Full name -->\n                <div class=\"col-span-2\" data-kid=\"1-1-3-3-1\" data-name=\"full name field group\">\n                    <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-3-1-1\" data-name=\"full name field label\">\n                        Full name\n                        <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-3-1-1-1\" data-name=\"required asterisk mark\">\n                            *\n                        </span>\n                    </label>\n                    <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 text-[15px] text-[#171717] outline-none\" data-kid=\"1-1-3-3-1-2\" data-name=\"full name text input\" type=\"text\" value=\"Ravi Kadam\"/>\n                </div>\n                <!-- Phone -->\n                <div data-kid=\"1-1-3-3-2\" data-name=\"phone field group\">\n                    <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-3-2-1\" data-name=\"phone field label\">\n                        Phone\n                        <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-3-2-1-1\" data-name=\"required asterisk mark\">\n                            *\n                        </span>\n                    </label>\n                    <div class=\"flex h-11 items-stretch overflow-hidden rounded-lg border border-[#c7c7c7] bg-white\" data-kid=\"1-1-3-3-2-2\" data-name=\"phone number input wrapper\">\n                        <span class=\"flex items-center border-r border-[#dfdfdf] bg-[#fafafa] px-3 text-[14px] font-medium text-[#707070]\" data-kid=\"1-1-3-3-2-2-1\" data-name=\"country code prefix +91\">\n                            +91\n                        </span>\n                        <input class=\"min-w-0 flex-1 px-3.5 text-[15px] text-[#171717] outline-none\" data-kid=\"1-1-3-3-2-2-2\" data-name=\"phone number text input\" type=\"text\" value=\"98220 12210\"/>\n                    </div>\n                    <p class=\"mt-1.5 text-[12px] text-[#707070]\" data-kid=\"1-1-3-3-2-3\" data-name=\"phone input helper text\">\n                        10 digits, starts with 6–9.\n                    </p>\n                </div>\n                <!-- City (focused) -->\n                <div data-kid=\"1-1-3-3-3\" data-name=\"city field group\">\n                    <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-3-3-1\" data-name=\"city field label\">\n                        City\n                        <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-3-3-1-1\" data-name=\"required asterisk mark\">\n                            *\n                        </span>\n                    </label>\n                    <input class=\"h-11 w-full rounded-lg border-2 border-[#3ecf8e] bg-white px-3.5 text-[15px] font-medium text-[#171717] outline-none\" data-kid=\"1-1-3-3-3-2\" data-name=\"city name text input focused\" type=\"text\" value=\"Pune\"/>\n                    <div class=\"mt-2 flex items-start gap-2 rounded-lg bg-[#fafafa] px-3 py-2\" data-kid=\"1-1-3-3-3-3\" data-name=\"city info callout box\">\n                        <span class=\"mt-0.5 text-[14px] leading-none text-[#707070]\" data-kid=\"1-1-3-3-3-3-1\" data-name=\"map pin icon wrapper\">\n                            <i class=\"icon-map-pin\" data-kid=\"1-1-3-3-3-3-1-1\" data-name=\"map pin icon\">\n                            </i>\n                        </span>\n                        <p class=\"text-[12px] leading-snug text-[#707070]\" data-kid=\"1-1-3-3-3-3-2\" data-name=\"city info callout text\">\n                            Needed to find jobs near you — matches are filtered by city.\n                        </p>\n                    </div>\n                </div>\n                <!-- Age -->\n                <div data-kid=\"1-1-3-3-4\" data-name=\"age field group\">\n                    <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-3-4-1\" data-name=\"age field label\">\n                        Age\n                        <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-3-4-1-1\" data-name=\"optional tag for age\">\n                            (optional)\n                        </span>\n                    </label>\n                    <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 text-[15px] text-[#171717] outline-none\" data-kid=\"1-1-3-3-4-2\" data-name=\"age text input\" type=\"text\" value=\"24\"/>\n                </div>\n                <!-- Experience -->\n                <div data-kid=\"1-1-3-3-5\" data-name=\"experience field group\">\n                    <label class=\"mb-1.5 block text-[13px] font-semibold\" data-kid=\"1-1-3-3-5-1\" data-name=\"experience field label\">\n                        Experience\n                        <span class=\"font-normal text-[#707070]\" data-kid=\"1-1-3-3-5-1-1\" data-name=\"optional tag for experience\">\n                            (years, optional)\n                        </span>\n                    </label>\n                    <input class=\"h-11 w-full rounded-lg border border-[#c7c7c7] bg-white px-3.5 text-[15px] text-[#171717] outline-none\" data-kid=\"1-1-3-3-5-2\" data-name=\"experience years text input\" type=\"text\" value=\"2\"/>\n                </div>\n                <p class=\"col-span-2 -mt-1 text-[12px] text-[#707070]\" data-kid=\"1-1-3-3-6\" data-name=\"experience helper note\">\n                    Some jobs need this — add it anytime in Profile.\n                </p>\n            </div>\n            <!-- Footer actions -->\n            <div class=\"mt-8 flex items-center justify-between gap-4\" data-kid=\"1-1-3-4\" data-name=\"form footer actions row\">\n                <button class=\"h-11 rounded-md border border-[#c7c7c7] bg-white px-7 text-[15px] font-semibold text-[#171717]\" data-kid=\"1-1-3-4-1\" data-name=\"back navigation button\">\n                    Back\n                </button>\n                <button class=\"font-display h-11 rounded-md bg-[#3ecf8e] px-9 text-[15px] font-semibold text-[#171717]\" data-kid=\"1-1-3-4-2\" data-name=\"next step call-to-action button\">\n                    Next\n                </button>\n            </div>\n            <p class=\"mt-4 text-center text-[12px] text-[#9a9a9a]\" data-kid=\"1-1-3-5\" data-name=\"autosave notice text\">\n                Saved automatically — come back anytime.\n            </p>\n        </div>\n    </div>\n</div>\n",
      "comments": [],
      "created": "2026-10-11T07:49:04.336386+00:00",
      "modified": "2026-10-11T07:49:13.513612+00:00",
      "id": "var_0f38e371de01",
      "contentHeight": 1000
    },
